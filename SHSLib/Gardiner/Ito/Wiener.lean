/-
# The SHSLib interface to a standard Wiener process on real time (Gardiner §3.8.1, §4.2)

This file is the **stable interface** through which SHSLib talks about Brownian motion.  It
depends on Mathlib only.  Everything downstream (the Gardiner Ch. 4 layer `SHSLib.Gardiner.Ito`
and the later Itô-integral / Itô-formula / SDE-solution jobs) should be stated for an arbitrary
process `W : ℝ → Ω → ℝ` satisfying `Gardiner.Ito.IsWiener W P`, and should obtain a concrete
Wiener process only through the adapter `SHSLib.Gardiner.Ito.Brownian` (currently built on the
`brownian-motion` library).  Switching to Mathlib's own Brownian motion is then a change of that
one adapter file.

## The interface

`Gardiner.Ito.IsWiener W P` says that, on the probability space `(Ω, P)`, the real-time process
`W` is a standard Wiener process on `t ≥ 0`:

* each `W t` is measurable and `W 0 = 0` almost surely;
* almost every path `t ↦ W t ω` is continuous;
* for `0 ≤ s ≤ t`, `W t - W s ~ N(0, t - s)` (Gardiner (3.8.4)–(3.8.5));
* increments over any partition `0 ≤ t₀ ≤ t₁ ≤ … ≤ tₙ` are independent (Gardiner §3.8.1 and
  the text before (4.2.16));
* for `0 ≤ s ≤ t`, the increment `W t - W s` is independent of the **natural filtration**
  `Gardiner.Ito.wienerFiltration W` at time `s`, the σ-algebra generated by `W r`, `0 ≤ r ≤ s`
  (Gardiner's "nonanticipating" structure, §4.2.4).

Values at negative times are irrelevant: nothing in the interface constrains them, and the
filtration only looks at `r ∈ [0, s]`.

## Derived facts (from the interface alone)

* `Gardiner.Ito.IsWiener.map_eval`: `W t ~ N(0, t)`;
* `Gardiner.Ito.IsWiener.stronglyAdapted`: `W t` is `𝓕 t`-measurable for `t ≥ 0`;
* `Gardiner.Ito.IsWiener.condExp_eq`: the martingale property `E[W t | 𝓕 s] = W s`,
  `0 ≤ s ≤ t`;
* `Gardiner.Ito.iIndepFun_nat_of_fin`: independence of a sequence from independence of its
  initial segments (used to pass from finite partitions to grid sequences).
-/
import Mathlib.Probability.Distributions.Gaussian.Real
import Mathlib.Probability.Independence.Basic
import Mathlib.Probability.Process.Filtration
import Mathlib.Probability.ConditionalExpectation

open MeasureTheory ProbabilityTheory
open scoped NNReal

noncomputable section

namespace Gardiner.Ito

variable {Ω : Type*} [mΩ : MeasurableSpace Ω]

/-- The **natural filtration** of a real-time process on `t ≥ 0`: at time `s` it is generated by
the random variables `W r`, `0 ≤ r ≤ s` (and is trivial for `s < 0`). -/
def wienerFiltration (W : ℝ → Ω → ℝ) (hW : ∀ t, Measurable (W t)) : Filtration ℝ mΩ where
  seq s := ⨆ r ∈ Set.Icc (0 : ℝ) s, MeasurableSpace.comap (W r) inferInstance
  mono' _ _ hst := biSup_mono fun _ hr => ⟨hr.1, hr.2.trans hst⟩
  le' _ := iSup₂_le fun r _ => (hW r).comap_le

lemma comap_le_wienerFiltration (W : ℝ → Ω → ℝ) (hW : ∀ t, Measurable (W t)) {r s : ℝ}
    (hr : 0 ≤ r) (hrs : r ≤ s) :
    MeasurableSpace.comap (W r) inferInstance ≤ wienerFiltration W hW s :=
  le_iSup₂ (f := fun r (_ : r ∈ Set.Icc (0 : ℝ) s) =>
    MeasurableSpace.comap (W r) inferInstance) r ⟨hr, hrs⟩

/-- **Standard Wiener process on real time `t ≥ 0`** (the SHSLib interface).  See the module
docstring for the meaning of the fields. -/
structure IsWiener (W : ℝ → Ω → ℝ) (P : Measure Ω) : Prop where
  isProbabilityMeasure : IsProbabilityMeasure P
  measurable : ∀ t, Measurable (W t)
  zero : ∀ᵐ ω ∂P, W 0 ω = 0
  cont : ∀ᵐ ω ∂P, Continuous fun t => W t ω
  law_sub : ∀ s t : ℝ, 0 ≤ s → s ≤ t → P.map (W t - W s) = gaussianReal 0 (t - s).toNNReal
  indep_incr : ∀ (n : ℕ) (t : Fin (n + 1) → ℝ), Monotone t → 0 ≤ t 0 →
    iIndepFun (fun i : Fin n => W (t i.succ) - W (t i.castSucc)) P
  indep_past : ∀ s t : ℝ, 0 ≤ s → s ≤ t →
    Indep (MeasurableSpace.comap (W t - W s) inferInstance) (wienerFiltration W measurable s) P

/-- A sequence is independent as soon as each of its initial segments is. -/
lemma iIndepFun_nat_of_fin {P : Measure Ω} {ξ : ℕ → Ω → ℝ}
    (h : ∀ n, iIndepFun (fun i : Fin n => ξ i) P) : iIndepFun ξ P := by
  rw [iIndepFun_iff_finset]
  intro s
  obtain ⟨n, hn⟩ : ∃ n, ∀ i ∈ s, i < n :=
    ⟨s.sup id + 1, fun i hi => Nat.lt_succ_of_le (Finset.le_sup (f := id) hi)⟩
  exact (h n).precomp (g := fun i : s => (⟨i.1, hn i.1 i.2⟩ : Fin n))
    (fun a b hab => Subtype.ext (by simpa using congrArg Fin.val hab))

namespace IsWiener

variable {W : ℝ → Ω → ℝ} {P : Measure Ω}

lemma measurable_sub (hW : IsWiener W P) (s t : ℝ) : Measurable (W t - W s) :=
  (hW.measurable t).sub (hW.measurable s)

/-- `W t ~ N(0, t)` for `t ≥ 0`. -/
lemma map_eval (hW : IsWiener W P) {t : ℝ} (ht : 0 ≤ t) :
    P.map (W t) = gaussianReal 0 t.toNNReal := by
  have h := hW.law_sub 0 t le_rfl ht
  rw [sub_zero] at h
  rw [← h]
  refine Measure.map_congr ?_
  filter_upwards [hW.zero] with ω hω
  simp [hω]

/-- `W t` is measurable with respect to the natural filtration at time `t ≥ 0`. -/
lemma stronglyAdapted (hW : IsWiener W P) {t : ℝ} (ht : 0 ≤ t) :
    StronglyMeasurable[wienerFiltration W hW.measurable t] (W t) :=
  (Measurable.of_comap_le (comap_le_wienerFiltration W hW.measurable ht le_rfl)).stronglyMeasurable

/-- `W t` is integrable. -/
lemma integrable (hW : IsWiener W P) {t : ℝ} (ht : 0 ≤ t) : Integrable (W t) P := by
  have hi : Integrable id (gaussianReal 0 t.toNNReal) :=
    (memLp_id_gaussianReal (μ := 0) (v := t.toNNReal) 1).integrable (by simp)
  rw [← hW.map_eval ht] at hi
  exact (integrable_map_measure aestronglyMeasurable_id (hW.measurable t).aemeasurable).mp hi

/-- `E[W t] = 0`. -/
lemma integral_eq_zero (hW : IsWiener W P) {t : ℝ} (ht : 0 ≤ t) : ∫ ω, W t ω ∂P = 0 := by
  have h := integral_map (μ := P) (hW.measurable t).aemeasurable
    (f := fun x : ℝ => x) aestronglyMeasurable_id
  rw [hW.map_eval ht] at h
  simpa using h.symm

/-- **Martingale property** with respect to the natural filtration:
`E[W t | 𝓕 s] = W s` for `0 ≤ s ≤ t`. -/
theorem condExp_eq (hW : IsWiener W P) {s t : ℝ} (hs : 0 ≤ s) (hst : s ≤ t) :
    P[W t | wienerFiltration W hW.measurable s] =ᵐ[P] W s := by
  have := hW.isProbabilityMeasure
  set 𝓕 := wienerFiltration W hW.measurable
  have ht : 0 ≤ t := hs.trans hst
  have hint : Integrable (W t - W s) P := (hW.integrable ht).sub (hW.integrable hs)
  have h_no_cond : P[W t - W s | 𝓕 s] =ᵐ[P] fun _ => P[W t - W s] := by
    refine condExp_indep_eq ?_ (𝓕.le s) ?_ (hW.indep_past s t hs hst)
    · exact (hW.measurable_sub s t).comap_le
    · exact (comap_measurable (W t - W s)).stronglyMeasurable
  have h_zero : P[W t - W s] = 0 := by
    change ∫ ω, (W t ω - W s ω) ∂P = 0
    rw [integral_sub (hW.integrable ht) (hW.integrable hs), hW.integral_eq_zero ht,
      hW.integral_eq_zero hs, sub_zero]
  have hWt : W t = (W t - W s) + W s := by abel
  calc P[W t | 𝓕 s] = P[(W t - W s) + W s | 𝓕 s] := by rw [← hWt]
    _ =ᵐ[P] P[W t - W s | 𝓕 s] + P[W s | 𝓕 s] := condExp_add hint (hW.integrable hs) _
    _ = P[W t - W s | 𝓕 s] + W s := by
        rw [condExp_of_stronglyMeasurable (𝓕.le s) (hW.stronglyAdapted hs) (hW.integrable hs)]
    _ =ᵐ[P] (fun _ => P[W t - W s]) + W s := by
        filter_upwards [h_no_cond] with ω hω
        simp [hω]
    _ = W s := by
        funext ω
        simp only [Pi.add_apply, add_eq_right]
        exact h_zero

end IsWiener

end Gardiner.Ito
