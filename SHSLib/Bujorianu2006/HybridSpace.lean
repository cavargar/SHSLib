# The hybrid state space of a General Stochastic Hybrid System

Formalization of Section 2.2–2.3 of

  M.L. Bujorianu and J. Lygeros, "Toward a General Theory of Stochastic Hybrid
  Systems", in *Stochastic Hybrid Systems: Theory and Safety Critical
  Applications*, LNCIS 337, Springer, 2006, pp. 3–30.

Contents.

* The hybrid state space `X(Q, d, 𝒳) = ⋃_{i ∈ Q} {i} × X^i` and its closure
  `X̄ = X ∪ ∂X`, `∂X = ⋃_{i ∈ Q} {i} × ∂X^i`.
* Equation (7): the Borel σ-algebra of `X` coincides with the σ-algebra
  generated by `⋃_{i} {i} × 𝓑^i`, i.e. with the σ-algebra of the disjoint sum;
  moreover its restriction to a component gives back `𝓑^i`.
* `(X, 𝓑(X))` is a Borel (standard Borel) space.
* The description of convergence in `X` given in Section 2.2.
* Definition 1: the data of a General Stochastic Hybrid System, together with
  Assumptions 1–2 (continuous evolution, discrete transitions).
-/
import Mathlib

open MeasureTheory MeasurableSpace Set Topology Filter
open scoped ENNReal NNReal

noncomputable section

namespace Bujorianu2006

/-! ## Disjoint sums: measurable structure

The hybrid state space is a countable disjoint sum of Borel spaces.  The two
results in this section are the measure-theoretic content of equations (6)–(9)
of the paper. -/

/-- The canonical injection of a summand into a disjoint sum is a measurable
embedding.  This is the statement that the σ-algebra of the sum restricted to
the component `X^i` gives back `𝓑^i` (Section 3.3, after Eq. (7)). -/
theorem measurableEmbedding_sigmaMk {Q : Type*} {E : Q → Type*}
    [∀ i, MeasurableSpace (E i)] (i : Q) :
    MeasurableEmbedding (Sigma.mk i : E i → Σ j, E j) := by
  refine ⟨fun a b h => by simpa using h,
    fun _ hs => (MeasurableSpace.measurableSet_iInf.mp hs) i, ?_⟩
  intro s hs
  rw [MeasurableSpace.measurableSet_iInf]
  intro j
  show MeasurableSet (Sigma.mk j ⁻¹' (Sigma.mk i '' s))
  by_cases h : j = i
  · subst h
    have hpre : (Sigma.mk j ⁻¹' (Sigma.mk j '' s)) = s := by ext y; simp
    rw [hpre]; exact hs
  · convert MeasurableSet.empty
    ext y
    simp only [mem_image, mem_empty_iff_false, iff_false, mem_preimage]
    rintro ⟨z, _, hz⟩
    exact h (congrArg Sigma.fst hz).symm

/-- **Equation (7)**: for a countable family of Borel spaces the Borel
σ-algebra of the disjoint sum is generated by the σ-algebras of the summands,
i.e. it is the σ-algebra of the measurable disjoint sum. -/
instance borelSpace_sigma {Q : Type*} [Countable Q] {E : Q → Type*}
    [∀ i, TopologicalSpace (E i)] [∀ i, MeasurableSpace (E i)] [∀ i, BorelSpace (E i)] :
    BorelSpace (Σ i, E i) := by
  have key : ∀ (i : Q) (t : Set (E i)), MeasurableSet t →
      MeasurableSet[borel (Σ j, E j)] (Sigma.mk i '' t) := by
    intro i t ht
    have hind : (TopologicalSpace.induced (Sigma.mk i) inferInstance)
        = (inferInstance : TopologicalSpace (E i)) :=
      ((Topology.IsOpenEmbedding.sigmaMk (i := i)).isInducing.eq_induced).symm
    have hcomap : MeasurableSpace.comap (Sigma.mk i) (borel (Σ j, E j))
        = (inferInstance : MeasurableSpace (E i)) := by
      rw [← borel_comap, hind, ← BorelSpace.measurable_eq]
    have ht' : MeasurableSet[MeasurableSpace.comap (Sigma.mk i) (borel (Σ j, E j))] t := by
      rw [hcomap]; exact ht
    obtain ⟨s, hs, hst⟩ := ht'
    have himg : Sigma.mk i '' t = s ∩ Set.range (Sigma.mk i) := by
      rw [← hst]; ext y; simp only [mem_image, mem_preimage, mem_inter_iff, mem_range]
      exact ⟨fun ⟨z, hz, h⟩ => ⟨h ▸ hz, z, h⟩, fun ⟨hy, z, h⟩ => ⟨z, h ▸ hy, h⟩⟩
    rw [himg]
    exact hs.inter (MeasurableSpace.measurableSet_generateFrom
      (Topology.IsOpenEmbedding.sigmaMk (i := i)).isOpen_range)
  constructor
  apply le_antisymm
  · intro s hs
    have hpre : ∀ i, MeasurableSet (Sigma.mk i ⁻¹' s) := fun i =>
      MeasurableSpace.measurableSet_iInf.mp hs i
    have hs' : s = ⋃ i, Sigma.mk i '' (Sigma.mk i ⁻¹' s) := by
      ext ⟨i, y⟩
      simp only [mem_iUnion, mem_image, mem_preimage]
      exact ⟨fun h => ⟨i, y, h, rfl⟩, fun ⟨j, z, hz, h⟩ => h ▸ hz⟩
    rw [hs']
    exact MeasurableSet.iUnion fun i => key i _ (hpre i)
  · refine MeasurableSpace.generateFrom_le ?_
    intro u hu
    exact MeasurableSpace.measurableSet_iInf.mpr fun i => (isOpen_sigma_iff.mp hu i).measurableSet

/-! ## The hybrid state space (Section 2.2) -/

/-- The Euclidean state space of a mode of dimension `n`. -/
abbrev ModeSpace (n : ℕ) : Type := EuclideanSpace ℝ (Fin n)

/-- The data `(Q, d, 𝒳)` of Section 2.2: a countable set `Q` of discrete
states, a dimension map `d : Q → ℕ`, and for each `i ∈ Q` an *open* subset
`X^i ⊆ ℝ^{d(i)}`. -/
structure HybridStateSpace where
  /-- The countable set of discrete modes. -/
  Q : Type
  /-- `Q` is countable. -/
  countable_Q : Countable Q
  /-- The dimension of the continuous state space in each mode. -/
  d : Q → ℕ
  /-- The continuous state space `X^i ⊆ ℝ^{d(i)}` of mode `i`. -/
  X : ∀ i : Q, Set (ModeSpace (d i))
  /-- Each `X^i` is open (Section 2.2). -/
  isOpen_X : ∀ i, IsOpen (X i)

attribute [instance] HybridStateSpace.countable_Q

namespace HybridStateSpace

variable (S : HybridStateSpace)

/-- The hybrid state space `X = ⋃_{i ∈ Q} {i} × X^i` (Eq. (6), (8)). -/
def Hyb : Type := Σ i : S.Q, (S.X i)

/-- The boundary `∂X = ⋃_{i ∈ Q} {i} × ∂X^i`. -/
def Bdry : Type := Σ i : S.Q, (frontier (S.X i))

/-- The closed hybrid state space `X̄ = ⋃_{i ∈ Q} {i} × closure X^i`. -/
def Cl : Type := Σ i : S.Q, (closure (S.X i))

instance : TopologicalSpace S.Hyb := inferInstanceAs (TopologicalSpace (Σ i, (S.X i)))
instance : MeasurableSpace S.Hyb := inferInstanceAs (MeasurableSpace (Σ i, (S.X i)))
instance : TopologicalSpace S.Cl := inferInstanceAs (TopologicalSpace (Σ i, (closure (S.X i))))
instance : MeasurableSpace S.Cl := inferInstanceAs (MeasurableSpace (Σ i, (closure (S.X i))))
instance : TopologicalSpace S.Bdry := inferInstanceAs (TopologicalSpace (Σ i, (frontier (S.X i))))
instance : MeasurableSpace S.Bdry := inferInstanceAs (MeasurableSpace (Σ i, (frontier (S.X i))))

/-- Each mode space `X^i` is an open subset of a Euclidean space, hence Polish. -/
instance polishSpace_component (i : S.Q) : PolishSpace (S.X i) :=
  (S.isOpen_X i).polishSpace

/-- Each closed mode space `closure X^i` is a closed subset of a Euclidean
space, hence Polish. -/
instance polishSpace_closure_component (i : S.Q) : PolishSpace (closure (S.X i)) :=
  isClosed_closure.polishSpace

instance : PolishSpace S.Hyb :=
  inferInstanceAs (PolishSpace (Σ i, (S.X i)))

instance : BorelSpace S.Hyb :=
  inferInstanceAs (BorelSpace (Σ i, (S.X i)))

/-- **`(X, 𝓑(X))` is a Borel space** (Section 2.2): the hybrid state space of a
countable family of open subsets of Euclidean spaces is a standard Borel
space. -/
instance : StandardBorelSpace S.Hyb :=
  inferInstanceAs (StandardBorelSpace (Σ i, (S.X i)))

/-- `X̄` is a Polish space: each `closure X^i` is a closed subset of a Euclidean
space. -/
instance : PolishSpace S.Cl :=
  inferInstanceAs (PolishSpace (Σ i, (closure (S.X i))))

instance : BorelSpace S.Cl :=
  inferInstanceAs (BorelSpace (Σ i, (closure (S.X i))))

instance : StandardBorelSpace S.Cl :=
  inferInstanceAs (StandardBorelSpace (Σ i, (closure (S.X i))))

/-- **`X̄ = X ∪ ∂X`** (Section 2.2), componentwise: since `X^i` is open, its
closure is the union of `X^i` and its frontier. -/
theorem closure_eq_union_frontier (i : S.Q) :
    closure (S.X i) = S.X i ∪ frontier (S.X i) := by
  rw [frontier, (S.isOpen_X i).interior_eq]
  exact (union_diff_cancel' (subset_refl _) subset_closure).symm

/-- The union in `X̄ = X ∪ ∂X` is disjoint: an open set is disjoint from its
frontier. -/
theorem disjoint_frontier (i : S.Q) : Disjoint (S.X i) (frontier (S.X i)) := by
  rw [disjoint_left]
  intro x hx hfx
  exact (hfx.2) (by simpa [(S.isOpen_X i).interior_eq] using hx)

/-! ### Convergence in the hybrid state space

Section 2.2 describes the metric `ρ` on `X` by the property that
`ρ(x_n, x) → 0` with `x_n = (i_n, x_n)` and `x = (i, x^i)` if and only if the
modes are eventually equal to `i` and the continuous components converge in
`X^i`.  The two lemmas below are exactly these two halves for the topology of
the disjoint sum. -/

/-- Within a fixed mode, convergence in `X` is convergence in `X^i`. -/
theorem tendsto_sigmaMk_iff {ι : Type*} {l : Filter ι} (i : S.Q)
    (y : ι → (S.X i)) (z : (S.X i)) :
    Tendsto (fun n => (Sigma.mk i (y n) : S.Hyb)) l (𝓝 (Sigma.mk i z)) ↔
      Tendsto y l (𝓝 z) :=
  ⟨fun h => (Topology.IsOpenEmbedding.sigmaMk (i := i)).isInducing.tendsto_nhds_iff.mpr h,
    fun h => ((Topology.IsOpenEmbedding.sigmaMk (i := i)).continuous.tendsto _).comp h⟩

/-- A net converging in `X` to a point of mode `i` is eventually in mode `i`. -/
theorem eventually_fst_eq_of_tendsto {ι : Type*} {l : Filter ι}
    (f : ι → S.Hyb) (i : S.Q) (z : (S.X i))
    (h : Tendsto f l (𝓝 (Sigma.mk i z))) :
    ∀ᶠ n in l, (f n).1 = i := by
  have hmem : (Set.range (Sigma.mk i) : Set S.Hyb) ∈ 𝓝 (Sigma.mk i z) :=
    (Topology.IsOpenEmbedding.sigmaMk (i := i)).isOpen_range.mem_nhds ⟨z, rfl⟩
  filter_upwards [h hmem] with n hn
  obtain ⟨w, hw⟩ := hn
  exact (congrArg Sigma.fst hw).symm

end HybridStateSpace

/-! ## Definition 1: General Stochastic Hybrid Systems -/

open HybridStateSpace

/-- **Definition 1** (Section 2.3).  A General Stochastic Hybrid System is a
collection `H = ((Q, d, 𝒳), b, σ, Init, λ, R)`:

* `(Q, d, 𝒳)` is the hybrid state space data, carried by `toHybridStateSpace`;
* `b` is a vector field on each mode;
* `σ` is a `d(i) × m` matrix field on each mode;
* `Init` is an initial probability measure on `(X, 𝓑(X))`;
* `lam` (written `λ` in the paper) is the transition rate function on `X̄`;
* `R` is the transition (reset) measure, a Markov kernel from `X̄` to `X`. -/
structure GSHS extends HybridStateSpace where
  /-- Dimension of the driving Wiener process. -/
  m : ℕ
  /-- The drift vector field `b(i, ·)` of mode `i` (Eq. (1)). -/
  b : ∀ i : Q, ModeSpace (d i) → ModeSpace (d i)
  /-- The diffusion coefficient `σ(i, ·)` of mode `i` (Eq. (1)). -/
  sig : ∀ i : Q, ModeSpace (d i) → Matrix (Fin (d i)) (Fin m) ℝ
  /-- The initial probability measure on the hybrid state space. -/
  Init : Measure (Hyb toHybridStateSpace)
  /-- `Init` is a probability measure. -/
  isProbabilityMeasure_Init : IsProbabilityMeasure Init
  /-- The transition rate `λ : X̄ → ℝ₊`. -/
  lam : Cl toHybridStateSpace → ℝ
  /-- The transition (reset) measure `R : X̄ × 𝓑(X) → [0,1]`, as a Markov
  kernel; Assumption 2(i),(ii) is exactly the statement that `R` is a Markov
  kernel. -/
  R : ProbabilityTheory.Kernel (Cl toHybridStateSpace) (Hyb toHybridStateSpace)
  /-- Assumption 2(ii): `R(x, ·)` is a probability measure for every `x`. -/
  isMarkovKernel_R : ProbabilityTheory.IsMarkovKernel R

attribute [instance] GSHS.isProbabilityMeasure_Init GSHS.isMarkovKernel_R

namespace GSHS

variable (H : GSHS)

/-- **Assumption 1** (continuous evolution): the coefficients `b` and `σ` are
bounded and Lipschitz continuous in the continuous state.  This is what
guarantees existence and uniqueness of the solution of the SDE (1) in each
mode. -/
structure ContinuousEvolution : Prop where
  /-- `b(i, ·)` is bounded. -/
  bdd_b : ∀ i, ∃ C : ℝ, ∀ x, ‖H.b i x‖ ≤ C
  /-- `σ(i, ·)` is bounded (entrywise). -/
  bdd_sig : ∀ i, ∃ C : ℝ, ∀ x j k, |H.sig i x j k| ≤ C
  /-- `b(i, ·)` is Lipschitz. -/
  lipschitz_b : ∀ i, ∃ K : NNReal, LipschitzWith K (H.b i)
  /-- `σ(i, ·)` is Lipschitz in `x` (entrywise). -/
  lipschitz_sig : ∀ i, ∃ K : ℝ, ∀ x y j k,
    |H.sig i x j k - H.sig i y j k| ≤ K * ‖x - y‖

/-- **Assumption 2** (discrete transitions), part (iii): the transition rate is
nonnegative, measurable and bounded.  Parts (i) and (ii) are carried by the
kernel structure of `R`. -/
structure DiscreteTransitions : Prop where
  /-- `λ ≥ 0`. -/
  nonneg_lam : ∀ x, 0 ≤ H.lam x
  /-- `λ` is measurable. -/
  measurable_lam : Measurable H.lam
  /-- `λ` is bounded (Section 2.2: "the jump rate `λ` is a measurable bounded
  function"), which makes `t ↦ λ(x_t)` locally integrable along every path. -/
  bdd_lam : ∃ C : ℝ, ∀ x, H.lam x ≤ C

end GSHS

end Bujorianu2006

end
