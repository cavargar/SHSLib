import SHSLib.Core.DavisHazardLaw

open MeasureTheory MeasurableSpace
open scoped NNReal

noncomputable section

/-! # Conditional channel laws

This module packages the state just before a reset, normalized channel weights,
and an event-integral interface for the conditional law of the next channel
mark after its holding time has been revealed.
-/

namespace SHS

variable {Q : Type*} [MeasurableSpace Q] [MeasurableSingletonClass Q]
  {n m : ℕ}

/-- The pre-reset state obtained by flowing the current history state for `u`. -/
def DavisPreJumpHistory.stateBeforeNextJump (S : SHS Q n m)
    (hflow : S.HasGlobalFlow) {k : ℕ} (H : DavisPreJumpHistory Q n m k)
    (u : ℝ≥0) : DavisState Q n :=
  davisFlow S hflow u H.currentState

/-- The normalized weight of reset channel `ℓ` at an augmented state.  At zero
total intensity all weights are defined to be zero; conditional channel laws
below are intended for states with positive total intensity. -/
def davisChannelProbability (S : SHS Q n m)
    (z : DavisState Q n) (ℓ : Fin m) : ℝ :=
  S.intensity ℓ z.1 z.2.1 z.2.2 / S.totalIntensity z

/-- Normalized channel weights are nonnegative. -/
theorem davisChannelProbability_nonneg (S : SHS Q n m)
    (z : DavisState Q n) (ℓ : Fin m) :
    0 ≤ davisChannelProbability S z ℓ := by
  unfold davisChannelProbability
  exact div_nonneg (S.intensity_nonneg ℓ z.1 z.2.1 z.2.2) (totalIntensity_nonneg S z)

/-- At a state with nonzero total intensity, normalized channel weights sum to
one. -/
theorem sum_davisChannelProbability (S : SHS Q n m)
    (z : DavisState Q n) (hz : S.totalIntensity z ≠ 0) :
    ∑ ℓ : Fin m, davisChannelProbability S z ℓ = 1 := by
  unfold davisChannelProbability
  rw [← Finset.sum_div]
  simp_rw [totalIntensity] at hz ⊢
  exact div_self hz

/-- The measurable space generated by the first `k` jumps together with the
next holding time.  This is the information available immediately before the
next channel mark is sampled. -/
def DavisJumpNoise.preChannelSpace
    (S : SHS Q n m) (hflow : S.HasGlobalFlow)
    {Ω : Type*} (ξ : DavisJumpNoise m Ω) (initial : DavisState Q n) (k : ℕ) :
    MeasurableSpace Ω :=
  MeasurableSpace.comap
    (fun ω => (davisPreJumpHistory S hflow ξ initial k ω, ξ.holdingTime k ω))
    inferInstance

/-- The history is measurable with respect to the corresponding pre-channel
space. -/
theorem DavisJumpNoise.preJumpHistory_measurable_preChannel
    (S : SHS Q n m) (hflow : S.HasGlobalFlow)
    {Ω : Type*} (ξ : DavisJumpNoise m Ω) (initial : DavisState Q n) (k : ℕ) :
    Measurable[ξ.preChannelSpace S hflow initial k]
      (davisPreJumpHistory S hflow ξ initial k) := by
  rw [DavisJumpNoise.preChannelSpace, measurable_iff_comap_le]
  set f : Ω → DavisPreJumpHistory Q n m k × ℝ≥0 := fun ω =>
    (davisPreJumpHistory S hflow ξ initial k ω, ξ.holdingTime k ω)
  show MeasurableSpace.comap (fun x => (f x).1) inferInstance ≤
    MeasurableSpace.comap f inferInstance
  simp only [← Function.comp_def]
  rw [← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono measurable_fst.comap_le

/-- The next holding time is measurable with respect to the corresponding
pre-channel space. -/
theorem DavisJumpNoise.holdingTime_measurable_preChannel
    (S : SHS Q n m) (hflow : S.HasGlobalFlow)
    {Ω : Type*} (ξ : DavisJumpNoise m Ω) (initial : DavisState Q n) (k : ℕ) :
    Measurable[ξ.preChannelSpace S hflow initial k] (ξ.holdingTime k) := by
  rw [DavisJumpNoise.preChannelSpace]
  rw [measurable_iff_comap_le]
  set f : Ω → DavisPreJumpHistory Q n m k × ℝ≥0 := fun ω => (davisPreJumpHistory S hflow ξ initial k ω, ξ.holdingTime k ω) with hf_def
  show MeasurableSpace.comap (fun x => (f x).2) NNReal.measurableSpace ≤ MeasurableSpace.comap f inferInstance
  simp only [← Function.comp_def]
  rw [← MeasurableSpace.comap_comp]
  refine MeasurableSpace.comap_mono ?_
  exact measurable_snd.comap_le

/-- Event-integral formulation of the normalized conditional channel law.  It
conditions on finite history and on the next holding time, hence evaluates the
channel intensity at the resulting pre-jump state. -/
structure DavisJumpNoise.ConditionalChannelLaw
    (S : SHS Q n m) (hflow : S.HasGlobalFlow)
    {Ω : Type*} [mΩ : MeasurableSpace Ω] (P : Measure Ω)
    (ξ : DavisJumpNoise m Ω) (initial : DavisState Q n) : Prop where
  channel_identity : ∀ (k : ℕ) (ℓ : Fin m) (A : Set Ω),
    MeasurableSet[ξ.preChannelSpace S hflow initial k] A →
      P (A ∩ {ω | ξ.channel k ω = ℓ}) =
        ∫⁻ ω in A, ENNReal.ofReal
          (davisChannelProbability S
            ((davisPreJumpHistory S hflow ξ initial k ω).stateBeforeNextJump
              S hflow (ξ.holdingTime k ω)) ℓ) ∂P

/-- The conditional channel law specializes to the unconditional probability
of a given mark by taking the conditioning event to be the whole space. -/
theorem DavisJumpNoise.ConditionalChannelLaw.measure_channel_eq
    {S : SHS Q n m} {hflow : S.HasGlobalFlow}
    {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω}
    {ξ : DavisJumpNoise m Ω} {initial : DavisState Q n}
    (hlaw : ξ.ConditionalChannelLaw S hflow P initial)
    (k : ℕ) (ℓ : Fin m) :
    P {ω | ξ.channel k ω = ℓ} =
      ∫⁻ ω, ENNReal.ofReal
        (davisChannelProbability S
          ((davisPreJumpHistory S hflow ξ initial k ω).stateBeforeNextJump
            S hflow (ξ.holdingTime k ω)) ℓ) ∂P := by
  have h := hlaw.channel_identity k ℓ Set.univ (by measurability)
  simpa using h

end SHS
