import SHSLib.Core.DavisElapsedOccupationMinimalFiltration

open MeasureTheory MeasurableSpace
open scoped ENNReal NNReal

noncomputable section

/-! # Observability for the natural state-path filtration

The elapsed occupation martingale theory has so far been instantiated for the
full-information filtration of the driving noise and for the minimal
filtration generated by the observable components themselves.  Neither is the
filtration an observer of the physical system actually has: that one is the
natural filtration of the assembled state path.

This module gives a concrete sufficient condition for the natural state-path
filtration to satisfy the componentwise observability interface: each of the
three observable components at elapsed time `t` is a measurable function of
the current augmented state at time `t`.  Models whose state records the
elapsed time since the last reset together with the accumulated reset
bookkeeping satisfy it.  Under this condition the martingale, generator, and
Dynkin-type statements become statements about the state path alone, and the
minimal filtration is contained in the natural path filtration.
-/

namespace SHS

variable {Q : Type*} [MeasurableSpace Q] [MeasurableSingletonClass Q]
  {n m : ℕ}

/-- Current-state observability of the three elapsed occupation components:
each of them is reported, at every elapsed time and for every deterministic
jump cap, by a measurable function of the current augmented state. -/
structure DavisElapsedOccupationCurrentStateObservable
    (S : SHS Q n m) (hflow : S.HasGlobalFlow)
    {Ω : Type*} (ξ : DavisJumpNoise m Ω) (hne : ξ.NonExplosive)
    (initial : DavisState Q n) (g : DavisState Q n → ℝ) where
  realized : ℕ → ℝ≥0 → DavisState Q n → ℝ
  realized_measurable : ∀ N t, Measurable (realized N t)
  realized_eq : ∀ N t ω,
    davisStoppedElapsedRealizedResetContribution
        S hflow ξ hne initial g N t ω =
      realized N t (davisJumpPath S hflow ξ hne initial t ω)
  completed : ℕ → ℝ≥0 → DavisState Q n → ℝ
  completed_measurable : ∀ N t, Measurable (completed N t)
  completed_eq : ∀ N t ω,
    davisStoppedElapsedCompletedResetOccupation
        S hflow ξ hne initial g N t ω =
      completed N t (davisJumpPath S hflow ξ hne initial t ω)
  active : ℕ → ℝ≥0 → DavisState Q n → ℝ
  active_measurable : ∀ N t, Measurable (active N t)
  active_eq : ∀ N t ω,
    davisStoppedElapsedActiveResetOccupation
        S hflow ξ hne initial g N t ω =
      active N t (davisJumpPath S hflow ξ hne initial t ω)

/-- Current-state observability makes the natural state-path filtration
satisfy the componentwise observability interface. -/
theorem DavisElapsedOccupationCurrentStateObservable.elapsedOccupationObservable_natural
    {S : SHS Q n m} {hflow : S.HasGlobalFlow}
    (hf : DavisFlowRegular S hflow) (hr : DavisResetRegular S)
    {Ω : Type*} [mΩ : MeasurableSpace Ω] {ξ : DavisJumpNoise m Ω}
    (hξ : ξ.MeasurableNoise) {hne : ξ.NonExplosive}
    {initial : DavisState Q n} {g : DavisState Q n → ℝ}
    (hpath : DavisElapsedOccupationCurrentStateObservable
      S hflow ξ hne initial g) :
    DavisElapsedOccupationObservable S hflow
      (ξ.naturalPathFiltration S hflow hf hr hξ hne initial)
      ξ hne initial g := by
  have hadapted := hξ.jumpPath_adapted_natural S hflow hf hr hne initial
  refine ⟨?_, ?_, ?_⟩
  · intro N t
    rw [show davisStoppedElapsedRealizedResetContribution
        S hflow ξ hne initial g N t =
      fun ω => hpath.realized N t (davisJumpPath S hflow ξ hne initial t ω)
      from funext (hpath.realized_eq N t)]
    exact (hpath.realized_measurable N t).comp (hadapted t)
  · intro N t
    rw [show davisStoppedElapsedCompletedResetOccupation
        S hflow ξ hne initial g N t =
      fun ω => hpath.completed N t (davisJumpPath S hflow ξ hne initial t ω)
      from funext (hpath.completed_eq N t)]
    exact (hpath.completed_measurable N t).comp (hadapted t)
  · intro N t
    rw [show davisStoppedElapsedActiveResetOccupation
        S hflow ξ hne initial g N t =
      fun ω => hpath.active N t (davisJumpPath S hflow ξ hne initial t ω)
      from funext (hpath.active_eq N t)]
    exact (hpath.active_measurable N t).comp (hadapted t)

/-- Under current-state observability the minimal observability filtration is
contained in the natural state-path filtration. -/
theorem DavisElapsedOccupationCurrentStateObservable.elapsedOccupationFiltration_le_natural
    {S : SHS Q n m} {hflow : S.HasGlobalFlow}
    {hf : DavisFlowRegular S hflow} {hr : DavisResetRegular S}
    {g : DavisState Q n → ℝ}
    (hreg : DavisResetOccupationRegular S hflow g)
    {Ω : Type*} [mΩ : MeasurableSpace Ω] {ξ : DavisJumpNoise m Ω}
    (hξ : ξ.MeasurableNoise) {hne : ξ.NonExplosive}
    {initial : DavisState Q n} (hg : Measurable g)
    (hpath : DavisElapsedOccupationCurrentStateObservable
      S hflow ξ hne initial g) :
    (@DavisResetOccupationRegular.elapsedOccupationFiltration
        Q _ _ n m S hflow hf hr g hreg Ω _ ξ hξ hne initial hg) ≤
      ξ.naturalPathFiltration S hflow hf hr hξ hne initial :=
  @DavisElapsedOccupationObservable.elapsedOccupationFiltration_le
    Q _ _ n m S hflow hf hr g hreg Ω _ _ ξ hξ hne initial hg
    (hpath.elapsedOccupationObservable_natural hf hr hξ)

/-- Martingale property for the natural state-path filtration: with
current-state observability, the occupation-centered reset process is a
martingale for the filtration generated by the state path itself. -/
theorem DavisStoppedElapsedOccupationIncrementLaw.martingale_natural
    {S : SHS Q n m} {hflow : S.HasGlobalFlow}
    {hf : DavisFlowRegular S hflow} {hr : DavisResetRegular S}
    {g : DavisState Q n → ℝ}
    (hreg : DavisResetOccupationRegular S hflow g)
    {Ω : Type*} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsFiniteMeasure P]
    {ξ : DavisJumpNoise m Ω} (hξ : ξ.MeasurableNoise)
    {hne : ξ.NonExplosive} (initial : DavisState Q n) (hg : Measurable g)
    (hpath : DavisElapsedOccupationCurrentStateObservable
      S hflow ξ hne initial g)
    (hlaw : DavisStoppedElapsedOccupationIncrementLaw S hflow P
      (ξ.naturalPathFiltration S hflow hf hr hξ hne initial)
      ξ hne initial g)
    (henv : ∀ t, Integrable
      (davisElapsedOccupationEnvelope S hflow ξ hne initial g t) P) :
    Martingale
      (davisElapsedOccupationCenteredResetProcess
        S hflow ξ hne initial g)
      (ξ.naturalPathFiltration S hflow hf hr hξ hne initial) P :=
  @DavisStoppedElapsedOccupationIncrementLaw.martingale
    Q _ _ n m S hflow hf hr g hreg Ω _ P _ _ ξ hξ hne initial hg
    (hpath.elapsedOccupationObservable_natural hf hr hξ) hlaw henv

/-- With current-state observability, the deterministic-cap increment law for
the natural state-path filtration is exactly the capped martingale property
for that filtration. -/
theorem DavisElapsedOccupationCurrentStateObservable.incrementLaw_iff_capped_martingale_natural
    {S : SHS Q n m} {hflow : S.HasGlobalFlow}
    (hf : DavisFlowRegular S hflow) (hr : DavisResetRegular S)
    {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsFiniteMeasure P]
    {ξ : DavisJumpNoise m Ω} (hξ : ξ.MeasurableNoise)
    {hne : ξ.NonExplosive}
    {initial : DavisState Q n} {g : DavisState Q n → ℝ}
    (hpath : DavisElapsedOccupationCurrentStateObservable
      S hflow ξ hne initial g)
    (henv : ∀ t, Integrable
      (davisElapsedOccupationEnvelope S hflow ξ hne initial g t) P) :
    DavisStoppedElapsedOccupationIncrementLaw S hflow P
        (ξ.naturalPathFiltration S hflow hf hr hξ hne initial)
        ξ hne initial g ↔
      ∀ N, Martingale
        (fun t => davisStoppedElapsedOccupationCenteredResetSum
          S hflow ξ hne initial g N t)
        (ξ.naturalPathFiltration S hflow hf hr hξ hne initial) P :=
  (hpath.elapsedOccupationObservable_natural hf hr
    hξ).incrementLaw_iff_capped_martingale henv

end SHS
