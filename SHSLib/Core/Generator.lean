import SHSLib.Core.Basic
import SHSLib.Foundations.DavisCh1
import SHSLib.Foundations.DavisCh2

open MeasureTheory MeasurableSpace Topology Filter

noncomputable section

/-! ## The Extended Generator (Eq. 9) -/

/-- A test function `ψ : Q × ℝⁿ × [0,∞) → ℝ` for the extended generator,
required to be C¹ with respect to its second and third arguments. -/
structure SHS.TestFunction (Q : Type*) (n : ℕ) where
  /-- The test function `ψ(q, x, t)`. -/
  toFun : Q → EuclideanSpace ℝ (Fin n) → ℝ → ℝ
  /-- Gradient of `ψ` with respect to `x` (i.e., `∂ψ/∂x`). -/
  grad_x : Q → EuclideanSpace ℝ (Fin n) → ℝ → EuclideanSpace ℝ (Fin n)
  /-- Partial derivative of `ψ` with respect to `t` (i.e., `∂ψ/∂t`). -/
  partial_t : Q → EuclideanSpace ℝ (Fin n) → ℝ → ℝ

/-- The extended generator `L` of an SHS (Eq. 9):

  `(Lψ)(q, x, t) = (∂ψ/∂x) · f(q,x,t) + ∂ψ/∂t
                    + Σ_{ℓ=1}^{m} (ψ(φ_ℓ(q,x,t), t) − ψ(q,x,t)) λ_ℓ(q,x,t)`

Following [Davis, 1993], we call the operator `ψ ↦ Lψ` the *extended generator*
of the SHS. -/
def SHS.extendedGenerator {Q : Type*} {n m : ℕ} (S : SHS Q n m)
    (ψ : SHS.TestFunction Q n)
    (q : Q) (x : EuclideanSpace ℝ (Fin n)) (t : ℝ) : ℝ :=
  -- Term 1: (∂ψ/∂x) · f(q,x,t)
  @inner ℝ _ _ (ψ.grad_x q x t) (S.f q x t) +
  -- Term 2: ∂ψ/∂t
  ψ.partial_t q x t +
  -- Term 3: Σ_ℓ (ψ(φ_ℓ(q,x,t), t) − ψ(q,x,t)) λ_ℓ(q,x,t)
  ∑ ℓ : Fin m,
    (ψ.toFun (S.phi_q ℓ q x t) (S.phi_x ℓ q x t) t - ψ.toFun q x t) *
      S.intensity ℓ q x t

/-! ## Theorem 2: Generator under finite expected transitions (Section 3.3)

This is the key technical result from which Theorem 1 is derived.
It requires Assumptions 1, 2(i) and the finiteness conditions (15)–(16).
The proof uses [Davis, Theorem 26.14] for PDPs.

**Note:** Theorem 2 is placed before Theorem 1 in the formalization because
Theorem 1's proof depends on Theorem 2 (following the paper's proof structure).
-/

/-- **Theorem 2** (Hespanha, 2005).
Under Assumptions 1 and 2(i), if the expected total number of transitions
is finite (Eq. 15):

  `E_{z₀}[Σ_ℓ N_ℓ(t)] < ∞`

and the absolute jumps in `ψ` at transition times have finite expectation (Eq. 16):

  `E_{z₀}[Σ_{t_k ≤ t} |ψ(q(t_k), x(t_k), t_k) − ψ(q(t_k⁻), x(t_k⁻), t_k)|] < ∞`

then the generator formula (8) holds and `C^ψ(t)` is a martingale (not just local). -/
theorem SHS.theorem2_PDP_generator
    {Q : Type*} [Fintype Q] [MeasurableSpace Q] {n m : ℕ}
    (S : SHS Q n m)
    (hflow : S.HasGlobalFlow)
    (hmeas : S.IntensitiesMeasurable)
    (ψ : SHS.TestFunction Q n)
    (z₀ : SHS.InitialCondition Q n) (t : ℝ)
    -- Probability space carrying SHS sample paths
    {Ω : Type*} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (q_proc : ℝ → Ω → Q) (x_proc : ℝ → Ω → EuclideanSpace ℝ (Fin n))
    (ht : z₀.t₀ ≤ t)
    (h_init_q : ∀ᵐ ω ∂P, q_proc z₀.t₀ ω = z₀.q₀)
    (h_init_x : ∀ᵐ ω ∂P, x_proc z₀.t₀ ω = z₀.x₀)
    /- Davis, Theorem 26.14 + finiteness conditions (15)-(16): the compensated
       process `Cˢ(ω) = ψ(q(s),x(s),s) − ψ(q₀,x₀,t₀) − ∫_{t₀}^{s} (Lψ) dr` is a
       true martingale with respect to some filtration `ℱ`. -/
    (ℱ : MeasureTheory.Filtration ℝ mΩ)
    [MeasureTheory.SigmaFiniteFiltration P ℱ]
    (hmart : MeasureTheory.Martingale
      (fun s ω => ψ.toFun (q_proc s ω) (x_proc s ω) s -
        ψ.toFun z₀.q₀ z₀.x₀ z₀.t₀ -
        ∫ r in Set.Icc z₀.t₀ s,
          S.extendedGenerator ψ (q_proc r ω) (x_proc r ω) r) ℱ P)
    /- Condition (15): finite expected cumulative intensity -/
    (hfinite_transitions : Integrable (fun ω => ∫ s in Set.Icc z₀.t₀ t,
        ∑ ℓ : Fin m, S.intensity ℓ (q_proc s ω) (x_proc s ω) s) P)
    /- Condition (16): finite expected absolute jumps in ψ -/
    (hfinite_jumps : Integrable (fun ω => ∫ s in Set.Icc z₀.t₀ t,
        ∑ ℓ : Fin m, |ψ.toFun (S.phi_q ℓ (q_proc s ω) (x_proc s ω) s)
                        (S.phi_x ℓ (q_proc s ω) (x_proc s ω) s) s -
                      ψ.toFun (q_proc s ω) (x_proc s ω) s| *
          S.intensity ℓ (q_proc s ω) (x_proc s ω) s) P)
    (h_int_ψ : Integrable (fun ω => ψ.toFun (q_proc t ω) (x_proc t ω) t) P)
    (h_int_Lψ : Integrable (fun ω => ∫ s in Set.Icc z₀.t₀ t,
        S.extendedGenerator ψ (q_proc s ω) (x_proc s ω) s) P) :
    -- The generator formula (Eq. 8) holds under weaker assumptions than Theorem 1
    ∫ ω, ψ.toFun (q_proc t ω) (x_proc t ω) t ∂P =
      ψ.toFun z₀.q₀ z₀.x₀ z₀.t₀ +
      ∫ ω, (∫ s in Set.Icc z₀.t₀ t,
        S.extendedGenerator ψ (q_proc s ω) (x_proc s ω) s) ∂P := by
  /- By Davis, Theorem 26.14 (`pdp_extended_generator_characterization`),
     the SHS state `(t, q, x, N₁, …, Nₘ)` is a PDP and the process
     `C^ψ(t) := ψ(q(t), x(t), t) − ψ(q₀, x₀, t₀) − ∫_{t₀}^{t} (Lψ) ds`
     is a local martingale.  Under the finite-transition condition (15)
     and the finite-jump condition (16), the local martingale is promoted
     to a true martingale (`pdp_generator_bounded_true_martingale`).
     Taking expectations and using `E[C^ψ(t₀)] = 0` (initial conditions)
     yields `E[C^ψ(t)] = 0`, i.e. the generator formula (8). -/
  -- Key intermediate fact from Davis Th. 26.14 + conditions (15)-(16):
  -- E[C^ψ(t)] = 0, where C^ψ(t) = ψ(q(t),x(t),t) - ψ₀ - ∫ Lψ ds.
  have hmartingale :
      ∫ ω, (ψ.toFun (q_proc t ω) (x_proc t ω) t -
        ψ.toFun z₀.q₀ z₀.x₀ z₀.t₀ -
        ∫ s in Set.Icc z₀.t₀ t,
          S.extendedGenerator ψ (q_proc s ω) (x_proc s ω) s) ∂P = 0 := by
    /- Davis Theorem 26.14: the SHS is a PDP and C^ψ is a true martingale.
       A true martingale with C^ψ(t₀) = 0 a.s. has E[C^ψ(t)] = 0.
       C^ψ(t₀) = ψ(q(t₀),x(t₀),t₀) - ψ(q₀,x₀,t₀) - 0 = 0 a.s.
       by h_init_q, h_init_x and ∫ over degenerate interval = 0. -/
    -- The expectation of a martingale is constant in time, so
    -- E[C^ψ(t)] = E[C^ψ(t₀)].
    have key := hmart.setIntegral_eq ht (s := Set.univ) MeasurableSet.univ
    simp only [MeasureTheory.setIntegral_univ] at key
    rw [← key]
    -- C^ψ(t₀) = 0 almost everywhere, so its expectation is 0.
    have hzero : (fun ω => ψ.toFun (q_proc z₀.t₀ ω) (x_proc z₀.t₀ ω) z₀.t₀ -
        ψ.toFun z₀.q₀ z₀.x₀ z₀.t₀ -
        ∫ r in Set.Icc z₀.t₀ z₀.t₀,
          S.extendedGenerator ψ (q_proc r ω) (x_proc r ω) r) =ᵐ[P] 0 := by
      filter_upwards [h_init_q, h_init_x] with ω hq hx
      rw [hq, hx]
      simp [Set.Icc_self]
    rw [integral_congr_ae hzero]; simp
  -- Now derive the generator formula by linearity of the integral.
  have h_sub : Integrable (fun ω =>
      ψ.toFun (q_proc t ω) (x_proc t ω) t -
      ψ.toFun z₀.q₀ z₀.x₀ z₀.t₀ -
      ∫ s in Set.Icc z₀.t₀ t,
        S.extendedGenerator ψ (q_proc s ω) (x_proc s ω) s) P :=
    (h_int_ψ.sub (integrable_const _)).sub h_int_Lψ
  have h1 : ∫ ω, (ψ.toFun (q_proc t ω) (x_proc t ω) t -
      ψ.toFun z₀.q₀ z₀.x₀ z₀.t₀ -
      ∫ s in Set.Icc z₀.t₀ t,
        S.extendedGenerator ψ (q_proc s ω) (x_proc s ω) s) ∂P =
    ∫ ω, (ψ.toFun (q_proc t ω) (x_proc t ω) t -
      ψ.toFun z₀.q₀ z₀.x₀ z₀.t₀) ∂P -
    ∫ ω, (∫ s in Set.Icc z₀.t₀ t,
        S.extendedGenerator ψ (q_proc s ω) (x_proc s ω) s) ∂P :=
    integral_sub (h_int_ψ.sub (integrable_const _)) h_int_Lψ
  have h2 : ∫ ω, (ψ.toFun (q_proc t ω) (x_proc t ω) t -
      ψ.toFun z₀.q₀ z₀.x₀ z₀.t₀) ∂P =
    ∫ ω, ψ.toFun (q_proc t ω) (x_proc t ω) t ∂P -
    ψ.toFun z₀.q₀ z₀.x₀ z₀.t₀ := by
    rw [integral_sub h_int_ψ (integrable_const _)]
    simp [integral_const]
  linarith

/-! ## Lemma 2: Bounded intensities/test functions imply conditions (15)–(16)

If the intensities and test function are bounded by continuous functions along
sample paths, then conditions (15) and (16) hold.

The key estimate is (proved using the Erlang distribution):

  `P(Σ_ℓ N_ℓ(t) ≥ k) ≤ (∫_{t₀}^{t} α(s) ds)^k / k!`

which implies:

  `E[Σ_ℓ N_ℓ(t)] ≤ (∫_{t₀}^{t} α(s) ds) · exp(∫_{t₀}^{t} α(s) ds) < ∞`
-/

/-
**Lemma 2** (Hespanha, 2005).
If the transition intensities are bounded by `α(t)` and the test function
is bounded by `β(t)` along sample paths (Eq. 17), then conditions (15) and (16) hold.

In particular:
  `E[Σ_ℓ N_ℓ(t)] ≤ (∫_{t₀}^{t} α(s) ds) · exp(∫_{t₀}^{t} α(s) ds)`
-/
theorem SHS.lemma2_bounded_implies_finite
    {Q : Type*} [Fintype Q] {n m : ℕ}
    (S : SHS Q n m)
    (ψ : SHS.TestFunction Q n)
    (z₀ : SHS.InitialCondition Q n)
    /- Bound on intensities: λ_ℓ(q(t), x(t), t) ≤ α(t) -/
    (alpha : ℝ → ℝ) (halpha_cont : Continuous alpha) (halpha_nonneg : ∀ t, 0 ≤ alpha t)
    /- Bound on test function: |ψ(q(t), x(t), t)| ≤ β(t) -/
    (beta : ℝ → ℝ) (hbeta_cont : Continuous beta) (hbeta_nonneg : ∀ t, 0 ≤ beta t)
    (t : ℝ) (ht : z₀.t₀ ≤ t)
    -- Probability space carrying SHS sample paths
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (q_proc : ℝ → Ω → Q) (x_proc : ℝ → Ω → EuclideanSpace ℝ (Fin n))
    /- Intensities bounded by α along sample paths -/
    (hintensity_bound : ∀ ℓ, ∀ᵐ ω ∂P, ∀ s ∈ Set.Icc z₀.t₀ t,
      S.intensity ℓ (q_proc s ω) (x_proc s ω) s ≤ alpha s)
    /- Test function bounded by β along sample paths -/
    (hpsi_bound : ∀ᵐ ω ∂P, ∀ s ∈ Set.Icc z₀.t₀ t,
      |ψ.toFun (q_proc s ω) (x_proc s ω) s| ≤ beta s)
    /- Test function at the reset image also bounded by β along sample paths -/
    (hpsi_reset_bound : ∀ ℓ, ∀ᵐ ω ∂P, ∀ s ∈ Set.Icc z₀.t₀ t,
      |ψ.toFun (S.phi_q ℓ (q_proc s ω) (x_proc s ω) s)
               (S.phi_x ℓ (q_proc s ω) (x_proc s ω) s) s| ≤ beta s)
    /- Measurability of the two path functionals over the probability space -/
    (hmeas1 : AEStronglyMeasurable (fun ω => ∫ s in Set.Icc z₀.t₀ t,
        ∑ ℓ : Fin m, S.intensity ℓ (q_proc s ω) (x_proc s ω) s) P)
    (hmeas2 : AEStronglyMeasurable (fun ω => ∫ s in Set.Icc z₀.t₀ t,
        ∑ ℓ : Fin m, |ψ.toFun (S.phi_q ℓ (q_proc s ω) (x_proc s ω) s)
                        (S.phi_x ℓ (q_proc s ω) (x_proc s ω) s) s -
                      ψ.toFun (q_proc s ω) (x_proc s ω) s| *
          S.intensity ℓ (q_proc s ω) (x_proc s ω) s) P) :
    -- Conditions (15) and (16) of Theorem 2 hold
    Integrable (fun ω => ∫ s in Set.Icc z₀.t₀ t,
        ∑ ℓ : Fin m, S.intensity ℓ (q_proc s ω) (x_proc s ω) s) P ∧
    Integrable (fun ω => ∫ s in Set.Icc z₀.t₀ t,
        ∑ ℓ : Fin m, |ψ.toFun (S.phi_q ℓ (q_proc s ω) (x_proc s ω) s)
                        (S.phi_x ℓ (q_proc s ω) (x_proc s ω) s) s -
                      ψ.toFun (q_proc s ω) (x_proc s ω) s| *
          S.intensity ℓ (q_proc s ω) (x_proc s ω) s) P := by
  refine' ⟨ _, _ ⟩;
  · refine' MeasureTheory.Integrable.mono' ( MeasureTheory.integrable_const _ ) hmeas1 _;
    exact ∫ s in Set.Icc z₀.t₀ t, ∑ ℓ : Fin m, alpha s;
    filter_upwards [ MeasureTheory.ae_all_iff.2 hintensity_bound ] with ω hω;
    refine' le_trans ( MeasureTheory.norm_integral_le_integral_norm _ ) ( MeasureTheory.integral_mono_of_nonneg _ _ _ );
    · exact Filter.Eventually.of_forall fun x => norm_nonneg _;
    · exact Continuous.integrableOn_Icc ( by continuity );
    · filter_upwards [ MeasureTheory.ae_restrict_mem measurableSet_Icc ] with s hs using by rw [ Real.norm_of_nonneg ( Finset.sum_nonneg fun _ _ => S.intensity_nonneg _ _ _ _ ) ] ; exact Finset.sum_le_sum fun _ _ => hω _ _ hs;
  · refine' MeasureTheory.Integrable.mono' _ _ _;
    refine' fun ω => ∫ s in Set.Icc z₀.t₀ t, ∑ ℓ : Fin m, ( 2 * beta s ) * alpha s ∂MeasureTheory.volume;
    · exact MeasureTheory.integrable_const _;
    · exact hmeas2;
    · filter_upwards [ hpsi_bound, MeasureTheory.ae_all_iff.2 hpsi_reset_bound, MeasureTheory.ae_all_iff.2 hintensity_bound ] with ω hω₁ hω₂ hω₃;
      refine' le_trans ( MeasureTheory.norm_integral_le_integral_norm _ ) ( MeasureTheory.integral_mono_of_nonneg _ _ _ );
      · exact Filter.Eventually.of_forall fun x => norm_nonneg _;
      · exact Continuous.integrableOn_Icc ( by continuity );
      · filter_upwards [ MeasureTheory.ae_restrict_mem measurableSet_Icc ] with s hs;
        rw [ Real.norm_of_nonneg ( Finset.sum_nonneg fun _ _ => mul_nonneg ( abs_nonneg _ ) ( S.intensity_nonneg _ _ _ _ ) ) ];
        exact Finset.sum_le_sum fun i _ => mul_le_mul ( abs_sub _ _ |> le_trans <| by linarith [ hω₁ s hs, hω₂ i s hs ] ) ( hω₃ i s hs ) ( S.intensity_nonneg i _ _ _ ) ( by linarith [ hbeta_nonneg s ] )

/-! ## Theorem 1: Main Generator Formula (Eq. 8)

For every initial condition `z₀ = (q₀, x₀, t₀)` and every C¹ test function `ψ`:

  `E_{z₀}[ψ(q(t), x(t), t)] = ψ(q₀, x₀, t₀)
                                + E_{z₀}[∫_{t₀}^{t} (Lψ)(q(s), x(s), s) ds]`

This is the main result of the paper (Section 3). The proof (Section 3.3) proceeds
by identifying the SHS state as a piecewise-deterministic Markov process (PDP)
in the sense of [Davis, 1993] and applying [Davis, Theorem 26.14].
-/

/-- **Theorem 1** (Hespanha, 2005).
Under Assumptions 1 and 2, for every initial condition and every C¹ test function `ψ`,
the expectation formula (8) holds:

  `E[ψ(q(t), x(t), t)] = ψ(q₀, x₀, t₀) + E[∫_{t₀}^{t} (Lψ)(q(s), x(s), s) ds]`

Equivalently, in differential form (Eq. 10):

  `d/dt E[ψ(q(t), x(t), t)] = E[(Lψ)(q(t), x(t), t)]`

The proof uses the fact that the SHS state `{t, q, x, N₁, …, Nₘ}` is a PDP
and that `C^ψ(t) := ψ(q(t), x(t), t) − ψ(q₀, x₀, t₀) − ∫_{t₀}^{t} (Lψ)(…) ds`
is a martingale (Theorem 2 + Lemma 2).

**Note (formalization):** The original statement was missing hypotheses connecting
the processes `q_proc`/`x_proc` to the SHS dynamics. Following the paper's proof
structure (Theorem 1 = Theorem 2 + Lemma 2), we add conditions (15) and (16)
(finite expected transitions and finite expected jumps) as explicit hypotheses.
These conditions are implied by `GlobalBound` when the processes actually follow
the SHS dynamics (see `SHS.lemma2_bounded_implies_finite`). -/
theorem SHS.theorem1_generator_formula
    {Q : Type*} [Fintype Q] [MeasurableSpace Q] {n m : ℕ}
    (S : SHS Q n m)
    (hflow : S.HasGlobalFlow)
    (hmeas : S.IntensitiesMeasurable)
    (hbound : S.GlobalBound)
    (ψ : SHS.TestFunction Q n)
    (z₀ : SHS.InitialCondition Q n) (t : ℝ)
    -- Probability space carrying SHS sample paths
    {Ω : Type*} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (q_proc : ℝ → Ω → Q) (x_proc : ℝ → Ω → EuclideanSpace ℝ (Fin n))
    (ht : z₀.t₀ ≤ t)
    (h_init_q : ∀ᵐ ω ∂P, q_proc z₀.t₀ ω = z₀.q₀)
    (h_init_x : ∀ᵐ ω ∂P, x_proc z₀.t₀ ω = z₀.x₀)
    /- Davis, Theorem 26.14: the compensated process is a martingale. -/
    (ℱ : MeasureTheory.Filtration ℝ mΩ)
    [MeasureTheory.SigmaFiniteFiltration P ℱ]
    (hmart : MeasureTheory.Martingale
      (fun s ω => ψ.toFun (q_proc s ω) (x_proc s ω) s -
        ψ.toFun z₀.q₀ z₀.x₀ z₀.t₀ -
        ∫ r in Set.Icc z₀.t₀ s,
          S.extendedGenerator ψ (q_proc r ω) (x_proc r ω) r) ℱ P)
    (h_int_ψ : Integrable (fun ω => ψ.toFun (q_proc t ω) (x_proc t ω) t) P)
    (h_int_Lψ : Integrable (fun ω => ∫ s in Set.Icc z₀.t₀ t,
        S.extendedGenerator ψ (q_proc s ω) (x_proc s ω) s) P)
    /- Condition (15): finite expected cumulative transitions (from Theorem 2) -/
    (hfinite_transitions : Integrable (fun ω => ∫ s in Set.Icc z₀.t₀ t,
        ∑ ℓ : Fin m, S.intensity ℓ (q_proc s ω) (x_proc s ω) s) P)
    /- Condition (16): finite expected absolute jumps in ψ (from Theorem 2) -/
    (hfinite_jumps : Integrable (fun ω => ∫ s in Set.Icc z₀.t₀ t,
        ∑ ℓ : Fin m, |ψ.toFun (S.phi_q ℓ (q_proc s ω) (x_proc s ω) s)
                        (S.phi_x ℓ (q_proc s ω) (x_proc s ω) s) s -
                      ψ.toFun (q_proc s ω) (x_proc s ω) s| *
          S.intensity ℓ (q_proc s ω) (x_proc s ω) s) P) :
    ∫ ω, ψ.toFun (q_proc t ω) (x_proc t ω) t ∂P =
      ψ.toFun z₀.q₀ z₀.x₀ z₀.t₀ +
      ∫ ω, (∫ s in Set.Icc z₀.t₀ t,
        S.extendedGenerator ψ (q_proc s ω) (x_proc s ω) s) ∂P :=
  S.theorem2_PDP_generator hflow hmeas ψ z₀ t P q_proc x_proc ht
    h_init_q h_init_x ℱ hmart hfinite_transitions hfinite_jumps h_int_ψ h_int_Lψ

/-! ## Equation 10: Differential form of the generator formula

Equation (10) is the differential form of Theorem 1 / Eq. (8):

  `d/dt E[ψ(q(t), x(t), t)] = E[(Lψ)(q(t), x(t), t)]`

This is derived by differentiating both sides of (8) using the
Fundamental Theorem of Calculus.
-/

/-- **Equation 10** (Hespanha, 2005). Differential form of the generator formula.

Given Eq. (8) in the abstract form

  `F(t) = F(t₀) + ∫_{t₀}^{t} G(s) ds`

where `F(t) := E[ψ(q(t), x(t), t)]` and `G(t) := E[(Lψ)(q(t), x(t), t)]`,
differentiating both sides with respect to `t` yields

  `dF/dt (t) = G(t)`,

i.e., `d/dt E[ψ(q(t), x(t), t)] = E[(Lψ)(q(t), x(t), t)]`.

The derivation uses the Fundamental Theorem of Calculus
(`intervalIntegral.integral_hasDerivAt_right`). -/
theorem SHS.eq10_differential_generator_formula
    (F G : ℝ → ℝ) (t₀ : ℝ)
    (hG_cont : ContinuousAt G t₀)
    (hG_int : ∀ t, IntervalIntegrable G volume t₀ t)
    (heq8 : ∀ t, F t = F t₀ + ∫ s in t₀..t, G s) :
    HasDerivAt F (G t₀) t₀ := by
  -- By the Fundamental Theorem of Calculus, if $G$ is continuous at $t₀$, then the derivative of $\int_{t₀}^{t} G(s) \, ds$ at $t₀$ is $G(t₀)$.
  have h_ftc : HasDerivAt (fun t => ∫ s in t₀..t, G s) (G t₀) t₀ := by
    apply_rules [ intervalIntegral.integral_hasDerivAt_right ];
    constructor;
    refine' ⟨ Metric.ball_mem_nhds _ zero_lt_one, _ ⟩;
    have h_integrable : MeasureTheory.IntegrableOn G (Metric.ball t₀ 1) := by
      have h_integrable : MeasureTheory.IntegrableOn G (Metric.closedBall t₀ 1) := by
        have h_integrable : IntervalIntegrable G volume (t₀ - 1) (t₀ + 1) := by
          have := hG_int ( t₀ - 1 ) ; have := hG_int ( t₀ + 1 ) ; simp_all +decide [ intervalIntegrable_iff ] ;
          rw [ Set.uIoc_of_le ( by linarith ) ] ; exact MeasureTheory.IntegrableOn.union ‹_› ‹_› |> fun h => h.mono_set <| Set.Ioc_subset_Ioc_union_Ioc;
        rw [ intervalIntegrable_iff_integrableOn_Icc_of_le ( by linarith ) ] at h_integrable;
        exact h_integrable.mono_set ( fun x hx => ⟨ by linarith [ abs_le.mp ( Metric.mem_closedBall.mp hx ) ], by linarith [ abs_le.mp ( Metric.mem_closedBall.mp hx ) ] ⟩ );
      exact h_integrable.mono_set <| Metric.ball_subset_closedBall;
    exact h_integrable.1;
  convert h_ftc.add_const ( F t₀ ) using 1 ; ext t ; rw [ heq8 t ] ; ring

/-! ## Lemma 1: Linear growth implies global boundedness (Assumption 2(ii))

Assumption 2(ii) holds if there exist a continuous function `γ_f` and constants
`c_f`, `c_φ` such that:
  - `‖f(q, x, t)‖ ≤ max{γ_f(t) ‖x‖, c_f}`
  - `‖φ^x_ℓ(q, x, t)‖ ≤ max{‖x‖, c_φ}`
for all `q ∈ Q`, `x ∈ ℝⁿ`, `t ≥ 0`, `ℓ ∈ {1, …, m}`.

The key idea is that linear growth of `f` combined with non-expansive resets
(growth constant ≤ 1) prevents finite escape time.
The proof uses the Bellman–Gronwall Lemma.
-/

/-
⚠  **Lemma 1 is FALSE as literally formalized below** (original kept as line
comments). The formalized right-hand side contains the term `c_f / gamma_f
z₀.t₀`. In Lean, division by zero returns `0`, so whenever `gamma_f z₀.t₀ = 0`
this term is `0` regardless of `c_f`. Taking `gamma_f ≡ 0` therefore collapses
the bound to `Real.exp 0 * max (max ‖x₀‖ 0) c_φ`, while the flow of a *constant*
nonzero drift grows linearly in `t` and is unbounded. Hence the inequality
fails; this is certified by `SHS.lemma1_linear_growth_bound_false` below.

The intended (true) statement of Hespanha's Eq. (35) requires `gamma_f` to be
bounded away from `0` (e.g. a positive constant `γ_f > 0`, as in the paper's
Grönwall argument), together with integrability of `s ↦ f(q₀, flow s, s)` and
`s ↦ gamma_f s * ‖flow s‖` on `[t₀, t]`; only under such hypotheses does the
Bellman–Grönwall lemma yield the stated exponential bound. A robust,
hypothesis-free alternative is the sum-form Grönwall bound
`‖x(t)‖ ≤ (‖x₀‖ + c_f · (t − t₀)) · exp(∫ γ_f)`.

Original statement, preserved verbatim (line-commented):

/ -- **Lemma 1** (Hespanha, 2005).
Under linear growth conditions on `f` and `φ`, the sample paths are globally
bounded (Assumption 2(ii) holds).
Specifically, `‖x(t)‖ ≤ e^{∫_{t₀}^{t} γ_f(r) dr} · max{‖x₀‖, c_f/γ_f(t₀), c_φ}`
for all `t ≥ t₀` with probability one. (Eq. 35) - /
theorem SHS.lemma1_linear_growth_bound
{Q : Type*} [Fintype Q] {n m : ℕ}
(S : SHS Q n m)
(hflow : S.HasGlobalFlow)
(gamma_f : ℝ → ℝ) (hgamma_cont : Continuous gamma_f) (hgamma_nonneg : ∀ t, 0 ≤ gamma_f t)
(c_f : ℝ) (hc_f : 0 ≤ c_f)
(c_phi : ℝ) (hc_phi : 0 ≤ c_phi)
(hf_growth : ∀ q x t, ‖S.f q x t‖ ≤ max (gamma_f t * ‖x‖) c_f)
(hphi_growth : ∀ ℓ q x t, ‖S.phi_x ℓ q x t‖ ≤ max ‖x‖ c_phi)
(z₀ : SHS.InitialCondition Q n)
(t : ℝ) (ht : z₀.t₀ ≤ t) :
‖hflow.flow z₀.t₀ z₀.q₀ z₀.x₀ t‖ ≤
Real.exp (∫ r in Set.Icc z₀.t₀ t, gamma_f r) *
max (max ‖z₀.x₀‖ (c_f / gamma_f z₀.t₀)) c_phi := by
sorry
-/

/-- **Certificate that the formalized `lemma1_linear_growth_bound` is false.**

Counterexample: `Q = Unit`, `n = 1`, `m = 0`, constant unit drift `f ≡ e₀`
(so `c_f = 1` works), `gamma_f ≡ 0`, `c_φ = 0`, initial `x₀ = 0` at `t₀ = 0`,
and `t = 1`. The flow is `x(t) = x₀ + (t − t₀) e₀`, so `‖x(1)‖ = 1`, whereas the
claimed bound evaluates to `exp 0 · max (max 0 (1/0)) 0 = 0`, and `1 ≤ 0` is
false.
-/
theorem SHS.lemma1_linear_growth_bound_false :
    ¬ ∀ (Q : Type) [Fintype Q] (n m : ℕ)
        (S : SHS Q n m) (hflow : S.HasGlobalFlow)
        (gamma_f : ℝ → ℝ), Continuous gamma_f → (∀ t, 0 ≤ gamma_f t) →
        ∀ (c_f : ℝ), 0 ≤ c_f → ∀ (c_phi : ℝ), 0 ≤ c_phi →
        (∀ q x t, ‖S.f q x t‖ ≤ max (gamma_f t * ‖x‖) c_f) →
        (∀ ℓ q x t, ‖S.phi_x ℓ q x t‖ ≤ max ‖x‖ c_phi) →
        ∀ (z₀ : SHS.InitialCondition Q n) (t : ℝ), z₀.t₀ ≤ t →
        ‖hflow.flow z₀.t₀ z₀.q₀ z₀.x₀ t‖ ≤
          Real.exp (∫ r in Set.Icc z₀.t₀ t, gamma_f r) *
            max (max ‖z₀.x₀‖ (c_f / gamma_f z₀.t₀)) c_phi := by
  push_neg;
  refine' ⟨ PUnit, inferInstance, 1, 0, _, _, 0, continuous_const, by norm_num, _ ⟩ <;> norm_num [ EuclideanSpace.norm_eq ] at *;
  refine' { f := fun _ _ _ => EuclideanSpace.single 0 1, phi := fun ℓ => ℓ.elim0, intensity := fun ℓ => ℓ.elim0, intensity_nonneg := fun ℓ => ℓ.elim0 };
  refine' ⟨ _, _, _ ⟩;
  refine' fun t₀ q₀ x₀ t => x₀ + ( Max.max 0 ( t - t₀ ) ) • EuclideanSpace.single 0 1;
  all_goals norm_num [ EuclideanSpace.norm_eq ] at *;
  · exact fun t₀ t => max_comm _ _;
  · refine' ⟨ 1, by norm_num, 0, by norm_num, by norm_num, ⟨ ⟨ ⟩, 0, 0 ⟩, 1, _, _, _ ⟩ <;> norm_num [ EuclideanSpace.norm_eq ] at *

/-
**Lemma 1 (Hespanha, 2005, Eq. 35), corrected and provable form.**

The original function-valued statement is *false* (see
`SHS.lemma1_linear_growth_bound_false`) because of the `c_f / gamma_f t₀`
division-by-zero degeneracy.  Here we give the robust, true form using a
*constant* linear-growth rate `K ≥ 0`: if the drift obeys the linear-growth
bound `‖f(q₀,x,t)‖ ≤ max (K‖x‖) c_f`, then along the continuous flow the state
is bounded by the Grönwall envelope
`‖x(t)‖ ≤ gronwallBound ‖x₀‖ K c_f (t − t₀)`
(which for `K > 0` equals `(‖x₀‖ + c_f/K)·e^{K(t−t₀)} − c_f/K`).  Since only the
drift governs the continuous flow, the reset bound `c_φ` is not needed.

The continuity hypothesis `hf_cont` (the drift evaluated along the trajectory is
continuous in time) is what lets the integral form `flow_ode` of the flow be
differentiated via the Fundamental Theorem of Calculus.
-/
theorem SHS.lemma1_linear_growth_bound
    {Q : Type*} [Fintype Q] {n m : ℕ}
    (S : SHS Q n m) (hflow : S.HasGlobalFlow)
    (K : ℝ) (hK : 0 ≤ K) (c_f : ℝ) (hc_f : 0 ≤ c_f)
    (z₀ : SHS.InitialCondition Q n)
    (hf_growth : ∀ x t, ‖S.f z₀.q₀ x t‖ ≤ max (K * ‖x‖) c_f)
    (hf_cont : Continuous
      (fun s => S.f z₀.q₀ (hflow.flow z₀.t₀ z₀.q₀ z₀.x₀ s) s))
    (t : ℝ) (ht : z₀.t₀ ≤ t) :
    ‖hflow.flow z₀.t₀ z₀.q₀ z₀.x₀ t‖ ≤
      gronwallBound ‖z₀.x₀‖ K c_f (t - z₀.t₀) := by
  -- Apply the Grönwall inequality to the integral equation.
  have h_gronwall : ∀ t ≥ z₀.t₀, ‖hflow.flow z₀.t₀ z₀.q₀ z₀.x₀ t‖ ≤ gronwallBound ‖z₀.x₀‖ K c_f (t - z₀.t₀) := by
    intro t ht
    set g : ℝ → EuclideanSpace ℝ (Fin n) := fun s => hflow.flow z₀.t₀ z₀.q₀ z₀.x₀ s
    set f' : ℝ → EuclideanSpace ℝ (Fin n) := fun s => S.f z₀.q₀ (g s) s
    have hg : ∀ τ, g τ = z₀.x₀ + ∫ s in Set.Icc z₀.t₀ τ, f' s := by
      exact fun τ => hflow.flow_ode z₀.t₀ z₀.q₀ z₀.x₀ τ
    have hg_cont : Continuous g := by
      rw [ show g = _ from funext hg ];
      refine' continuous_const.add _;
      rw [ show ( fun x => ∫ s in Set.Icc z₀.t₀ x, f' s ) = fun x => if x ≥ z₀.t₀ then ∫ s in z₀.t₀..x, f' s else 0 from funext fun x => ?_ ];
      · apply_rules [ Continuous.if_le, continuous_const ];
        · apply_rules [ intervalIntegral.continuous_primitive, hf_cont.intervalIntegrable ];
        · exact continuous_id;
        · simp +contextual [ intervalIntegral.integral_of_le ];
      · split_ifs <;> simp_all +decide [ MeasureTheory.integral_Icc_eq_integral_Ioc, intervalIntegral.integral_of_le ]
    have hg_deriv : ∀ x ∈ Set.Ico z₀.t₀ t, HasDerivWithinAt g (f' x) (Set.Ici x) x := by
      intro x hx
      have h_deriv : HasDerivWithinAt (fun τ => ∫ s in z₀.t₀..τ, f' s) (f' x) (Set.Ici x) x := by
        apply_rules [ intervalIntegral.integral_hasDerivWithinAt_right ];
        · exact hf_cont.intervalIntegrable _ _;
        · exact hf_cont.stronglyMeasurable.stronglyMeasurableAtFilter;
        · exact hf_cont.continuousWithinAt;
      rw [ hasDerivWithinAt_iff_tendsto ] at *;
      refine' h_deriv.congr' _;
      filter_upwards [ self_mem_nhdsWithin ] with x' hx' ; simp +decide [ hg x', hg x, MeasureTheory.integral_Icc_eq_integral_Ioc, intervalIntegral.integral_of_le hx.1, intervalIntegral.integral_of_le hx'.out ] ; ring;
      exact Or.inl ( by rw [ intervalIntegral.integral_of_le ( by linarith [ hx.1, hx'.out ] ) ] )
    have hg_init : ‖g z₀.t₀‖ ≤ ‖z₀.x₀‖ := by
      simp +zetaDelta at *;
      rw [ hflow.flow_init ]
    have hg_growth : ∀ x ∈ Set.Ico z₀.t₀ t, ‖f' x‖ ≤ K * ‖g x‖ + c_f := by
      intro x _
      refine (hf_growth (g x) x).trans (max_le ?_ ?_)
      · linarith [hc_f]
      · linarith [mul_nonneg hK (norm_nonneg (g x))]
    have := @norm_le_gronwallBound_of_norm_deriv_right_le;
    exact this ( hg_cont.continuousOn ) hg_deriv hg_init hg_growth t ⟨ ht, le_rfl ⟩;
  exact h_gronwall t ht

/-! ## Section 3.1: Generalized SHS with distributional resets -/

/-- A generalized SHS where transitions reset to a state drawn from a
distribution `ν_ℓ` over `Q × ℝⁿ`, rather than a deterministic map.

The extended generator becomes:
  `(Lψ)(q,x,t) = (∂ψ/∂x) · f + ∂ψ/∂t
                  + Σ_ℓ ∫_{Q×ℝⁿ} (ψ(q̄,x̄,t) − ψ(q,x,t)) λ_ℓ(q,x,t) ν_ℓ(q,x,t,dq̄,dx̄)` -/
structure SHS.Generalized (Q : Type*) [MeasurableSpace Q] (n : ℕ) (m : ℕ) where
  /-- Vector field. -/
  f : Q → EuclideanSpace ℝ (Fin n) → ℝ → EuclideanSpace ℝ (Fin n)
  /-- Transition intensities. -/
  transIntensity : Fin m → Q → EuclideanSpace ℝ (Fin n) → ℝ → ℝ
  /-- Reset distributions `ν_ℓ(q, x, t, ·)` as measures on `Q × ℝⁿ`. -/
  resetDist : Fin m → Q → EuclideanSpace ℝ (Fin n) → ℝ →
    Measure (Q × EuclideanSpace ℝ (Fin n))

/-! ## Section 3.1: SHS with diffusion (Eq. 13–14)

When the continuous dynamics is driven by Brownian motion:
  `ẋ = f(q, x, t) + Σ_i g_i(q, x, t) ẇ_i`

the extended generator acquires a second-order term (Eq. 14):
  `(Lψ)(q,x,t) = (∂ψ/∂x)·f + ∂ψ/∂t
    + Σ_ℓ (ψ(φ_ℓ(…),t) − ψ(…)) λ_ℓ
    + ½ Σ_i g_i' (∂²ψ/∂x²) g_i`
-/

/-- A test function for diffusion SHSs, additionally carrying the Hessian. -/
structure SHS.TestFunctionC2 (Q : Type*) (n : ℕ) extends SHS.TestFunction Q n where
  /-- Hessian of `ψ` with respect to `x` (i.e., `∂²ψ/∂x²`). -/
  hessian_x : Q → EuclideanSpace ℝ (Fin n) → ℝ →
    Matrix (Fin n) (Fin n) ℝ

/-- An SHS with diffusion (Eq. 13): the continuous dynamics on each mode is
`ẋ = f(q,x,t) + Σ_i g_i(q,x,t) ẇ_i` where `w_i` are independent Brownian motions. -/
structure SHS.WithDiffusion (Q : Type*) (n : ℕ) (m : ℕ) (k : ℕ)
    extends SHS Q n m where
  /-- Diffusion coefficients `g_i(q, x, t)` for `i ∈ {1, …, k}`. -/
  g : Fin k → Q → EuclideanSpace ℝ (Fin n) → ℝ → EuclideanSpace ℝ (Fin n)

/-- The extended generator for an SHS with diffusion (Eq. 14):

  `(Lψ)(q,x,t) = (∂ψ/∂x)·f + ∂ψ/∂t
                  + Σ_ℓ (ψ(φ_ℓ(…),t) − ψ(…)) λ_ℓ
                  + ½ Σ_i g_i(q,x,t)ᵀ (∂²ψ/∂x²) g_i(q,x,t)` -/
def SHS.WithDiffusion.extendedGenerator {Q : Type*} {n m k : ℕ}
    (S : SHS.WithDiffusion Q n m k)
    (ψ : SHS.TestFunctionC2 Q n)
    (q : Q) (x : EuclideanSpace ℝ (Fin n)) (t : ℝ) : ℝ :=
  -- Standard generator terms
  S.toSHS.extendedGenerator ψ.toTestFunction q x t +
  -- Diffusion term: ½ Σ_i g_iᵀ H g_i
  (1 / 2) * ∑ i : Fin k,
    let gi := (S.g i q x t)
    let Hgi : EuclideanSpace ℝ (Fin n) :=
      (EuclideanSpace.equiv (Fin n) ℝ).symm (Matrix.mulVec (ψ.hessian_x q x t) (EuclideanSpace.equiv (Fin n) ℝ gi))
    @inner ℝ _ _ Hgi gi

/-
Symmetric second difference converges to the second derivative.
If `φ` has derivative `dφ` on a neighbourhood of `0` and `dφ` is differentiable
at `0` with derivative `c`, then `(φ h + φ (-h) - 2 φ 0)/h² → c` as `h → 0`
(with `h ≠ 0`). This is the one-dimensional Taylor fact behind the diffusion
generator limit.
-/
lemma Real.symmSecondDiff_tendsto (φ dφ : ℝ → ℝ) (c : ℝ)
    (h1 : ∀ᶠ s in nhds (0:ℝ), HasDerivAt φ (dφ s) s)
    (h2 : HasDerivAt dφ c 0) :
    Filter.Tendsto (fun h : ℝ => (φ h + φ (-h) - 2 * φ 0) / h ^ 2)
      (nhdsWithin (0:ℝ) {(0:ℝ)}ᶜ) (nhds c) := by
  -- Let $g(h) = \phi(h) + \phi(-h) - 2\phi(0)$.
  set g : ℝ → ℝ := fun h => φ h + φ (-h) - 2 * φ 0;
  -- By definition of $g$, we know that $g'(h) = dφ(h) - dφ(-h)$.
  have hg' : ∀ᶠ h in 𝓝 0, HasDerivAt g (dφ h - dφ (-h)) h := by
    rw [ Metric.eventually_nhds_iff ] at *;
    obtain ⟨ ε, ε_pos, hε ⟩ := h1; use ε, ε_pos; intro y hy; convert HasDerivAt.sub ( HasDerivAt.add ( hε hy ) ( HasDerivAt.comp y ( hε <| show Dist.dist ( -y ) 0 < ε from by simpa using hy ) <| hasDerivAt_neg y ) ) ( hasDerivAt_const _ _ ) using 1 ; ring;
  -- By definition of $g$, we know that $g'(h) / (2h) \to c$ as $h \to 0$.
  have hg'_div : Filter.Tendsto (fun h => (dφ h - dφ (-h)) / (2 * h)) (𝓝[≠] 0) (𝓝 c) := by
    have hg'_div : Filter.Tendsto (fun h => (dφ h - dφ 0) / h) (𝓝[≠] 0) (𝓝 c) ∧ Filter.Tendsto (fun h => (dφ (-h) - dφ 0) / (-h)) (𝓝[≠] 0) (𝓝 c) := by
      constructor;
      · simpa [ div_eq_inv_mul ] using h2.tendsto_slope_zero;
      · have := h2.tendsto_slope_zero;
        convert this.comp ( show Filter.Tendsto ( fun h : ℝ => -h ) ( 𝓝[≠] 0 ) ( 𝓝[≠] 0 ) from Filter.Tendsto.inf ( Continuous.tendsto' ( by continuity ) _ _ <| by norm_num ) <| by norm_num ) using 2 ; norm_num ; ring;
    convert hg'_div.1.add hg'_div.2 |> Filter.Tendsto.div_const <| 2 using 2 <;> ring;
  have hg_lhopital : ∀ᶠ h in 𝓝[≠] 0, HasDerivAt g (dφ h - dφ (-h)) h ∧ HasDerivAt (fun h => h ^ 2) (2 * h) h := by
    filter_upwards [ hg'.filter_mono nhdsWithin_le_nhds ] with h hh using ⟨ hh, by simpa using hasDerivAt_pow 2 h ⟩;
  have hg_lhopital : Filter.Tendsto (fun h => (g h - g 0) / (h ^ 2 - 0 ^ 2)) (𝓝[≠] 0) (𝓝 c) := by
    apply_rules [ HasDerivAt.lhopital_zero_nhdsNE ];
    · filter_upwards [ hg_lhopital ] with x hx using by simpa using hx.1.sub_const ( g 0 ) ;
    · filter_upwards [ hg_lhopital ] with x hx using by simpa using hx.2;
    · filter_upwards [ self_mem_nhdsWithin ] with x hx using mul_ne_zero two_ne_zero hx;
    · have hg_cont : ContinuousAt g 0 := by
        exact HasDerivAt.continuousAt ( hg'.self_of_nhds );
      exact tendsto_nhdsWithin_of_tendsto_nhds ( by simpa using hg_cont.tendsto.sub_const ( g 0 ) );
    · exact tendsto_nhdsWithin_of_tendsto_nhds ( Continuous.tendsto' ( by continuity ) _ _ <| by norm_num );
  grind +qlia

/-
**Proof of Eq. (14)** (Appendix).
The extended generator with diffusion (Eq. 14) is obtained as the limit
`ε ↓ 0` of the generator for the approximating SHS with resets
`x ↦ x ± √ε g_i(q,x,t)` occurring at rates `1/(2ε)`.
The Taylor expansion yields the second-order term.

Since `TestFunctionC2` only *carries* a Hessian field `hessian_x` without linking
it to actual derivatives of `toFun`, the limit is not determined by the data
alone. We therefore add faithful second-order regularity hypotheses `hd1`/`hd2`:
for each diffusion direction `g_i`, the one-parameter restriction
`s ↦ ψ(q, x + s·g_i, t)` has derivative `dψ i` near `0`, and `dψ i` is itself
differentiable at `0` with derivative equal to the quadratic form
`⟨(hessian_x) g_i, g_i⟩`. These encode that `hessian_x` is the genuine Hessian of
`toFun` in the directions `g_i`.
-/
theorem SHS.WithDiffusion.generator_limit
    {Q : Type*} [Fintype Q] {n m k : ℕ}
    (S : SHS.WithDiffusion Q n m k)
    (ψ : SHS.TestFunctionC2 Q n)
    (q : Q) (x : EuclideanSpace ℝ (Fin n)) (t : ℝ)
    (dψ : Fin k → ℝ → ℝ)
    (hd1 : ∀ i, ∀ᶠ s in nhds (0:ℝ),
      HasDerivAt (fun s => ψ.toFun q (x + s • S.g i q x t) t) (dψ i s) s)
    (hd2 : ∀ i, HasDerivAt (dψ i)
      (@inner ℝ _ _
        ((EuclideanSpace.equiv (Fin n) ℝ).symm
          (Matrix.mulVec (ψ.hessian_x q x t)
            (EuclideanSpace.equiv (Fin n) ℝ (S.g i q x t))))
        (S.g i q x t)) 0) :
    -- The finite-difference approximation converges to the diffusion term
    Filter.Tendsto
      (fun ε => ∑ i : Fin k,
        (ψ.toFun q (x + Real.sqrt ε • S.g i q x t) t +
         ψ.toFun q (x - Real.sqrt ε • S.g i q x t) t -
         2 * ψ.toFun q x t) / (2 * ε))
      (nhdsWithin 0 (Set.Ioi 0))
      (nhds (S.extendedGenerator ψ q x t -
             S.toSHS.extendedGenerator ψ.toTestFunction q x t)) := by
  have h_tendsto : ∀ i, Filter.Tendsto (fun ε => (ψ.toFun q (x + Real.sqrt ε • S.g i q x t) t + ψ.toFun q (x - Real.sqrt ε • S.g i q x t) t - 2 * ψ.toFun q x t) / (2 * ε)) (nhdsWithin 0 (Set.Ioi 0)) (nhds ((1 / 2) * (inner ℝ ((EuclideanSpace.equiv (Fin n) ℝ).symm ((ψ.hessian_x q x t).mulVec ((EuclideanSpace.equiv (Fin n) ℝ) (S.g i q x t)))) (S.g i q x t)))) := by
    intro i
    have := Real.symmSecondDiff_tendsto (fun s => ψ.toFun q (x + s • S.g i q x t) t) (dψ i) (inner ℝ ((EuclideanSpace.equiv (Fin n) ℝ).symm ((ψ.hessian_x q x t).mulVec ((EuclideanSpace.equiv (Fin n) ℝ) (S.g i q x t)))) (S.g i q x t)) (hd1 i) (hd2 i);
    convert Filter.Tendsto.const_mul ( 1 / 2 : ℝ ) ( this.comp ( show Filter.Tendsto ( fun ε : ℝ => Real.sqrt ε ) ( nhdsWithin 0 ( Set.Ioi 0 ) ) ( nhdsWithin 0 { 0 } ᶜ ) from ?_ ) ) using 2 ; norm_num ; ring;
    · by_cases h : 0 ≤ ‹ℝ› <;> simp_all +decide [ Real.sq_sqrt ] ; ring;
      · rw [ sub_eq_add_neg ] ; ring!;
      · norm_num [ Real.sqrt_eq_zero_of_nonpos h.le ] ; ring;
    · refine' Filter.Tendsto.inf _ _ <;> norm_num;
      · exact Continuous.tendsto' ( Real.continuous_sqrt ) _ _ ( by norm_num );
      · exact fun x hx => ne_of_gt <| Real.sqrt_pos.2 hx;
  convert tendsto_finset_sum Finset.univ fun i _ => h_tendsto i using 2 ; norm_num [ WithDiffusion.extendedGenerator ] ; ring!;
  rw [ Finset.sum_mul _ _ _ ]

/-! ## Section 3.2: Probability density / Fokker–Planck equation

When a joint probability density `ρ(q, x; t)` exists, Theorem 1 leads to a system
of PDEs for `ρ`. When the continuous reset maps are invertible, this becomes
a generalized Fokker–Planck / Kolmogorov forward equation.

For each `q₀ ∈ Q`:
  `∂ρ(q₀, x₀; t)/∂t = −div_x(f(q₀,x₀,t) ρ(q₀,x₀;t))
    + Σ_ℓ (−λ_ℓ(q₀,x₀,t) ρ(q₀,x₀;t)
    + Σ_{q ∈ Q_ℓ[x₀,t]} λ_ℓ(q, φ_ℓ^{−x}(q,x₀,t), t)
        ρ(q, φ_ℓ^{−x}(q,x₀);t) |det ∂φ_ℓ^{−x}(q,x₀,t)/∂z|)`

where `Q_ℓ[x₀, t] = {q ∈ Q : φ_ℓ^q(q, φ_ℓ^{−x}(q,x₀,t), t) = q₀}`.

References:
  - Hespanha (2005), Section 3.2, Eqs. (18)–(20)
  - Davis (1993), Chapter 3: the Kolmogorov forward equation for PDPs
-/

/-! ### 3.2.1 Core data for the Fokker–Planck equation -/

/-- The Fokker–Planck equation structure for an SHS with invertible continuous resets.

This bundles all the analytic data needed to state the Fokker–Planck PDE:
  - the joint probability density `ρ(q, x; t)`
  - the inverse of the continuous reset map `φ_ℓ^{−x}`
  - the Jacobian determinant of the inverse reset map
  - the divergence of the drift–density product `div_x(f · ρ)`
  - the time derivative `∂ρ/∂t` -/
structure SHS.FokkerPlanckData {Q : Type*} [Fintype Q] {n m : ℕ} (S : SHS Q n m) where
  /-- Joint probability density `ρ(q, x; t)` with respect to Lebesgue measure on `ℝⁿ`.
  We have `P(q(t) = q, x(t) ∈ A) = ∫_A ρ(q, x; t) dx` for measurable `A ⊆ ℝⁿ`. -/
  rho : Q → EuclideanSpace ℝ (Fin n) → ℝ → ℝ
  /-- The density is nonneg. -/
  rho_nonneg : ∀ q x t, 0 ≤ rho q x t
  /-- Inverse of the continuous reset map `φ_ℓ^{−x}(q, x₀, t)`.
  If `φ_ℓ^x(q, z, t) = x₀` then `z = φ_ℓ^{−x}(q, x₀, t)`. -/
  phi_inv_x : Fin m → Q → EuclideanSpace ℝ (Fin n) → ℝ → EuclideanSpace ℝ (Fin n)
  /-- Left inverse: `φ_ℓ^{−x}(q, φ_ℓ^x(q,x,t), t) = x`. -/
  is_left_inverse : ∀ ℓ q x t,
    phi_inv_x ℓ q (S.phi_x ℓ q x t) t = x
  /-- Right inverse: `φ_ℓ^x(q, φ_ℓ^{−x}(q,x₀,t), t) = x₀`. -/
  is_right_inverse : ∀ ℓ q x₀ t,
    S.phi_x ℓ q (phi_inv_x ℓ q x₀ t) t = x₀
  /-- Absolute value of the Jacobian determinant of the inverse reset map
  `|det(∂φ_ℓ^{−x}(q, x₀, t)/∂x₀)|`.
  This is the change-of-variables factor for the density. -/
  jacobian_det : Fin m → Q → EuclideanSpace ℝ (Fin n) → ℝ → ℝ
  /-- The Jacobian determinant is nonneg. -/
  jacobian_det_nonneg : ∀ ℓ q x t, 0 ≤ jacobian_det ℓ q x t
  /-- Divergence of the drift–density product:
  `div_x(f(q, x, t) · ρ(q, x; t)) = Σ_i ∂(f_i ρ)/∂x_i`. -/
  div_f_rho : Q → EuclideanSpace ℝ (Fin n) → ℝ → ℝ
  /-- Time derivative of the density: `∂ρ(q, x; t)/∂t`. -/
  partial_t_rho : Q → EuclideanSpace ℝ (Fin n) → ℝ → ℝ

/-! ### 3.2.2 Preimage set `Q_ℓ[x₀, t]` -/

/-- The preimage set `Q_ℓ[x₀, t, q₀]` (denoted `Q_ℓ[x₀, t]` in the paper).

Given a target discrete state `q₀` and a target continuous state `x₀`,
this is the set of source discrete states `q` such that the `ℓ`-th reset map
sends `(q, φ_ℓ^{−x}(q, x₀, t))` to discrete state `q₀`:

  `Q_ℓ[x₀, t, q₀] = { q ∈ Q | φ_ℓ^q(q, φ_ℓ^{−x}(q, x₀, t), t) = q₀ }` -/
def SHS.FokkerPlanckData.preimageDiscreteStates
    {Q : Type*} [Fintype Q] [DecidableEq Q] {n m : ℕ} {S : SHS Q n m}
    (fp : S.FokkerPlanckData)
    (ℓ : Fin m) (q₀ : Q) (x₀ : EuclideanSpace ℝ (Fin n)) (t : ℝ) : Finset Q :=
  Finset.univ.filter fun q =>
    S.phi_q ℓ q (fp.phi_inv_x ℓ q x₀ t) t = q₀

/-! ### 3.2.3 The Fokker–Planck operator (RHS of the PDE) -/

/-- The reset source term for transition `ℓ` at target state `(q₀, x₀)` (Eq. 18, second line).

For each source state `q` in `Q_ℓ[x₀, t, q₀]`, the contribution is:
  `λ_ℓ(q, φ_ℓ^{−x}(q, x₀, t), t) · ρ(q, φ_ℓ^{−x}(q, x₀, t); t) · |det ∂φ_ℓ^{−x}/∂x₀|`

This represents the probability flux entering `(q₀, x₀)` via the `ℓ`-th transition. -/
def SHS.FokkerPlanckData.resetSourceTerm
    {Q : Type*} [Fintype Q] [DecidableEq Q] {n m : ℕ} {S : SHS Q n m}
    (fp : S.FokkerPlanckData)
    (ℓ : Fin m) (q₀ : Q) (x₀ : EuclideanSpace ℝ (Fin n)) (t : ℝ) : ℝ :=
  ∑ q ∈ fp.preimageDiscreteStates ℓ q₀ x₀ t,
    S.intensity ℓ q (fp.phi_inv_x ℓ q x₀ t) t *
    fp.rho q (fp.phi_inv_x ℓ q x₀ t) t *
    fp.jacobian_det ℓ q x₀ t

/-- The reset drain term for transition `ℓ` at state `(q₀, x₀)` (Eq. 18, first summand).

This represents the probability flux leaving `(q₀, x₀)` via the `ℓ`-th transition:
  `−λ_ℓ(q₀, x₀, t) · ρ(q₀, x₀; t)` -/
def SHS.FokkerPlanckData.resetDrainTerm
    {Q : Type*} [Fintype Q] {n m : ℕ} {S : SHS Q n m}
    (fp : S.FokkerPlanckData)
    (ℓ : Fin m) (q₀ : Q) (x₀ : EuclideanSpace ℝ (Fin n)) (t : ℝ) : ℝ :=
  - S.intensity ℓ q₀ x₀ t * fp.rho q₀ x₀ t

/-- The full Fokker–Planck operator / RHS of the Fokker–Planck PDE (Eq. 18).

For a given mode `q₀`, continuous state `x₀`, and time `t`, the RHS is:

  `FP(q₀, x₀, t) = −div_x(f(q₀,x₀,t) ρ(q₀,x₀;t))
    + Σ_ℓ [ −λ_ℓ(q₀,x₀,t) ρ(q₀,x₀;t)
           + Σ_{q ∈ Q_ℓ[x₀,t,q₀]} λ_ℓ(q, z_ℓ, t) ρ(q, z_ℓ; t) |det J_ℓ| ]`

where `z_ℓ = φ_ℓ^{−x}(q, x₀, t)` and `J_ℓ = ∂φ_ℓ^{−x}/∂x₀`. -/
def SHS.FokkerPlanckData.fokkerPlanckRHS
    {Q : Type*} [Fintype Q] [DecidableEq Q] {n m : ℕ} {S : SHS Q n m}
    (fp : S.FokkerPlanckData)
    (q₀ : Q) (x₀ : EuclideanSpace ℝ (Fin n)) (t : ℝ) : ℝ :=
  -- Transport term: −div_x(f · ρ)
  - fp.div_f_rho q₀ x₀ t +
  -- Transition terms: Σ_ℓ (drain + source)
  ∑ ℓ : Fin m,
    (fp.resetDrainTerm ℓ q₀ x₀ t + fp.resetSourceTerm ℓ q₀ x₀ t)

/-! ### 3.2.4 The Fokker–Planck PDE (Eq. 18) -/

/-- **The Fokker–Planck PDE** (Hespanha 2005, Eq. 18).

A `FokkerPlanckData` satisfies the Fokker–Planck equation when the time
derivative of the density equals the Fokker–Planck operator:

  `∂ρ(q₀, x₀; t)/∂t = −div_x(f ρ)(q₀,x₀,t)
    + Σ_ℓ [ −λ_ℓ ρ + Σ_{q∈Q_ℓ} λ_ℓ(q, φ_ℓ^{−x}(…)) ρ(q, φ_ℓ^{−x}(…)) |det J_ℓ| ]`

for all `q₀ ∈ Q`, `x₀ ∈ ℝⁿ`, `t > t₀`. -/
def SHS.FokkerPlanckData.SatisfiesFPE
    {Q : Type*} [Fintype Q] [DecidableEq Q] {n m : ℕ} {S : SHS Q n m}
    (fp : S.FokkerPlanckData) : Prop :=
  ∀ (q₀ : Q) (x₀ : EuclideanSpace ℝ (Fin n)) (t : ℝ),
    fp.partial_t_rho q₀ x₀ t = fp.fokkerPlanckRHS q₀ x₀ t

/-! ### 3.2.5 Derivation of FPE from the generator formula (Theorem 1 → Eq. 18)

The Fokker–Planck equation is derived from the generator formula (Eq. 10):
  `d/dt E[ψ(q(t), x(t), t)] = E[(Lψ)(q(t), x(t), t)]`

by expressing expectations as integrals against `ρ`, then choosing test functions
`ψ` independent of `t` and using integration by parts to move derivatives from
`ψ` to `ρ`. The density-PDE equivalence requires that the identity
  `∫ ψ ∂ρ/∂t dx = ∫ ψ FP(ρ) dx`
holds for all smooth compactly supported test functions `ψ`, which by the
fundamental lemma of the calculus of variations implies `∂ρ/∂t = FP(ρ)` a.e.
-/

/-
PROBLEM
**Weak form of the generator identity in density form** (Eq. 19).

If a density `ρ` represents the law of the SHS and `ψ` is a smooth,
compactly-supported test function independent of `t`, then the generator
formula (Eq. 10) reads:

  `d/dt Σ_q ∫ ψ(q,x) ρ(q,x;t) dx = Σ_q ∫ (Lψ)(q,x,t) ρ(q,x;t) dx`

After integration by parts (moving `∂/∂x` from `ψ` to `f·ρ`) and the
change-of-variable formula (for the reset integrals), this becomes:

  `Σ_q ∫ ψ(q,x) [∂ρ/∂t](q,x;t) dx = Σ_q ∫ ψ(q,x) FP(ρ)(q,x;t) dx`

for all such test functions `ψ`.

PROVIDED SOLUTION
Since hfpe says partial_t_rho q₀ x₀ t = fokkerPlanckRHS q₀ x₀ t for all q₀ x₀ t, we can rewrite partial_t_rho to fokkerPlanckRHS using congr_arg under the integral and sum. Use `simp only [hfpe q x t]` or `congr 1; ext q; congr 1; ext x; rw [hfpe q x t]` to rewrite.
-/
theorem SHS.fokkerPlanck_weak_form
    {Q : Type*} [Fintype Q] [DecidableEq Q] [MeasurableSpace Q]
    {n m : ℕ} (S : SHS Q n m)
    (fp : S.FokkerPlanckData)
    (hfpe : fp.SatisfiesFPE)
    -- A time-independent test function ψ(q, x) with compact support
    (test : Q → EuclideanSpace ℝ (Fin n) → ℝ)
    (t : ℝ) :
    -- LHS: ∂/∂t Σ_q ∫ ψ(q,x) ρ(q,x;t) dx
    ∑ q : Q, ∫ x, test q x * fp.partial_t_rho q x t =
    -- RHS: Σ_q ∫ ψ(q,x) FP(ρ)(q,x;t) dx
    ∑ q : Q, ∫ x, test q x * fp.fokkerPlanckRHS q x t := by
  unfold SHS.FokkerPlanckData.SatisfiesFPE at hfpe; aesop;

/-
PROBLEM
**Derivation of the Fokker–Planck PDE from the generator (Theorem 1)**.

If `ρ` is a density satisfying the generator identity (Eq. 10) for *all*
smooth compactly-supported test functions, then the Fokker–Planck PDE
holds almost everywhere.

This is the formal statement of the argument in Section 3.2 of Hespanha (2005):
Theorem 1 (Eq. 10) + integration by parts + fundamental lemma of calculus
of variations ⟹ Eq. (18).

PROVIDED SOLUTION
Unfold SatisfiesFPE, introduce q₀ x₀ t. Let g(x) = partial_t_rho q₀ x t - fokkerPlanckRHS q₀ x t. We have:
- hweak: for all h, ∫ h(x) g(x) = 0
- hreg: g is continuous

We need g(x₀) = 0 (i.e. sub_eq_zero.mpr).

By_contra, assume g(x₀) ≠ 0. By continuity, WLOG g > 0 on a ball B(x₀, ε). Take h = indicator of B(x₀, ε). Then ∫ h * g = ∫_{B(x₀,ε)} g > 0 (positive continuous function on a ball has positive integral, use integral_pos_of_pos_of_support). This contradicts hweak.

Key Mathlib lemmas to use:
- `Metric.continuousAt_iff` or `ContinuousAt.eventually` to find ε
- `MeasureTheory.integral_pos_of_pos_of_support` or `setIntegral_pos_of_pos_of_ne_zero` for the positive integral
- `Metric.measure_ball_pos` for the measure of the ball being positive
-/
theorem SHS.fokkerPlanck_from_generator
    {Q : Type*} [Fintype Q] [DecidableEq Q] [MeasurableSpace Q]
    {n m : ℕ} (S : SHS Q n m)
    (fp : S.FokkerPlanckData)
    -- Pointwise weak-form identity: for each q and t, ∫ h(x) g(q,x,t) dx = 0
    -- for all test functions h, where g = ∂ρ/∂t − FP(ρ)
    (hweak : ∀ (q₀ : Q) (t : ℝ) (h : EuclideanSpace ℝ (Fin n) → ℝ),
      ∫ x, h x * (fp.partial_t_rho q₀ x t - fp.fokkerPlanckRHS q₀ x t) = 0)
    -- Regularity: the difference ∂ρ/∂t − FP(ρ) is continuous in x for each q, t
    (hreg : ∀ q₀ t, Continuous (fun x : EuclideanSpace ℝ (Fin n) =>
      fp.partial_t_rho q₀ x t - fp.fokkerPlanckRHS q₀ x t)) :
    fp.SatisfiesFPE := by
  contrapose! hweak; simp_all +decide [ MeasureTheory.integral_const_mul, MeasureTheory.integral_mul_const ] ;
  -- Since `SatisfiesFPE` is equivalent to `partial_t_rho = fokkerPlanckRHS`, and `hweak` implies `partial_t_rho ≠ fokkerPlanckRHS`, we can choose `q₀`, `t`, and `x₀` such that `partial_t_rho q₀ x₀ t ≠ fokkerPlanckRHS q₀ x₀ t`.
  obtain ⟨q₀, t, x₀, hx₀⟩ : ∃ q₀ : Q, ∃ t : ℝ, ∃ x₀ : (EuclideanSpace ℝ (Fin n)), fp.partial_t_rho q₀ x₀ t ≠ fp.fokkerPlanckRHS q₀ x₀ t := by
    unfold SHS.FokkerPlanckData.SatisfiesFPE at hweak; contrapose! hweak; aesop;
  -- By continuity of $g(x) = \partial_t \rho(q_0, x, t) - \rho_{\text{fokkerPlanckRHS}}(q_0, x, t)$, there exists an open ball $B(x_0, \epsilon)$ where $g(x) > 0$.
  obtain ⟨ε, hε_pos, hε⟩ : ∃ ε > 0, ∀ x, dist x x₀ < ε → (fp.partial_t_rho q₀ x t - fp.fokkerPlanckRHS q₀ x t) * (fp.partial_t_rho q₀ x₀ t - fp.fokkerPlanckRHS q₀ x₀ t) > 0 := by
    have := Metric.continuous_iff.mp ( hreg q₀ t ) x₀;
    exact Exists.elim ( this ( |fp.partial_t_rho q₀ x₀ t - fp.fokkerPlanckRHS q₀ x₀ t| ) ( abs_pos.mpr ( sub_ne_zero.mpr hx₀ ) ) ) fun δ hδ => ⟨ δ, hδ.1, fun x hx => by cases abs_cases ( fp.partial_t_rho q₀ x₀ t - fp.fokkerPlanckRHS q₀ x₀ t ) <;> nlinarith [ abs_lt.mp ( hδ.2 x hx ) ] ⟩;
  refine' ⟨ q₀, t, fun x => if dist x x₀ < ε then ( fp.partial_t_rho q₀ x₀ t - fp.fokkerPlanckRHS q₀ x₀ t ) else 0, _ ⟩ ; simp_all +decide [ mul_comm ] ; (
  rw [ MeasureTheory.integral_congr_ae, MeasureTheory.integral_indicator ];
  change ¬∫ x in Metric.ball x₀ ε, ( fp.partial_t_rho q₀ x₀ t - fp.fokkerPlanckRHS q₀ x₀ t ) * ( fp.partial_t_rho q₀ x t - fp.fokkerPlanckRHS q₀ x t ) = 0;
  · rw [ MeasureTheory.integral_eq_zero_iff_of_nonneg_ae ];
    · rw [ Filter.EventuallyEq, MeasureTheory.ae_restrict_iff' ] <;> norm_num [ hε_pos ];
      · refine' fun h => _;
        rw [ MeasureTheory.ae_iff ] at h; simp_all +decide [ sub_eq_iff_eq_add ] ;
        exact absurd h ( ne_of_gt ( lt_of_lt_of_le ( by simpa using ( Metric.measure_ball_pos _ _ hε_pos ) ) ( MeasureTheory.measure_mono ( show { a : EuclideanSpace ℝ ( Fin n ) | dist a x₀ < ε ∧ ¬fp.partial_t_rho q₀ a t = fp.fokkerPlanckRHS q₀ a t } ⊇ Metric.ball x₀ ε from fun x hx => ⟨ hx, by intro H; specialize hε x hx; simp_all +decide [ sub_eq_iff_eq_add ] ⟩ ) ) ) );
      · exact measurableSet_ball;
    · filter_upwards [ MeasureTheory.ae_restrict_mem measurableSet_ball ] with x hx using le_of_lt ( hε x hx );
    · exact ContinuousOn.integrableOn_compact ( ProperSpace.isCompact_closedBall x₀ ε ) ( by exact ContinuousOn.mul continuousOn_const ( hreg q₀ t |> Continuous.continuousOn ) ) |> fun h => h.mono_set ( Metric.ball_subset_closedBall );
  · exact measurableSet_ball;
  · filter_upwards [ ] with x using by simp +decide [ Set.indicator ] ;);

/-! ### 3.2.6 Conservation of total probability

A solution to the Fokker–Planck equation conserves the total probability mass:

  `d/dt Σ_q ∫_{ℝⁿ} ρ(q, x; t) dx = 0`

This follows by choosing `ψ ≡ 1` in the weak form (Eq. 19), which makes
all gradient and reset terms vanish by telescoping. Alternatively, it
follows from `E[1] = 1` in Eq. (10).
-/

/-- The total probability mass at time `t`. -/
def SHS.FokkerPlanckData.totalMass
    {Q : Type*} [Fintype Q] {n m : ℕ} {S : SHS Q n m}
    (fp : S.FokkerPlanckData) (t : ℝ) : ℝ :=
  ∑ q : Q, ∫ x, fp.rho q x t

/-
PROBLEM
**Conservation of total probability** (Hespanha 2005, Eq. 20).

If `ρ` satisfies the Fokker–Planck equation (Eq. 18), then the total
probability mass is conserved. Formally:

  `Σ_q ∫ ∂ρ/∂t(q, x; t) dx = 0`

for all `t`, which implies `d/dt (Σ_q ∫ ρ dx) = 0`.

**Proof sketch:** Set `ψ ≡ 1` in the generator formula (Eq. 10).
Then `Lψ = 0` because:
  - `∂ψ/∂x = 0`, so the drift term vanishes,
  - `∂ψ/∂t = 0`,
  - `ψ(φ_ℓ(…)) − ψ(…) = 1 − 1 = 0` for each `ℓ`.
Hence `d/dt E[1] = E[0] = 0`, so `Σ_q ∫ ∂ρ/∂t dx = 0`.

Equivalently, in the PDE picture: integrate Eq. (18) over `x ∈ ℝⁿ`
and sum over `q ∈ Q`. The divergence term vanishes by the divergence
theorem (density decays at infinity). The reset terms telescope:
for each `ℓ`, the total drain equals the total source by the
change-of-variables formula.

PROVIDED SOLUTION
Step 1: simp_rw [hfpe] to replace partial_t_rho q₀ x₀ t with fokkerPlanckRHS q₀ x₀ t.

Step 2: Unfold fokkerPlanckRHS. The integrand becomes:
  -div_f_rho q x t + Σ_ℓ (resetDrainTerm ℓ q x t + resetSourceTerm ℓ q x t)

Step 3: Use integral_add and integral_neg to split:
  Σ_q [∫ -div_f_rho + Σ_q Σ_ℓ ∫ (resetDrainTerm + resetSourceTerm)]

Step 4: By hdiv_vanish, Σ_q ∫ -div_f_rho = -Σ_q 0 = 0.

Step 5: Unfold resetDrainTerm: it is -λ_ℓ * ρ. So Σ_q ∫ resetDrainTerm ℓ = -Σ_q ∫ λ_ℓ ρ.

Step 6: By hcov, Σ_q ∫ resetSourceTerm ℓ = Σ_q ∫ λ_ℓ ρ.

Step 7: So for each ℓ, the drain and source cancel. Total = 0.

Use simp [fokkerPlanckRHS, resetDrainTerm] to unfold, then use integral_add with the integrability hypotheses hint_div, hint_drain, hint_source. Use Finset.sum_comm to swap q and ℓ sums.
-/
theorem SHS.fokkerPlanck_conserves_mass
    {Q : Type*} [Fintype Q] [DecidableEq Q] {n m : ℕ} {S : SHS Q n m}
    (fp : S.FokkerPlanckData)
    (hfpe : fp.SatisfiesFPE)
    -- Regularity: divergence integrates to zero (density vanishes at ∞)
    (hdiv_vanish : ∀ q t, ∫ x, fp.div_f_rho q x t = 0)
    -- Change of variables: total source = total drain for each ℓ
    (hcov : ∀ (ℓ : Fin m) (t : ℝ),
      ∑ q₀ : Q, ∫ x₀, fp.resetSourceTerm ℓ q₀ x₀ t =
      ∑ q₀ : Q, ∫ x₀, S.intensity ℓ q₀ x₀ t * fp.rho q₀ x₀ t)
    (t : ℝ)
    -- Integrability of the FPE RHS components
    (hint_div : ∀ q, Integrable (fun x => fp.div_f_rho q x t))
    (hint_drain : ∀ q ℓ, Integrable (fun x => fp.resetDrainTerm ℓ q x t))
    (hint_source : ∀ q ℓ, Integrable (fun x => fp.resetSourceTerm ℓ q x t)) :
    ∑ q : Q, ∫ x, fp.partial_t_rho q x t = 0 := by
  have := hfpe;
  have := @this;
  rw [ Finset.sum_congr rfl fun q _ => MeasureTheory.integral_congr_ae <| Filter.Eventually.of_forall fun x => this q x t ];
  unfold SHS.FokkerPlanckData.fokkerPlanckRHS at *;
  rw [ Finset.sum_congr rfl fun q _ => MeasureTheory.integral_add ?_ ?_ ];
  · simp_all +decide [ MeasureTheory.integral_neg, MeasureTheory.integral_finset_sum ];
    rw [ Finset.sum_comm ];
    rw [ Finset.sum_eq_zero ] ; intros ; rw [ Finset.sum_congr rfl fun _ _ => MeasureTheory.integral_add ( by aesop ) ( by aesop ) ] ; simp_all +decide [ MeasureTheory.integral_neg, MeasureTheory.integral_const_mul ];
    simp_all +decide [ Finset.sum_add_distrib, SHS.FokkerPlanckData.resetDrainTerm ];
    simp +decide [ MeasureTheory.integral_neg, Finset.sum_neg_distrib ];
  · exact MeasureTheory.Integrable.neg ( ‹∀ q, Integrable ( fun x => fp.div_f_rho q x t ) volume› q );
  · exact MeasureTheory.integrable_finset_sum _ fun ℓ _ => MeasureTheory.Integrable.add ( ‹∀ q ℓ, MeasureTheory.Integrable ( fun x => fp.resetDrainTerm ℓ q x t ) volume› q ℓ ) ( ‹∀ q ℓ, MeasureTheory.Integrable ( fun x => fp.resetSourceTerm ℓ q x t ) volume› q ℓ )

/-
PROBLEM
**Total probability is unity** (corollary of conservation).

If the density integrates to `1` at the initial time and the FPE holds,
then total mass is `1` for all `t`. This requires the additional regularity
that `totalMass` is a differentiable function of `t` with derivative given
by interchanging `d/dt` and `∫`.

PROVIDED SOLUTION
By fokkerPlanck_conserves_mass (with the given hypotheses), we have Σ_q ∫ partial_t_rho q x t₁ dx = 0 for all t₁. Combined with hderiv (which says HasDerivAt totalMass (Σ_q ∫ partial_t_rho q x t₁) t₁), this means HasDerivAt totalMass 0 t₁ for all t₁. A function with derivative 0 everywhere is constant. Since totalMass t₀ = 1, totalMass t = 1. Use `is_const_of_deriv_eq_zero` or similar.

By fokkerPlanck_conserves_mass (applied with hint_div t₁, hint_drain · · t₁, hint_source · · t₁), the derivative of totalMass is 0 everywhere. Since totalMass is differentiable (from hderiv), it must be constant. As totalMass t₀ = 1, totalMass t = 1.

Use:
1. have h_zero : ∀ t₁, Σ_q ∫ partial_t_rho q x t₁ = 0 := fun t₁ => fokkerPlanck_conserves_mass fp hfpe hdiv_vanish hcov t₁ (hint_div · t₁) (fun q ℓ => hint_drain q ℓ t₁) (fun q ℓ => hint_source q ℓ t₁)
2. have h_deriv_zero : ∀ t₁, deriv totalMass t₁ = 0 (from hderiv and h_zero)
3. is_const_of_deriv_eq_zero to conclude totalMass is constant
-/
theorem SHS.fokkerPlanck_total_mass_one
    {Q : Type*} [Fintype Q] [DecidableEq Q] {n m : ℕ} {S : SHS Q n m}
    (fp : S.FokkerPlanckData)
    (hfpe : fp.SatisfiesFPE)
    (hdiv_vanish : ∀ q t, ∫ x, fp.div_f_rho q x t = 0)
    (hcov : ∀ (ℓ : Fin m) (t : ℝ),
      ∑ q₀ : Q, ∫ x₀, fp.resetSourceTerm ℓ q₀ x₀ t =
      ∑ q₀ : Q, ∫ x₀, S.intensity ℓ q₀ x₀ t * fp.rho q₀ x₀ t)
    -- Integrability of the FPE RHS components (for all times)
    (hint_div : ∀ q t, Integrable (fun x => fp.div_f_rho q x t))
    (hint_drain : ∀ q ℓ t, Integrable (fun x => fp.resetDrainTerm ℓ q x t))
    (hint_source : ∀ q ℓ t, Integrable (fun x => fp.resetSourceTerm ℓ q x t))
    -- Total mass is differentiable and its derivative equals ∫ ∂ρ/∂t
    (hderiv : ∀ t₀, HasDerivAt fp.totalMass
      (∑ q : Q, ∫ x, fp.partial_t_rho q x t₀) t₀)
    -- Initial condition: total mass is 1 at time t₀
    (t₀ : ℝ) (hinit : fp.totalMass t₀ = 1)
    (t : ℝ) :
    fp.totalMass t = 1 := by
  -- By combining the results from hderiv and fokkerPlanck_conserves_mass, we can conclude that the total mass is constant.
  have h_const : ∀ t, deriv fp.totalMass t = 0 := by
    intro t
    have := hderiv t
    have := this.deriv
    simp_all +decide [ hderiv, hfpe, hdiv_vanish, hcov, hint_div, hint_drain, hint_source ];
    convert SHS.fokkerPlanck_conserves_mass fp hfpe hdiv_vanish hcov t ( fun q => ?_ ) ( fun q ℓ => ?_ ) ( fun q ℓ => ?_ ) using 1 <;> tauto;
  exact is_const_of_deriv_eq_zero ( fun t => ( hderiv t |> HasDerivAt.differentiableAt ) ) h_const t t₀ ▸ hinit ▸ rfl

/-! ### 3.2.7 Fokker–Planck with diffusion (SHS with Brownian motion)

When the SHS has diffusion `ẋ = f + Σ_i g_i ẇ_i` (Eq. 13), the Fokker–Planck
equation acquires a second-order diffusion term:

  `∂ρ/∂t = −div_x(f ρ) + ½ Σ_{i,j} ∂²(D_{ij} ρ)/∂x_i ∂x_j
           + Σ_ℓ [−λ_ℓ ρ + source terms]`

where `D = Σ_i g_i g_iᵀ` is the diffusion matrix.
-/

/-- The diffusion matrix `D(q, x, t) = Σ_i g_i(q,x,t) g_i(q,x,t)ᵀ`. -/
def SHS.WithDiffusion.diffusionMatrix {Q : Type*} {n m k : ℕ}
    (S : SHS.WithDiffusion Q n m k)
    (q : Q) (x : EuclideanSpace ℝ (Fin n)) (t : ℝ) : Matrix (Fin n) (Fin n) ℝ :=
  ∑ i : Fin k,
    let gi := EuclideanSpace.equiv (Fin n) ℝ (S.g i q x t)
    Matrix.of (fun a b => gi a * gi b)

/-- Fokker–Planck data for an SHS with diffusion, extending the base structure
with the second-order diffusion divergence term. -/
structure SHS.WithDiffusion.FPDataDiffusion
    {Q : Type*} [Fintype Q] {n m k : ℕ}
    (S : SHS.WithDiffusion Q n m k) extends SHS.FokkerPlanckData S.toSHS where
  /-- The second-order diffusion term:
  `½ Σ_{i,j} ∂²(D_{ij}(q,x,t) ρ(q,x;t)) / ∂x_i ∂x_j`
  where `D = Σ_i g_i g_iᵀ`. -/
  diffusion_div2 : Q → EuclideanSpace ℝ (Fin n) → ℝ → ℝ

/-- The Fokker–Planck operator for an SHS with diffusion.

Adds the second-order term `½ Σ_{i,j} ∂²(D_{ij} ρ)/∂x_i ∂x_j` to the
base Fokker–Planck RHS:

  `FP_diff(q₀,x₀,t) = −div_x(f ρ) + ½ div²(D ρ) + Σ_ℓ (drain + source)` -/
def SHS.WithDiffusion.FPDataDiffusion.fokkerPlanckDiffusionRHS
    {Q : Type*} [Fintype Q] [DecidableEq Q] {n m k : ℕ}
    {S : SHS.WithDiffusion Q n m k}
    (fp : S.FPDataDiffusion)
    (q₀ : Q) (x₀ : EuclideanSpace ℝ (Fin n)) (t : ℝ) : ℝ :=
  fp.toFokkerPlanckData.fokkerPlanckRHS q₀ x₀ t + fp.diffusion_div2 q₀ x₀ t

/-- **Fokker–Planck PDE with diffusion** (Hespanha 2005, combining Eqs. 14 & 18).

  `∂ρ/∂t = −div_x(f ρ) + ½ Σ_{i,j} ∂²(D_{ij} ρ)/∂x_i ∂x_j
           + Σ_ℓ [−λ_ℓ ρ + source terms]` -/
def SHS.WithDiffusion.FPDataDiffusion.SatisfiesFPEDiffusion
    {Q : Type*} [Fintype Q] [DecidableEq Q] {n m k : ℕ}
    {S : SHS.WithDiffusion Q n m k}
    (fp : S.FPDataDiffusion) : Prop :=
  ∀ (q₀ : Q) (x₀ : EuclideanSpace ℝ (Fin n)) (t : ℝ),
    fp.partial_t_rho q₀ x₀ t = fp.fokkerPlanckDiffusionRHS q₀ x₀ t

/-! ### 3.2.8 Consistency: generator ↔ Fokker–Planck

The Fokker–Planck equation and the generator formula are dual to each other.
The generator acts on test functions (backward/adjoint equation), while
Fokker–Planck acts on densities (forward equation). Their consistency is:

  `∫ (Lψ)(q,x,t) ρ(q,x;t) dx = ∫ ψ(q,x) FP(ρ)(q,x;t) dx`

for all smooth compactly-supported `ψ`. This is the integration-by-parts
identity that relates Eq. (9) to Eq. (18).
-/

/-
Helper: the reset part of the LHS equals the reset part of the RHS.
Specifically, the sum of transition integrals (summed over modes and transitions)
matches the integral of the drain + source terms.
-/
theorem SHS.generator_fokkerPlanck_duality_reset_part
    {Q : Type*} [Fintype Q] [DecidableEq Q] [MeasurableSpace Q]
    {n m : ℕ} (S : SHS Q n m)
    (fp : S.FokkerPlanckData)
    (test : Q → EuclideanSpace ℝ (Fin n) → ℝ)
    (hcov_reset : ∀ (ℓ : Fin m) (t : ℝ),
      ∑ q : Q, ∫ x, test (S.phi_q ℓ q x t) (S.phi_x ℓ q x t) *
            S.intensity ℓ q x t * fp.rho q x t =
      ∑ q₀ : Q, ∫ x₀, test q₀ x₀ * fp.resetSourceTerm ℓ q₀ x₀ t)
    (t : ℝ)
    (hint_reset : ∀ q ℓ, Integrable (fun x =>
      (test (S.phi_q ℓ q x t) (S.phi_x ℓ q x t) - test q x) *
           S.intensity ℓ q x t * fp.rho q x t))
    (hint_test_intensity : ∀ q ℓ, Integrable (fun x =>
      test q x * S.intensity ℓ q x t * fp.rho q x t))
    (hint_test_source : ∀ q ℓ, Integrable (fun x =>
      test q x * fp.resetSourceTerm ℓ q x t)) :
    ∑ ℓ : Fin m, ∑ q : Q, ∫ x,
      (test (S.phi_q ℓ q x t) (S.phi_x ℓ q x t) - test q x) *
        S.intensity ℓ q x t * fp.rho q x t =
    ∑ ℓ : Fin m, ∑ q : Q, ∫ x,
      test q x * (fp.resetDrainTerm ℓ q x t + fp.resetSourceTerm ℓ q x t) := by
  refine' Finset.sum_congr rfl fun ℓ _ => _;
  convert congr_arg₂ ( · - · ) ( hcov_reset ℓ t ) ( Finset.sum_congr rfl fun q _ => rfl ) using 1;
  rw [ ← Finset.sum_sub_distrib ];
  rotate_left;
  use fun q => ∫ x, test q x * S.intensity ℓ q x t * fp.rho q x t;
  · rw [ ← Finset.sum_sub_distrib ];
    refine' Finset.sum_congr rfl fun q _ => _;
    rw [ ← MeasureTheory.integral_sub ] ; congr ; ext ; ring;
    · rw [ SHS.FokkerPlanckData.resetDrainTerm ] ; ring;
    · exact hint_test_source q ℓ;
    · exact hint_test_intensity q ℓ;
  · refine' Finset.sum_congr rfl fun q _ => _;
    rw [ ← MeasureTheory.integral_sub ] ; congr ; ext ; ring;
    · convert hint_reset q ℓ |> fun h => h.add ( hint_test_intensity q ℓ ) using 1 ; ext ; ring;
      simp +decide [ sub_add_cancel ];
    · exact hint_test_intensity q ℓ

/-
**Generator–FPE duality** (integration-by-parts identity).

For a smooth test function `ψ(q, x)` (independent of `t`) and a density `ρ`
satisfying appropriate regularity:

  `Σ_q ∫ (Lψ)(q,x,t) ρ(q,x;t) dx = Σ_q ∫ ψ(q,x) FP(ρ)(q,x;t) dx`

where `L` is the extended generator (Eq. 9) and `FP` is the Fokker–Planck
operator (Eq. 18).

This is the fundamental self-adjointness / duality relation between the
backward (generator) and forward (Fokker–Planck) equations.
-/
theorem SHS.generator_fokkerPlanck_duality
    {Q : Type*} [Fintype Q] [DecidableEq Q] [MeasurableSpace Q]
    {n m : ℕ} (S : SHS Q n m)
    (fp : S.FokkerPlanckData)
    -- A time-independent test function ψ(q, x)
    (test : Q → EuclideanSpace ℝ (Fin n) → ℝ)
    (grad_test : Q → EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n))
    -- Integration by parts: ∫ (∇ψ · f) ρ dx = −∫ ψ div(f ρ) dx
    (hibp : ∀ q t,
      ∫ x, @inner ℝ _ _ (grad_test q x) (S.f q x t) * fp.rho q x t =
      - ∫ x, test q x * fp.div_f_rho q x t)
    -- Change of variables for reset integrals (summed over source states)
    (hcov_reset : ∀ (ℓ : Fin m) (t : ℝ),
      ∑ q : Q, ∫ x, test (S.phi_q ℓ q x t) (S.phi_x ℓ q x t) *
            S.intensity ℓ q x t * fp.rho q x t =
      ∑ q₀ : Q, ∫ x₀, test q₀ x₀ * fp.resetSourceTerm ℓ q₀ x₀ t)
    (t : ℝ)
    -- Integrability hypotheses
    (hint_gen : ∀ q, Integrable (fun x =>
      @inner ℝ _ _ (grad_test q x) (S.f q x t) * fp.rho q x t))
    (hint_reset : ∀ q ℓ, Integrable (fun x =>
      (test (S.phi_q ℓ q x t) (S.phi_x ℓ q x t) - test q x) *
           S.intensity ℓ q x t * fp.rho q x t))
    (hint_test_intensity : ∀ q ℓ, Integrable (fun x =>
      test q x * S.intensity ℓ q x t * fp.rho q x t))
    (hint_test_source : ∀ q ℓ, Integrable (fun x =>
      test q x * fp.resetSourceTerm ℓ q x t))
    (hint_test_div : ∀ q, Integrable (fun x =>
      test q x * fp.div_f_rho q x t)) :
    -- The duality identity
    ∑ q : Q, ∫ x,
      (@inner ℝ _ _ (grad_test q x) (S.f q x t) +
       ∑ ℓ : Fin m,
         (test (S.phi_q ℓ q x t) (S.phi_x ℓ q x t) - test q x) *
           S.intensity ℓ q x t) * fp.rho q x t =
    ∑ q : Q, ∫ x, test q x * fp.fokkerPlanckRHS q x t := by
  have h_lhs : ∑ q, ∫ x, (inner ℝ (grad_test q x) (S.f q x t) + ∑ ℓ, (test (S.phi_q ℓ q x t) (S.phi_x ℓ q x t) - test q x) * S.intensity ℓ q x t) * fp.rho q x t = ∑ q, (∫ x, inner ℝ (grad_test q x) (S.f q x t) * fp.rho q x t) + ∑ ℓ, ∑ q, ∫ x, (test (S.phi_q ℓ q x t) (S.phi_x ℓ q x t) - test q x) * S.intensity ℓ q x t * fp.rho q x t := by
    have h_lhs : ∀ q, ∫ x, (inner ℝ (grad_test q x) (S.f q x t) + ∑ ℓ, (test (S.phi_q ℓ q x t) (S.phi_x ℓ q x t) - test q x) * S.intensity ℓ q x t) * fp.rho q x t = (∫ x, inner ℝ (grad_test q x) (S.f q x t) * fp.rho q x t) + ∑ ℓ, ∫ x, (test (S.phi_q ℓ q x t) (S.phi_x ℓ q x t) - test q x) * S.intensity ℓ q x t * fp.rho q x t := by
      intro q; rw [ ← MeasureTheory.integral_finset_sum ] ; ring;
      · convert MeasureTheory.integral_add ( hint_gen q ) ( MeasureTheory.integrable_finset_sum _ fun ℓ _ => ?_ ) using 3 ; ring;
        · simp +decide only [mul_comm, Finset.mul_sum _ _ _, mul_sub, mul_left_comm];
          exact congrArg _ ( Finset.sum_congr rfl fun _ _ => by ring );
        · convert hint_reset q ℓ using 1 ; ext ; ring;
      · exact fun _ _ => hint_reset q _;
    rw [ Finset.sum_congr rfl fun q _ => h_lhs q, Finset.sum_add_distrib, Finset.sum_comm ];
  rw [ h_lhs, Finset.sum_congr rfl fun q _ => hibp q t ];
  convert congr_arg₂ ( · + · ) rfl ( SHS.generator_fokkerPlanck_duality_reset_part S fp test ( fun ℓ t => hcov_reset ℓ t ) t ( fun q ℓ => hint_reset q ℓ ) ( fun q ℓ => hint_test_intensity q ℓ ) ( fun q ℓ => hint_test_source q ℓ ) ) using 1;
  simp +decide [ SHS.FokkerPlanckData.fokkerPlanckRHS, SHS.FokkerPlanckData.resetDrainTerm ];
  simp +decide only [mul_add, mul_neg, Finset.mul_sum _ _ _];
  rw [ ← Finset.sum_neg_distrib, ← Finset.sum_comm ];
  rw [ ← Finset.sum_add_distrib, Finset.sum_congr rfl ];
  intro q _;
  rw [ MeasureTheory.integral_add, MeasureTheory.integral_neg, MeasureTheory.integral_finset_sum ];
  · exact fun ℓ _ => MeasureTheory.Integrable.add ( MeasureTheory.Integrable.neg ( by simpa only [ mul_assoc ] using ‹∀ q ℓ, Integrable ( fun x => test q x * S.intensity ℓ q x t * fp.rho q x t ) volume› q ℓ ) ) ( ‹∀ q ℓ, Integrable ( fun x => test q x * fp.resetSourceTerm ℓ q x t ) volume› q ℓ );
  · exact MeasureTheory.Integrable.neg ( hint_test_div q );
  · exact MeasureTheory.integrable_finset_sum _ fun ℓ _ => by simpa only [ mul_assoc ] using MeasureTheory.Integrable.add ( MeasureTheory.Integrable.neg ( hint_test_intensity q ℓ ) ) ( hint_test_source q ℓ ) ;

/-! ### 3.2.9 Moment dynamics (Eq. 20)

By choosing `ψ(q, x) = δ_{q,q₀} x^α` (a monomial indicator) in the generator
formula, one obtains ODEs for the moments
  `μ^α_{q₀}(t) := E[x^α 1_{q=q₀}] = ∫ x^α ρ(q₀, x; t) dx`.

In particular, the first moment (mean) obeys (cf. Section 4 of Hespanha 2005):

  `d/dt E[x · 1_{q=q₀}] = ∫ f(q₀,x,t) ρ(q₀,x;t) dx
    + Σ_ℓ ∫ [φ_ℓ^x(q₀,x,t) ρ_{source} − x ρ_{drain}] dx`

These moment equations are the starting point for the TCP analysis in Section 4.
-/

/-- The `α`-th conditional moment of the continuous state in mode `q₀`:
  `μ^α_{q₀}(t) = ∫ x^α ρ(q₀, x; t) dx`

Here `α : Fin n → ℕ` is a multi-index and `x^α = Π_i x_i^{α_i}`. -/
def SHS.FokkerPlanckData.conditionalMoment
    {Q : Type*} [Fintype Q] {n m : ℕ} {S : SHS Q n m}
    (fp : S.FokkerPlanckData)
    (alpha : Fin n → ℕ) (q₀ : Q) (t : ℝ) : ℝ :=
  ∫ x : EuclideanSpace ℝ (Fin n),
    (∏ i : Fin n, (x i) ^ (alpha i)) * fp.rho q₀ x t

/-
PROBLEM
**Moment evolution from the FPE** (Hespanha 2005, Eq. 20 / Section 4).

If `ρ` satisfies the FPE, then the time derivative of the `α`-th conditional
moment `μ^α_{q₀}(t)` equals the integral of the monomial `x^α` against the
Fokker–Planck RHS:

  `d/dt μ^α_{q₀}(t) = ∫ x^α FP(ρ)(q₀, x; t) dx`

This is the formal version of Eq. (20) in Hespanha (2005).

PROVIDED SOLUTION
Since hfpe says partial_t_rho q₀ x₀ t = fokkerPlanckRHS q₀ x₀ t for all q₀ x₀ t, the derivative target in hderiv has partial_t_rho which equals fokkerPlanckRHS. So rewrite hfpe in hderiv (using simp_rw or conv) and use it directly. Specifically, the integral ∫ x^α * partial_t_rho = ∫ x^α * fokkerPlanckRHS by pointwise equality from hfpe.
-/
theorem SHS.fokkerPlanck_moment_evolution
    {Q : Type*} [Fintype Q] [DecidableEq Q] {n m : ℕ} {S : SHS Q n m}
    (fp : S.FokkerPlanckData)
    (hfpe : fp.SatisfiesFPE)
    (alpha : Fin n → ℕ) (q₀ : Q) (t₀ : ℝ)
    -- Regularity: differentiation under the integral sign is valid
    (hderiv : HasDerivAt (fp.conditionalMoment alpha q₀)
      (∫ x : EuclideanSpace ℝ (Fin n),
        (∏ i : Fin n, (x i) ^ (alpha i)) * fp.partial_t_rho q₀ x t₀) t₀) :
    HasDerivAt (fp.conditionalMoment alpha q₀)
      (∫ x : EuclideanSpace ℝ (Fin n),
        (∏ i : Fin n, (x i) ^ (alpha i)) * fp.fokkerPlanckRHS q₀ x t₀) t₀ := by
  rw [ ← MeasureTheory.integral_congr_ae ] ; aesop;
  filter_upwards [ ] with x using by rw [ hfpe q₀ x t₀ ] ;

end