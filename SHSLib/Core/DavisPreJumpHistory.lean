import SHSLib.Core.DavisCounterAugmentation

open MeasureTheory MeasurableSpace
open scoped NNReal

noncomputable section

/-! # Finite pre-jump histories

This module packages the information revealed before a fixed jump index.  A
history of length `k` records the first `k` holding times and channel marks,
together with the initial state and all `k` resulting post-jump states.  The
associated pullback measurable spaces form a discrete-time filtration.
-/

namespace SHS

variable {Q : Type*} [MeasurableSpace Q] [MeasurableSingletonClass Q]
  {n m : ℕ}

/-- Data revealed after the first `k` jumps: the first `k` holding times and
channel marks, and the post-jump states at indices `0, …, k`. -/
structure DavisPreJumpHistory (Q : Type*) (n m k : ℕ) where
  holdingTime : Fin k → ℝ≥0
  channel : Fin k → Fin m
  stateAfterJump : Fin (k + 1) → DavisState Q n

/-- Equip finite histories with the product measurable space of their three
coordinate families. -/
instance DavisPreJumpHistory.instMeasurableSpace :
    MeasurableSpace (DavisPreJumpHistory Q n m k) :=
  MeasurableSpace.comap
    (fun H => (H.holdingTime, H.channel, H.stateAfterJump)) inferInstance

/-- Restrict a longer finite jump history to an initial segment. -/
def DavisPreJumpHistory.restrict {j k : ℕ} (hjk : j ≤ k)
    (H : DavisPreJumpHistory Q n m k) : DavisPreJumpHistory Q n m j where
  holdingTime i := H.holdingTime (Fin.castLE hjk i)
  channel i := H.channel (Fin.castLE hjk i)
  stateAfterJump i := H.stateAfterJump (Fin.castLE (Nat.add_le_add_right hjk 1) i)

/-- The random finite history generated by Davis jump noise before index `k`. -/
def davisPreJumpHistory (S : SHS Q n m) (hflow : S.HasGlobalFlow)
    {Ω : Type*} (ξ : DavisJumpNoise m Ω) (initial : DavisState Q n)
    (k : ℕ) (ω : Ω) : DavisPreJumpHistory Q n m k where
  holdingTime i := ξ.holdingTime i ω
  channel i := ξ.channel i ω
  stateAfterJump i := davisStateAfterJump S hflow ξ initial i ω

@[simp] theorem davisPreJumpHistory_holdingTime
    (S : SHS Q n m) (hflow : S.HasGlobalFlow)
    {Ω : Type*} (ξ : DavisJumpNoise m Ω) (initial : DavisState Q n)
    (k : ℕ) (i : Fin k) (ω : Ω) :
    (davisPreJumpHistory S hflow ξ initial k ω).holdingTime i =
      ξ.holdingTime i ω := rfl

@[simp] theorem davisPreJumpHistory_channel
    (S : SHS Q n m) (hflow : S.HasGlobalFlow)
    {Ω : Type*} (ξ : DavisJumpNoise m Ω) (initial : DavisState Q n)
    (k : ℕ) (i : Fin k) (ω : Ω) :
    (davisPreJumpHistory S hflow ξ initial k ω).channel i =
      ξ.channel i ω := rfl

@[simp] theorem davisPreJumpHistory_stateAfterJump
    (S : SHS Q n m) (hflow : S.HasGlobalFlow)
    {Ω : Type*} (ξ : DavisJumpNoise m Ω) (initial : DavisState Q n)
    (k : ℕ) (i : Fin (k + 1)) (ω : Ω) :
    (davisPreJumpHistory S hflow ξ initial k ω).stateAfterJump i =
      davisStateAfterJump S hflow ξ initial i ω := rfl

/-- Restricting the random history at `k` gives its history at every earlier
index `j`. -/
theorem davisPreJumpHistory_restrict
    (S : SHS Q n m) (hflow : S.HasGlobalFlow)
    {Ω : Type*} (ξ : DavisJumpNoise m Ω) (initial : DavisState Q n)
    {j k : ℕ} (hjk : j ≤ k) (ω : Ω) :
    (davisPreJumpHistory S hflow ξ initial k ω).restrict hjk =
      davisPreJumpHistory S hflow ξ initial j ω := by
  rw [DavisPreJumpHistory.restrict]
  simp [davisPreJumpHistory]

/-- Restriction of finite histories is measurable. -/
theorem DavisPreJumpHistory.measurable_restrict {j k : ℕ} (hjk : j ≤ k) :
    Measurable (DavisPreJumpHistory.restrict (Q := Q) (n := n) (m := m) hjk) := by
  rw [measurable_iff_comap_le, DavisPreJumpHistory.instMeasurableSpace,
    MeasurableSpace.comap_comp]
  rw [← measurable_iff_comap_le]
  have hencode : Measurable (fun H : DavisPreJumpHistory Q n m k =>
      (H.holdingTime, H.channel, H.stateAfterJump)) := by
    rw [measurable_iff_comap_le]
    rfl
  refine Measurable.prodMk ?_ (Measurable.prodMk ?_ ?_)
  · rw [measurable_pi_iff]
    intro i
    exact (measurable_pi_apply (Fin.castLE hjk i)).comp
      (hencode.fst)
  · rw [measurable_pi_iff]
    intro i
    exact (measurable_pi_apply (Fin.castLE hjk i)).comp
      (hencode.snd.fst)
  · rw [measurable_pi_iff]
    intro i
    exact (measurable_pi_apply
      (Fin.castLE (Nat.add_le_add_right hjk 1) i)).comp hencode.snd.snd

/-- Under coordinatewise measurable noise, every finite pre-jump history is a
measurable random variable. -/
theorem DavisJumpNoise.MeasurableNoise.preJumpHistory
    (S : SHS Q n m) (hflow : S.HasGlobalFlow)
    (hf : DavisFlowRegular S hflow) (hr : DavisResetRegular S)
    {Ω : Type*} [MeasurableSpace Ω] {ξ : DavisJumpNoise m Ω}
    (hξ : ξ.MeasurableNoise) (initial : DavisState Q n) (k : ℕ) :
    Measurable (davisPreJumpHistory S hflow ξ initial k) := by
  rw [measurable_iff_comap_le, DavisPreJumpHistory.instMeasurableSpace, MeasurableSpace.comap_comp]
  -- Goal: comap f inferInstance ≤ inst✝
  -- This is equivalent to Measurable f
  rw [← measurable_iff_comap_le]
  -- Goal: Measurable ((fun H => (H.holdingTime, H.channel, H.stateAfterJump)) ∘ (davisPreJumpHistory S hflow ξ initial k))
  refine Measurable.prodMk ?_ (Measurable.prodMk ?_ ?_)
  · rw [measurable_pi_iff]
    intro j
    show Measurable fun ω => (davisPreJumpHistory S hflow ξ initial k ω).holdingTime j
    simp [davisPreJumpHistory_holdingTime]
    exact hξ.holdingTime j
  · rw [measurable_pi_iff]
    intro j
    show Measurable fun ω => (davisPreJumpHistory S hflow ξ initial k ω).channel j
    simp [davisPreJumpHistory_channel]
    exact hξ.channel j
  · rw [measurable_pi_iff]
    intro j
    show Measurable fun ω => (davisPreJumpHistory S hflow ξ initial k ω).stateAfterJump j
    simp [davisPreJumpHistory_stateAfterJump]
    exact hξ.stateAfterJump S hflow hf hr initial j

/-- The measurable space on samples generated by the finite history before
jump index `k`. -/
def DavisJumpNoise.preJumpHistorySpace
    (S : SHS Q n m) (hflow : S.HasGlobalFlow)
    {Ω : Type*} (ξ : DavisJumpNoise m Ω) (initial : DavisState Q n) (k : ℕ) :
    MeasurableSpace Ω :=
  MeasurableSpace.comap (davisPreJumpHistory S hflow ξ initial k) inferInstance

/-- The history-generated measurable spaces increase with the jump index. -/
theorem DavisJumpNoise.preJumpHistorySpace_mono
    (S : SHS Q n m) (hflow : S.HasGlobalFlow)
    {Ω : Type*} (ξ : DavisJumpNoise m Ω) (initial : DavisState Q n) :
    Monotone (ξ.preJumpHistorySpace S hflow initial) := by
  intro j k hjk
  have heq : davisPreJumpHistory S hflow ξ initial j =
      DavisPreJumpHistory.restrict hjk ∘
        davisPreJumpHistory S hflow ξ initial k := by
    funext ω
    exact (davisPreJumpHistory_restrict S hflow ξ initial hjk ω).symm
  unfold DavisJumpNoise.preJumpHistorySpace
  apply measurable_iff_comap_le.mp
  rw [heq]
  exact (DavisPreJumpHistory.measurable_restrict hjk).comp
    (measurable_iff_comap_le.mpr le_rfl)

/-- Measurable histories generate subspaces of the ambient sample measurable
space. -/
theorem DavisJumpNoise.MeasurableNoise.preJumpHistorySpace_le
    (S : SHS Q n m) (hflow : S.HasGlobalFlow)
    (hf : DavisFlowRegular S hflow) (hr : DavisResetRegular S)
    {Ω : Type*} [mΩ : MeasurableSpace Ω] {ξ : DavisJumpNoise m Ω}
    (hξ : ξ.MeasurableNoise) (initial : DavisState Q n) (k : ℕ) :
    ξ.preJumpHistorySpace S hflow initial k ≤ mΩ := by
  rw [DavisJumpNoise.preJumpHistorySpace]
  exact MeasurableSpace.comap_le_iff_le_map.mpr (DavisJumpNoise.MeasurableNoise.preJumpHistory S hflow hf hr hξ initial k)

/-- The discrete-time filtration generated by successive finite pre-jump
histories. -/
def DavisJumpNoise.preJumpHistoryFiltration
    (S : SHS Q n m) (hflow : S.HasGlobalFlow)
    (hf : DavisFlowRegular S hflow) (hr : DavisResetRegular S)
    {Ω : Type*} [mΩ : MeasurableSpace Ω] (ξ : DavisJumpNoise m Ω)
    (hξ : ξ.MeasurableNoise) (initial : DavisState Q n) :
    Filtration ℕ mΩ where
  seq := ξ.preJumpHistorySpace S hflow initial
  mono' := ξ.preJumpHistorySpace_mono S hflow initial
  le' := hξ.preJumpHistorySpace_le S hflow hf hr initial

/-- At index `k`, the finite history map is measurable with respect to its own
generated filtration. -/
theorem DavisJumpNoise.preJumpHistory_measurable_filtration
    (S : SHS Q n m) (hflow : S.HasGlobalFlow)
    (hf : DavisFlowRegular S hflow) (hr : DavisResetRegular S)
    {Ω : Type*} [mΩ : MeasurableSpace Ω] (ξ : DavisJumpNoise m Ω)
    (hξ : ξ.MeasurableNoise) (initial : DavisState Q n) (k : ℕ) :
    Measurable[ξ.preJumpHistoryFiltration S hflow hf hr hξ initial k]
      (davisPreJumpHistory S hflow ξ initial k) := by
  rw [measurable_iff_comap_le]
  rfl

end SHS
