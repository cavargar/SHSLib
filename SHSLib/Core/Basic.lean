# Stochastic Hybrid Systems — Core Definitions

Formalization of the stochastic hybrid system (SHS) model from:

  J.P. Hespanha, "A model for stochastic hybrid systems with application to
  communication networks," Nonlinear Analysis 62 (2005) 1353–1383.

This file contains the core definitions corresponding to Section 2 of the paper:
  - The SHS structure (Eqs. 1–3)
  - Assumption 1 (global existence/uniqueness for flows)
  - Assumption 2 (measurability and boundedness)
  - The sample-path construction (Section 2.1)

Generated by Aristotle, adapted for SHSLib v2.
-/
import Mathlib

open MeasureTheory MeasurableSpace Topology Filter

noncomputable section

/-! ## Section 2: Stochastic Hybrid Systems -/

/-- A Stochastic Hybrid System (SHS) as defined in Section 2, Eqs. (1)–(3).

The system consists of:
- A finite discrete-state space `Q` (typically finite, with no particular topology).
- A continuous state in `ℝⁿ` (represented by `EuclideanSpace ℝ (Fin n)`).
- `m` transition/reset maps `φ_ℓ` and transition intensities `intensity_ℓ`.

The continuous state evolves by `ẋ = f(q, x, t)` between transitions,
and at transition times the state `(q, x)` is reset according to `φ_ℓ`. -/
structure SHS (Q : Type*) (n : ℕ) (m : ℕ) where
  /-- Vector field governing continuous dynamics: `ẋ = f(q, x, t)` (Eq. 1). -/
  f : Q → EuclideanSpace ℝ (Fin n) → ℝ → EuclideanSpace ℝ (Fin n)
  /-- Family of `m` discrete transition/reset maps: `(q, x) = φ_ℓ(q⁻, x⁻, t)` (Eq. 2). -/
  phi : Fin m → Q → EuclideanSpace ℝ (Fin n) → ℝ → Q × EuclideanSpace ℝ (Fin n)
  /-- Family of `m` transition intensities: `λ_ℓ(q, x, t) ≥ 0` (Eq. 3). -/
  intensity : Fin m → Q → EuclideanSpace ℝ (Fin n) → ℝ → ℝ
  /-- Transition intensities are nonnegative. -/
  intensity_nonneg : ∀ ℓ q x t, 0 ≤ intensity ℓ q x t

/-- Projection of the reset map `φ_ℓ` onto the discrete component `Q`. -/
def SHS.phi_q {Q : Type*} {n m : ℕ} (S : SHS Q n m) (ℓ : Fin m)
    (q : Q) (x : EuclideanSpace ℝ (Fin n)) (t : ℝ) : Q :=
  (S.phi ℓ q x t).1

/-- Projection of the reset map `φ_ℓ` onto the continuous component `ℝⁿ`
(denoted `φ^x_ℓ` in the paper, used in Lemma 1). -/
def SHS.phi_x {Q : Type*} {n m : ℕ} (S : SHS Q n m) (ℓ : Fin m)
    (q : Q) (x : EuclideanSpace ℝ (Fin n)) (t : ℝ) : EuclideanSpace ℝ (Fin n) :=
  (S.phi ℓ q x t).2

/-! ### Assumption 1: Global existence and uniqueness of flows -/

/-- The flow `φ(·; t₀, q₀, x₀)` is the unique global solution to `ẋ = f(q₀, x, t)`
with initial condition `x(t₀) = x₀` and `q(t₀) = q₀` (Assumption 1). -/
structure SHS.HasGlobalFlow {Q : Type*} {n m : ℕ} (S : SHS Q n m) where
  /-- The flow map: given `(t₀, q₀, x₀)` returns the solution trajectory `t ↦ x(t)`. -/
  flow : ℝ → Q → EuclideanSpace ℝ (Fin n) → ℝ → EuclideanSpace ℝ (Fin n)
  /-- The flow satisfies the initial condition. -/
  flow_init : ∀ t₀ q₀ x₀, flow t₀ q₀ x₀ t₀ = x₀
  /-- The flow satisfies the ODE `ẋ = f(q₀, x, t)` in an integral sense:
      `φ(t; t₀, q₀, x₀) = x₀ + ∫_{t₀}^{t} f(q₀, φ(s; t₀, q₀, x₀), s) ds`. -/
  flow_ode : ∀ t₀ q₀ x₀ t,
    flow t₀ q₀ x₀ t = x₀ + ∫ s in Set.Icc t₀ t, S.f q₀ (flow t₀ q₀ x₀ s) s

/-! ### Assumption 2: Regularity conditions -/

/-- Assumption 2(i): The transition intensities are measurable functions. -/
class SHS.IntensitiesMeasurable {Q : Type*} [MeasurableSpace Q] {n m : ℕ}
    (S : SHS Q n m) : Prop where
  measurable : ∀ ℓ, Measurable (fun p : Q × EuclideanSpace ℝ (Fin n) × ℝ =>
    S.intensity ℓ p.1 p.2.1 p.2.2)

/-- Assumption 2(ii): For every initial condition, sample paths are globally defined
and bounded by a continuous function. -/
structure SHS.GlobalBound {Q : Type*} {n m : ℕ} (S : SHS Q n m) where
  /-- The bounding function `α_{z₀}` for each initial condition `(q₀, x₀, t₀)`. -/
  bound : Q → EuclideanSpace ℝ (Fin n) → ℝ → ℝ → ℝ
  /-- The bounding function is continuous in `t`. -/
  bound_continuous : ∀ q₀ x₀ t₀, Continuous (bound q₀ x₀ t₀)
  /-- The bounding function is nonneg. -/
  bound_nonneg : ∀ q₀ x₀ t₀ t, 0 ≤ bound q₀ x₀ t₀ t

/-! ### Section 2.1: Sample-path construction

The sample paths of `q`, `x`, and the transition counters `N_ℓ` are constructed
iteratively using independent uniform random variables `μ^ℓ_k` on `[0,1]`
(the "transition triggers"). The construction follows [Davis, Chapter 2] for PDPs.

The transition times `t_k` are defined as the largest times for which
  `exp(- ∫_{t_{k-1}}^{t} λ_ℓ(q(t_{k-1}), φ(s; t_{k-1}, q(t_{k-1}), x(t_{k-1})), s) ds) > μ^ℓ_{k-1}`
holds for all `ℓ ∈ {1, …, m}` and `t ∈ [t_{k-1}, t_k)`. (Eq. 4)
-/

/-- An initial condition for the SHS: a triple `(q₀, x₀, t₀)`. -/
structure SHS.InitialCondition (Q : Type*) (n : ℕ) where
  q₀ : Q
  x₀ : EuclideanSpace ℝ (Fin n)
  t₀ : ℝ

/-
**Eq. (5)** (Hespanha, 2005). The survivor function for the `ℓ`-th transition,
starting from state `(q, x)` at time `t₀`, is

  `F_ℓ(t) = exp(−∫_{t₀}^{t} λ_ℓ(q, φ(s; t₀, q, x), s) ds)`.

Since intensities `λ_ℓ ≥ 0`, the integral is nonneg, so `0 < F_ℓ(t) ≤ 1`.
The survivor function at `t₀` equals 1 (the integral vanishes), and its
rate of decrease at `t` is `λ_ℓ(q, x(t), t)`, formalizing the statement
that "the probability of `N_ℓ` incrementing in `(t, t+dt]` is `λ_ℓ dt`."
-/
theorem SHS.transition_probability_rate
    {Q : Type*} [Fintype Q] {n m : ℕ}
    (S : SHS Q n m) (hflow : S.HasGlobalFlow)
    (ℓ : Fin m) (q : Q) (x : EuclideanSpace ℝ (Fin n)) (t₀ t : ℝ) (ht : t₀ ≤ t)
    (hint : IntegrableOn (fun s => S.intensity ℓ q (hflow.flow t₀ q x s) s)
      (Set.Icc t₀ t) volume) :
    let F := Real.exp (- ∫ s in Set.Icc t₀ t,
      S.intensity ℓ q (hflow.flow t₀ q x s) s)
    0 < F ∧ F ≤ 1 := by
  exact ⟨ Real.exp_pos _, Real.exp_le_one_iff.mpr <| neg_nonpos_of_nonneg <| MeasureTheory.setIntegral_nonneg measurableSet_Icc fun s hs => S.intensity_nonneg ℓ q _ _ ⟩

end