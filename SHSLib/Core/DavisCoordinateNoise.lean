import SHSLib.Core.DavisNoiseBlockMeasurable
import SHSLib.Core.DavisChannelLaw

open MeasureTheory MeasurableSpace ProbabilityTheory
open scoped ENNReal NNReal

noncomputable section

/-! # Independent holding times from the coordinates of a product measure

This module isolates the probabilistic half of a Davis instance with a single
reset channel.  The sample space is the path space `ℕ → ℝ` equipped with a
countable product of copies of one law `μ` on the line, the `k`-th holding time
is the `k`-th coordinate truncated to the nonnegative reals, and the single
mark is constant.

For such a noise the two conditional laws reduce to two purely *model-level*
conditions:

* the survivor factor of the segment started by any realized history is a fixed
  function `T` of the elapsed duration, matched by the tail of `μ`;
* the normalized channel weight at the realized pre-jump states is one, which
  for a single channel only says that the intensity does not vanish there.

The proof is the independence of the coordinates of a product measure together
with the fact — proved in `SHSLib.Core.DavisNoiseBlockMeasurable` — that the
history before jump `k` only uses the first `k` coordinates.
-/

namespace SHS

variable {Q : Type*} [MeasurableSpace Q] [MeasurableSingletonClass Q] {n : ℕ}

/-! ## The noise and its law -/

/-- The noise carried by the coordinates of the path space: the `k`-th holding
time is a fixed measurable function `g` of the `k`-th coordinate, and the
single channel mark is constant. -/
def coordinateNoise (g : ℝ → ℝ≥0) : DavisJumpNoise 1 (ℕ → ℝ) where
  holdingTime k ω := g (ω k)
  channel _ _ := 0

@[simp] theorem coordinateNoise_holdingTime (g : ℝ → ℝ≥0) (k : ℕ) (ω : ℕ → ℝ) :
    (coordinateNoise g).holdingTime k ω = g (ω k) := rfl

@[simp] theorem coordinateNoise_channel (g : ℝ → ℝ≥0) (k : ℕ) (ω : ℕ → ℝ) :
    (coordinateNoise g).channel k ω = 0 := rfl

theorem coordinateNoise_measurable {g : ℝ → ℝ≥0} (hg : Measurable g) :
    (coordinateNoise g).MeasurableNoise where
  holdingTime k := hg.comp (measurable_pi_apply k)
  channel _ := measurable_const

/-- The product law of independent holding-time coordinates with common law
`μ`. -/
def coordinatePathMeasure (μ : Measure ℝ) [IsProbabilityMeasure μ] :
    Measure (ℕ → ℝ) :=
  Measure.infinitePi (fun _ : ℕ => μ)

instance isProbabilityMeasure_coordinatePathMeasure (μ : Measure ℝ)
    [IsProbabilityMeasure μ] : IsProbabilityMeasure (coordinatePathMeasure μ) := by
  rw [coordinatePathMeasure]
  infer_instance

/-- The coordinates of the path space are independent. -/
theorem iIndepFun_coordinatePathMeasure (μ : Measure ℝ) [IsProbabilityMeasure μ] :
    iIndepFun (fun (i : ℕ) (ω : ℕ → ℝ) => ω i) (coordinatePathMeasure μ) := by
  rw [coordinatePathMeasure]
  exact iIndepFun_infinitePi (X := fun (_ : ℕ) (x : ℝ) => x) fun _ => measurable_id

/-- Every coordinate of the path space has law `μ`. -/
theorem coordinatePathMeasure_coordinate (μ : Measure ℝ)
    [IsProbabilityMeasure μ] (k : ℕ) {s : Set ℝ} (hs : MeasurableSet s) :
    coordinatePathMeasure μ {ω | ω k ∈ s} = μ s := by
  have hmap : Measure.map (fun ω : ℕ → ℝ => ω k) (coordinatePathMeasure μ) = μ := by
    rw [coordinatePathMeasure]
    exact Measure.infinitePi_map_eval (fun _ : ℕ => μ) k
  have hset : {ω : ℕ → ℝ | ω k ∈ s} = (fun ω : ℕ → ℝ => ω k) ⁻¹' s := rfl
  rw [hset, ← Measure.map_apply (measurable_pi_apply k) hs, hmap]

/-- The tail of a coordinate of the path space. -/
theorem coordinatePathMeasure_coordinate_Ioi (μ : Measure ℝ)
    [IsProbabilityMeasure μ] (k : ℕ) (x : ℝ) :
    coordinatePathMeasure μ {ω | x < ω k} = μ (Set.Ioi x) :=
  coordinatePathMeasure_coordinate μ k measurableSet_Ioi

/-- The holding-time coordinates are measurable for the σ-algebra generated by
a block of coordinates containing them. -/
theorem coordinateNoise_holdingTime_measurable_block {g : ℝ → ℝ≥0}
    (hg : Measurable g) (k j : ℕ) (hj : j < k) :
    Measurable[MeasurableSpace.comap
        (fun (ω : ℕ → ℝ) (i : {x // x ∈ Finset.range k}) => ω i) inferInstance]
      ((coordinateNoise g).holdingTime j) := by
  have hcomap : Measurable[MeasurableSpace.comap
      (fun (ω : ℕ → ℝ) (i : {x // x ∈ Finset.range k}) => ω i) inferInstance]
      (fun (ω : ℕ → ℝ) (i : {x // x ∈ Finset.range k}) => ω i) :=
    measurable_iff_comap_le.2 le_rfl
  have hj' : j ∈ Finset.range k := Finset.mem_range.2 hj
  exact hg.comp ((measurable_pi_apply (⟨j, hj'⟩ : {x // x ∈ Finset.range k})).comp
    hcomap)

/-! ## The conditional laws -/

omit [MeasurableSingletonClass Q] in
/-- **Independence of the next holding time from the history.**  For an event
determined by the first `k` jumps, the probability of surviving an extra
duration `u` factorizes with the tail of `μ`. -/
theorem coordinateNoise_measure_inter_holdingTime
    (S : SHS Q n 1) (hflow : S.HasGlobalFlow) (hf : DavisFlowRegular S hflow)
    (hr : DavisResetRegular S) (μ : Measure ℝ) [IsProbabilityMeasure μ]
    {g : ℝ → ℝ≥0} (hg : Measurable g)
    (initial : DavisState Q n) (k : ℕ) (u : ℝ≥0) (A : Set (ℕ → ℝ))
    (hA : MeasurableSet[(coordinateNoise g).preJumpHistorySpace S hflow initial k] A) :
    coordinatePathMeasure μ (A ∩ {ω | u < (coordinateNoise g).holdingTime k ω})
      = coordinatePathMeasure μ A * μ {x : ℝ | u < g x} := by
  classical
  set G : MeasurableSpace (ℕ → ℝ) := MeasurableSpace.comap
    (fun (ω : ℕ → ℝ) (i : {x // x ∈ Finset.range k}) => ω i) inferInstance with hG
  set H : MeasurableSpace (ℕ → ℝ) := MeasurableSpace.comap
    (fun (ω : ℕ → ℝ) (i : {x // x ∈ ({k} : Finset ℕ)}) => ω i) inferInstance with hH
  have hdisj : Disjoint (Finset.range k) ({k} : Finset ℕ) := by
    simp [Finset.disjoint_singleton_right]
  have hindep := (iIndepFun_coordinatePathMeasure μ).indepFun_finset
    (Finset.range k) ({k} : Finset ℕ) hdisj (fun i => measurable_pi_apply i)
  have hle : (coordinateNoise g).preJumpHistorySpace S hflow initial k ≤ G := by
    refine preJumpHistorySpace_le_of_coordinates S hflow hf hr G (coordinateNoise g)
      initial k ?_ ?_
    · intro j hj
      exact coordinateNoise_holdingTime_measurable_block hg k j hj
    · intro j _
      exact measurable_const
  have hAG : MeasurableSet[G] A := hle A hA
  have hkmem : k ∈ ({k} : Finset ℕ) := Finset.mem_singleton_self k
  have hBH : MeasurableSet[H] {ω : ℕ → ℝ | u < (coordinateNoise g).holdingTime k ω} := by
    refine ⟨{y : {x // x ∈ ({k} : Finset ℕ)} → ℝ | u < g (y ⟨k, hkmem⟩)}, ?_, ?_⟩
    · exact measurableSet_lt measurable_const (hg.comp (measurable_pi_apply _))
    · ext ω
      simp only [Set.mem_preimage, Set.mem_setOf_eq, coordinateNoise_holdingTime]
  rw [hindep.meas_inter hAG hBH]
  congr 1
  have hcoord : {ω : ℕ → ℝ | u < (coordinateNoise g).holdingTime k ω}
      = {ω : ℕ → ℝ | ω k ∈ {x : ℝ | u < g x}} := rfl
  rw [hcoord, coordinatePathMeasure_coordinate μ k
    (measurableSet_lt measurable_const hg)]

/-- **The conditional holding-time law for a coordinate noise.**  If the
survivor factor of every realized segment is the fixed profile `T` and the tail
of `μ` is `T`, the independent coordinates have the conditional holding-time
law of the model. -/
theorem coordinateNoise_conditionalHoldingTimeLaw
    (S : SHS Q n 1) (hflow : S.HasGlobalFlow) (hf : DavisFlowRegular S hflow)
    (hr : DavisResetRegular S) (μ : Measure ℝ) [IsProbabilityMeasure μ]
    {g : ℝ → ℝ≥0} (hg : Measurable g)
    (initial : DavisState Q n) (T : ℝ≥0 → ℝ)
    (hsurv : ∀ (k : ℕ) (ω : ℕ → ℝ) (u : ℝ≥0),
      (davisPreJumpHistory S hflow (coordinateNoise g) initial k ω).nextSurvivor
        S hflow u = T u)
    (htail : ∀ u : ℝ≥0, μ {x : ℝ | u < g x} = ENNReal.ofReal (T u)) :
    (coordinateNoise g).ConditionalHoldingTimeLaw S hflow hf hr
      (coordinatePathMeasure μ) (coordinateNoise_measurable hg) initial where
  survivor_identity := by
    intro k u A hA
    rw [coordinateNoise_measure_inter_holdingTime S hflow hf hr μ hg initial k u A hA,
      htail u]
    simp only [hsurv k _ u]
    rw [setLIntegral_const, mul_comm]

omit [MeasurableSingletonClass Q] in
/-- **The conditional channel law for a coordinate noise.**  With a single
channel it only requires the normalized weight at the realized pre-jump states
to be one, i.e. the intensity not to vanish there. -/
theorem coordinateNoise_conditionalChannelLaw
    (S : SHS Q n 1) (hflow : S.HasGlobalFlow) (μ : Measure ℝ)
    [IsProbabilityMeasure μ] (g : ℝ → ℝ≥0) (initial : DavisState Q n)
    (hchan : ∀ k : ℕ, ∀ᵐ ω ∂(coordinatePathMeasure μ),
      davisChannelProbability S
        ((davisPreJumpHistory S hflow (coordinateNoise g) initial k ω).stateBeforeNextJump
          S hflow ((coordinateNoise g).holdingTime k ω)) 0 = 1) :
    (coordinateNoise g).ConditionalChannelLaw S hflow (coordinatePathMeasure μ)
      initial where
  channel_identity := by
    intro k ℓ A _
    have hℓ : ℓ = 0 := Subsingleton.elim ℓ 0
    subst hℓ
    have hset : {ω : ℕ → ℝ | (coordinateNoise g).channel k ω = 0} = Set.univ := by
      ext ω
      simp
    have hae : (fun ω : ℕ → ℝ => ENNReal.ofReal (davisChannelProbability S
        ((davisPreJumpHistory S hflow (coordinateNoise g) initial k ω).stateBeforeNextJump
          S hflow ((coordinateNoise g).holdingTime k ω)) 0))
        =ᵐ[(coordinatePathMeasure μ).restrict A] fun _ => (1 : ℝ≥0∞) := by
      refine ae_restrict_of_ae ((hchan k).mono ?_)
      intro ω hω
      simp only [hω, ENNReal.ofReal_one]
    rw [hset, Set.inter_univ, lintegral_congr_ae hae, setLIntegral_const, one_mul]

end SHS
