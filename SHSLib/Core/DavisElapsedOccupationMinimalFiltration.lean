import SHSLib.Core.DavisElapsedOccupationCappedMartingale

open MeasureTheory MeasurableSpace
open scoped ENNReal NNReal

noncomputable section

/-! # The minimal observability filtration

The elapsed occupation martingale theory is stated for an arbitrary filtration
satisfying the componentwise observability interface.  Only the
full-information filtration has been shown to satisfy it so far, which is the
largest possible choice.

This module constructs the smallest possible choice: the filtration generated,
at each elapsed time, by the three observable components of every
deterministic jump-capped approximation at all earlier times.  It is a genuine
filtration because those components are ambient measurable, it satisfies the
observability interface by construction, it is contained in the
full-information filtration, and it is contained in every filtration
satisfying the interface.  Consequently the martingale, generator, and
Dynkin-type statements are available for the smallest filtration that can
carry them.
-/

namespace SHS

variable {Q : Type*} [MeasurableSpace Q] [MeasurableSingletonClass Q]
  {n m : ℕ}

/-- The sigma-algebra generated by the three observable components of every
deterministic jump-capped approximation at a single elapsed time. -/
def davisElapsedOccupationComponentSpace (S : SHS Q n m)
    (hflow : S.HasGlobalFlow) {Ω : Type*}
    (ξ : DavisJumpNoise m Ω) (hne : ξ.NonExplosive)
    (initial : DavisState Q n) (g : DavisState Q n → ℝ)
    (t : ℝ≥0) : MeasurableSpace Ω :=
  ⨆ N : ℕ,
    (MeasurableSpace.comap (davisStoppedElapsedRealizedResetContribution
        S hflow ξ hne initial g N t) inferInstance ⊔
      MeasurableSpace.comap (davisStoppedElapsedCompletedResetOccupation
        S hflow ξ hne initial g N t) inferInstance ⊔
      MeasurableSpace.comap (davisStoppedElapsedActiveResetOccupation
        S hflow ξ hne initial g N t) inferInstance)

omit [MeasurableSpace Q] [MeasurableSingletonClass Q] in
/-- Every filtration satisfying the observability interface dominates the
one-time component sigma-algebra. -/
theorem DavisElapsedOccupationObservable.componentSpace_le
    {S : SHS Q n m} {hflow : S.HasGlobalFlow}
    {Ω : Type*} [mΩ : MeasurableSpace Ω]
    {filtration : Filtration ℝ≥0 mΩ}
    {ξ : DavisJumpNoise m Ω} {hne : ξ.NonExplosive}
    {initial : DavisState Q n} {g : DavisState Q n → ℝ}
    (hobs : DavisElapsedOccupationObservable
      S hflow filtration ξ hne initial g)
    (t : ℝ≥0) :
    davisElapsedOccupationComponentSpace S hflow ξ hne initial g t ≤
      filtration t := by
  unfold davisElapsedOccupationComponentSpace
  apply iSup_le
  intro N
  rw [sup_le_iff, sup_le_iff]
  refine ⟨⟨?_, ?_⟩, ?_⟩
  · exact (hobs.realized_measurable N t).comap_le
  · exact (hobs.completed_occupation_measurable N t).comap_le
  · exact (hobs.active_occupation_measurable N t).comap_le

/-- The minimal filtration carrying the elapsed occupation-centered reset
process: at each elapsed time it is generated by the observable components at
all earlier times. -/
def DavisResetOccupationRegular.elapsedOccupationFiltration
    {S : SHS Q n m} {hflow : S.HasGlobalFlow}
    {hf : DavisFlowRegular S hflow} {hr : DavisResetRegular S}
    {g : DavisState Q n → ℝ}
    (hreg : DavisResetOccupationRegular S hflow g)
    {Ω : Type*} [mΩ : MeasurableSpace Ω] {ξ : DavisJumpNoise m Ω}
    (hξ : ξ.MeasurableNoise) (hne : ξ.NonExplosive)
    (initial : DavisState Q n) (hg : Measurable g) :
    Filtration ℝ≥0 mΩ where
  seq t := ⨆ (s : ℝ≥0) (_ : s ≤ t),
    davisElapsedOccupationComponentSpace S hflow ξ hne initial g s
  mono' i j hij := by
    refine iSup₂_le fun s hs => ?_
    exact le_iSup₂_of_le s (hs.trans hij) le_rfl
  le' i := by
    refine iSup₂_le fun s _ => ?_
    exact (@DavisResetOccupationRegular.elapsedOccupationObservable_full
      Q _ _ n m S hflow hf hr g hreg Ω _ ξ hξ hne initial hg).componentSpace_le s

/-- The minimal filtration satisfies the componentwise observability
interface. -/
theorem DavisResetOccupationRegular.elapsedOccupationObservable_minimal
    {S : SHS Q n m} {hflow : S.HasGlobalFlow}
    {hf : DavisFlowRegular S hflow} {hr : DavisResetRegular S}
    {g : DavisState Q n → ℝ}
    (hreg : DavisResetOccupationRegular S hflow g)
    {Ω : Type*} [mΩ : MeasurableSpace Ω] {ξ : DavisJumpNoise m Ω}
    (hξ : ξ.MeasurableNoise) (hne : ξ.NonExplosive)
    (initial : DavisState Q n) (hg : Measurable g) :
    DavisElapsedOccupationObservable S hflow
      (@DavisResetOccupationRegular.elapsedOccupationFiltration
        Q _ _ n m S hflow hf hr g hreg Ω _ ξ hξ hne initial hg)
      ξ hne initial g := by
  constructor
  · -- realized_measurable
    intro N t
    rw [measurable_iff_comap_le]
    have h1 : MeasurableSpace.comap (S.davisStoppedElapsedRealizedResetContribution hflow ξ hne initial g N t) Real.measurableSpace ≤
      (MeasurableSpace.comap (S.davisStoppedElapsedRealizedResetContribution hflow ξ hne initial g N t) Real.measurableSpace ⊔
       MeasurableSpace.comap (S.davisStoppedElapsedCompletedResetOccupation hflow ξ hne initial g N t) Real.measurableSpace ⊔
       MeasurableSpace.comap (S.davisStoppedElapsedActiveResetOccupation hflow ξ hne initial g N t) Real.measurableSpace) := le_trans le_sup_left le_sup_left
    have h2 : (MeasurableSpace.comap (S.davisStoppedElapsedRealizedResetContribution hflow ξ hne initial g N t) Real.measurableSpace ⊔
       MeasurableSpace.comap (S.davisStoppedElapsedCompletedResetOccupation hflow ξ hne initial g N t) Real.measurableSpace ⊔
       MeasurableSpace.comap (S.davisStoppedElapsedActiveResetOccupation hflow ξ hne initial g N t) Real.measurableSpace) ≤
      ⨆ N' : ℕ, (MeasurableSpace.comap (S.davisStoppedElapsedRealizedResetContribution hflow ξ hne initial g N' t) Real.measurableSpace ⊔
       MeasurableSpace.comap (S.davisStoppedElapsedCompletedResetOccupation hflow ξ hne initial g N' t) Real.measurableSpace ⊔
       MeasurableSpace.comap (S.davisStoppedElapsedActiveResetOccupation hflow ξ hne initial g N' t) Real.measurableSpace) := le_iSup_of_le N le_rfl
    have h3 : (⨆ N' : ℕ, (MeasurableSpace.comap (S.davisStoppedElapsedRealizedResetContribution hflow ξ hne initial g N' t) Real.measurableSpace ⊔
       MeasurableSpace.comap (S.davisStoppedElapsedCompletedResetOccupation hflow ξ hne initial g N' t) Real.measurableSpace ⊔
       MeasurableSpace.comap (S.davisStoppedElapsedActiveResetOccupation hflow ξ hne initial g N' t) Real.measurableSpace)) ≤
      @DavisResetOccupationRegular.elapsedOccupationFiltration Q _ _ n m S hflow hf hr g hreg Ω _ ξ hξ hne initial hg t := le_iSup₂_of_le t (le_refl t) le_rfl
    exact le_trans (le_trans h1 h2) h3
  · -- completed_occupation_measurable
    intro N t
    rw [measurable_iff_comap_le]
    have h1 : MeasurableSpace.comap (S.davisStoppedElapsedCompletedResetOccupation hflow ξ hne initial g N t) Real.measurableSpace ≤
      (MeasurableSpace.comap (S.davisStoppedElapsedRealizedResetContribution hflow ξ hne initial g N t) Real.measurableSpace ⊔
       MeasurableSpace.comap (S.davisStoppedElapsedCompletedResetOccupation hflow ξ hne initial g N t) Real.measurableSpace ⊔
       MeasurableSpace.comap (S.davisStoppedElapsedActiveResetOccupation hflow ξ hne initial g N t) Real.measurableSpace) := le_trans le_sup_right le_sup_left
    have h2 : (MeasurableSpace.comap (S.davisStoppedElapsedRealizedResetContribution hflow ξ hne initial g N t) Real.measurableSpace ⊔
       MeasurableSpace.comap (S.davisStoppedElapsedCompletedResetOccupation hflow ξ hne initial g N t) Real.measurableSpace ⊔
       MeasurableSpace.comap (S.davisStoppedElapsedActiveResetOccupation hflow ξ hne initial g N t) Real.measurableSpace) ≤
      ⨆ N' : ℕ, (MeasurableSpace.comap (S.davisStoppedElapsedRealizedResetContribution hflow ξ hne initial g N' t) Real.measurableSpace ⊔
       MeasurableSpace.comap (S.davisStoppedElapsedCompletedResetOccupation hflow ξ hne initial g N' t) Real.measurableSpace ⊔
       MeasurableSpace.comap (S.davisStoppedElapsedActiveResetOccupation hflow ξ hne initial g N' t) Real.measurableSpace) := le_iSup_of_le N le_rfl
    have h3 : (⨆ N' : ℕ, (MeasurableSpace.comap (S.davisStoppedElapsedRealizedResetContribution hflow ξ hne initial g N' t) Real.measurableSpace ⊔
       MeasurableSpace.comap (S.davisStoppedElapsedCompletedResetOccupation hflow ξ hne initial g N' t) Real.measurableSpace ⊔
       MeasurableSpace.comap (S.davisStoppedElapsedActiveResetOccupation hflow ξ hne initial g N' t) Real.measurableSpace)) ≤
      @DavisResetOccupationRegular.elapsedOccupationFiltration Q _ _ n m S hflow hf hr g hreg Ω _ ξ hξ hne initial hg t := le_iSup₂_of_le t (le_refl t) le_rfl
    exact le_trans (le_trans h1 h2) h3
  · -- active_occupation_measurable
    intro N t
    rw [measurable_iff_comap_le]
    have h1 : MeasurableSpace.comap (S.davisStoppedElapsedActiveResetOccupation hflow ξ hne initial g N t) Real.measurableSpace ≤
      (MeasurableSpace.comap (S.davisStoppedElapsedRealizedResetContribution hflow ξ hne initial g N t) Real.measurableSpace ⊔
       MeasurableSpace.comap (S.davisStoppedElapsedCompletedResetOccupation hflow ξ hne initial g N t) Real.measurableSpace ⊔
       MeasurableSpace.comap (S.davisStoppedElapsedActiveResetOccupation hflow ξ hne initial g N t) Real.measurableSpace) := le_sup_right
    have h2 : (MeasurableSpace.comap (S.davisStoppedElapsedRealizedResetContribution hflow ξ hne initial g N t) Real.measurableSpace ⊔
       MeasurableSpace.comap (S.davisStoppedElapsedCompletedResetOccupation hflow ξ hne initial g N t) Real.measurableSpace ⊔
       MeasurableSpace.comap (S.davisStoppedElapsedActiveResetOccupation hflow ξ hne initial g N t) Real.measurableSpace) ≤
      ⨆ N' : ℕ, (MeasurableSpace.comap (S.davisStoppedElapsedRealizedResetContribution hflow ξ hne initial g N' t) Real.measurableSpace ⊔
       MeasurableSpace.comap (S.davisStoppedElapsedCompletedResetOccupation hflow ξ hne initial g N' t) Real.measurableSpace ⊔
       MeasurableSpace.comap (S.davisStoppedElapsedActiveResetOccupation hflow ξ hne initial g N' t) Real.measurableSpace) := le_iSup_of_le N le_rfl
    have h3 : (⨆ N' : ℕ, (MeasurableSpace.comap (S.davisStoppedElapsedRealizedResetContribution hflow ξ hne initial g N' t) Real.measurableSpace ⊔
       MeasurableSpace.comap (S.davisStoppedElapsedCompletedResetOccupation hflow ξ hne initial g N' t) Real.measurableSpace ⊔
       MeasurableSpace.comap (S.davisStoppedElapsedActiveResetOccupation hflow ξ hne initial g N' t) Real.measurableSpace)) ≤
      @DavisResetOccupationRegular.elapsedOccupationFiltration Q _ _ n m S hflow hf hr g hreg Ω _ ξ hξ hne initial hg t := le_iSup₂_of_le t (le_refl t) le_rfl
    exact le_trans (le_trans h1 h2) h3

/-- The minimal filtration is contained in every filtration satisfying the
observability interface. -/
theorem DavisElapsedOccupationObservable.elapsedOccupationFiltration_le
    {S : SHS Q n m} {hflow : S.HasGlobalFlow}
    {hf : DavisFlowRegular S hflow} {hr : DavisResetRegular S}
    {g : DavisState Q n → ℝ}
    (hreg : DavisResetOccupationRegular S hflow g)
    {Ω : Type*} [mΩ : MeasurableSpace Ω] {filtration : Filtration ℝ≥0 mΩ}
    {ξ : DavisJumpNoise m Ω} (hξ : ξ.MeasurableNoise) {hne : ξ.NonExplosive}
    {initial : DavisState Q n} (hg : Measurable g)
    (hobs : DavisElapsedOccupationObservable
      S hflow filtration ξ hne initial g) :
    (@DavisResetOccupationRegular.elapsedOccupationFiltration
      Q _ _ n m S hflow hf hr g hreg Ω _ ξ hξ hne initial hg) ≤ filtration := by
  intro t
  simp only [DavisResetOccupationRegular.elapsedOccupationFiltration]
  refine iSup₂_le fun s hs => ?_
  calc davisElapsedOccupationComponentSpace S hflow ξ hne initial g s
      ≤ filtration s := hobs.componentSpace_le s
    _ ≤ filtration t := filtration.mono hs

/-- In particular the minimal filtration is contained in the full-information
filtration. -/
theorem DavisResetOccupationRegular.elapsedOccupationFiltration_le_full
    {S : SHS Q n m} {hflow : S.HasGlobalFlow}
    {hf : DavisFlowRegular S hflow} {hr : DavisResetRegular S}
    {g : DavisState Q n → ℝ}
    (hreg : DavisResetOccupationRegular S hflow g)
    {Ω : Type*} [mΩ : MeasurableSpace Ω] {ξ : DavisJumpNoise m Ω}
    (hξ : ξ.MeasurableNoise) (hne : ξ.NonExplosive)
    (initial : DavisState Q n) (hg : Measurable g) :
    (@DavisResetOccupationRegular.elapsedOccupationFiltration
        Q _ _ n m S hflow hf hr g hreg Ω _ ξ hξ hne initial hg) ≤
      ξ.fullFiltration := fun i =>
  ((@DavisResetOccupationRegular.elapsedOccupationFiltration
    Q _ _ n m S hflow hf hr g hreg Ω _ ξ hξ hne initial hg).le i)

/-- Martingale property for the minimal filtration: only the deterministic-cap
increment law for that filtration, reset-occupation regularity, and integrable
elapsed envelopes are required. -/
theorem DavisStoppedElapsedOccupationIncrementLaw.martingale_minimal
    {S : SHS Q n m} {hflow : S.HasGlobalFlow}
    {hf : DavisFlowRegular S hflow} {hr : DavisResetRegular S}
    {g : DavisState Q n → ℝ}
    (hreg : DavisResetOccupationRegular S hflow g)
    {Ω : Type*} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsFiniteMeasure P]
    {ξ : DavisJumpNoise m Ω} (hξ : ξ.MeasurableNoise)
    {hne : ξ.NonExplosive} (initial : DavisState Q n) (hg : Measurable g)
    (hlaw : DavisStoppedElapsedOccupationIncrementLaw S hflow P
      (@DavisResetOccupationRegular.elapsedOccupationFiltration
        Q _ _ n m S hflow hf hr g hreg Ω _ ξ hξ hne initial hg)
      ξ hne initial g)
    (henv : ∀ t, Integrable
      (davisElapsedOccupationEnvelope S hflow ξ hne initial g t) P) :
    Martingale
      (davisElapsedOccupationCenteredResetProcess
        S hflow ξ hne initial g)
      (@DavisResetOccupationRegular.elapsedOccupationFiltration
        Q _ _ n m S hflow hf hr g hreg Ω _ ξ hξ hne initial hg) P :=
  @DavisStoppedElapsedOccupationIncrementLaw.martingale
    Q _ _ n m S hflow hf hr g hreg Ω _ P _ _ ξ hξ hne initial hg
    (@DavisResetOccupationRegular.elapsedOccupationObservable_minimal
      Q _ _ n m S hflow hf hr g hreg Ω _ ξ hξ hne initial hg)
    hlaw henv

end SHS
