import SHSLib.Core.DavisCoordinateNoise

open MeasureTheory MeasurableSpace ProbabilityTheory
open scoped ENNReal NNReal

noncomputable section

/-! # Independent holding times *and* marks from the coordinates of a product
measure

The coordinate noise of `SHSLib.Core.DavisCoordinateNoise` reads the holding
times off the coordinates of a product measure and has a single, constant
channel mark.  Every instance built on it is therefore a one-channel model, for
which the conditional channel law degenerates to "the intensity does not
vanish".

Here the construction is extended to genuinely marked noise.  The sample space
is still the path space `ℕ → ℝ`, but the coordinates are used *interleaved*:

* the even coordinate `2k` carries the `k`-th holding time, through a readout
  `g`;
* the odd coordinate `2k+1` carries the `k`-th channel mark, through a readout
  `c : ℝ → Fin m`.

The law is the product of a holding law `μ` on the even coordinates and a mark
law `ν` on the odd ones, so that all the readouts are independent.  Two
conditional laws are then available:

* the conditional holding-time law, exactly as before — the information used
  before jump `k` lives in the coordinate block `range (2k)`, and the next
  holding time is read off coordinate `2k`, which is independent of it;
* **the conditional channel law**, which is the new content: the information
  available immediately before the mark is sampled — the history *and* the
  holding time just revealed — lives in the block `range (2k+1)`, and the mark
  is read off coordinate `2k+1`.  So the mark is independent of it, with
  distribution `ν ∘ c⁻¹`, and the law holds as soon as that distribution
  matches the normalized channel weights at the realized pre-jump states.

This is what a model with several reset channels needs: a mark whose
conditional distribution given the past is the vector of normalized channel
weights.
-/

namespace SHS

variable {Q : Type*} [MeasurableSpace Q] [MeasurableSingletonClass Q] {n m : ℕ}

/-! ## The interleaved product law -/

/-- The law of coordinate `i`: the holding law `μ` on even coordinates, the mark
law `ν` on odd ones. -/
def interleavedLaw (mu nu : Measure ℝ) : ℕ → Measure ℝ :=
  fun i => if i % 2 = 0 then mu else nu

instance isProbabilityMeasure_interleavedLaw (mu nu : Measure ℝ)
    [IsProbabilityMeasure mu] [IsProbabilityMeasure nu] (i : ℕ) :
    IsProbabilityMeasure (interleavedLaw mu nu i) := by
  unfold interleavedLaw
  split <;> infer_instance

@[simp] theorem interleavedLaw_even (mu nu : Measure ℝ) (k : ℕ) :
    interleavedLaw mu nu (2 * k) = mu := by
  simp [interleavedLaw, Nat.mul_mod_right]

@[simp] theorem interleavedLaw_odd (mu nu : Measure ℝ) (k : ℕ) :
    interleavedLaw mu nu (2 * k + 1) = nu := by
  have : (2 * k + 1) % 2 = 1 := by omega
  simp [interleavedLaw, this]

/-- The interleaved product law on the path space. -/
def interleavedPathMeasure (mu nu : Measure ℝ) [IsProbabilityMeasure mu]
    [IsProbabilityMeasure nu] : Measure (ℕ → ℝ) :=
  Measure.infinitePi (interleavedLaw mu nu)

instance isProbabilityMeasure_interleavedPathMeasure (mu nu : Measure ℝ)
    [IsProbabilityMeasure mu] [IsProbabilityMeasure nu] :
    IsProbabilityMeasure (interleavedPathMeasure mu nu) := by
  rw [interleavedPathMeasure]
  infer_instance

/-- The coordinates of the interleaved path space are independent. -/
theorem iIndepFun_interleavedPathMeasure (mu nu : Measure ℝ)
    [IsProbabilityMeasure mu] [IsProbabilityMeasure nu] :
    iIndepFun (fun (i : ℕ) (om : ℕ → ℝ) => om i) (interleavedPathMeasure mu nu) := by
  rw [interleavedPathMeasure]
  exact iIndepFun_infinitePi (X := fun (_ : ℕ) (x : ℝ) => x) fun _ => measurable_id

/-- The law of one coordinate of the interleaved path space. -/
theorem interleavedPathMeasure_coordinate (mu nu : Measure ℝ)
    [IsProbabilityMeasure mu] [IsProbabilityMeasure nu] (i : ℕ) {s : Set ℝ}
    (hs : MeasurableSet s) :
    interleavedPathMeasure mu nu {om | om i ∈ s} = interleavedLaw mu nu i s := by
  have hmap : Measure.map (fun om : ℕ → ℝ => om i) (interleavedPathMeasure mu nu)
      = interleavedLaw mu nu i := by
    rw [interleavedPathMeasure]
    exact Measure.infinitePi_map_eval (interleavedLaw mu nu) i
  have hset : {om : ℕ → ℝ | om i ∈ s} = (fun om : ℕ → ℝ => om i) ⁻¹' s := rfl
  rw [hset, ← Measure.map_apply (measurable_pi_apply i) hs, hmap]

/-- The σ-algebra generated by the first `N` coordinates of the path space. -/
def coordinateBlockSpace (N : ℕ) : MeasurableSpace (ℕ → ℝ) :=
  MeasurableSpace.comap
    (fun (om : ℕ → ℝ) (i : {x // x ∈ Finset.range N}) => om i) inferInstance

/-- A coordinate inside the block is measurable for the block σ-algebra. -/
theorem measurable_coordinateBlockSpace_apply {N j : ℕ} (hj : j < N) :
    Measurable[coordinateBlockSpace N] fun om : ℕ → ℝ => om j := by
  have hcomap : Measurable[coordinateBlockSpace N]
      (fun (om : ℕ → ℝ) (i : {x // x ∈ Finset.range N}) => om i) :=
    measurable_iff_comap_le.2 le_rfl
  exact (measurable_pi_apply (⟨j, Finset.mem_range.2 hj⟩ :
    {x // x ∈ Finset.range N})).comp hcomap

/-- **Independence of a coordinate from an earlier block.**  For an event
determined by the first `N` coordinates, the probability of an event determined
by coordinate `N` factorizes. -/
theorem interleaved_measure_inter_block (mu nu : Measure ℝ)
    [IsProbabilityMeasure mu] [IsProbabilityMeasure nu] (N : ℕ)
    {A : Set (ℕ → ℝ)} (hA : MeasurableSet[coordinateBlockSpace N] A)
    {s : Set ℝ} (hs : MeasurableSet s) :
    interleavedPathMeasure mu nu (A ∩ {om | om N ∈ s})
      = interleavedPathMeasure mu nu A * interleavedLaw mu nu N s := by
  classical
  have hdisj : Disjoint (Finset.range N) ({N} : Finset ℕ) := by
    simp [Finset.disjoint_singleton_right]
  have hindep := (iIndepFun_interleavedPathMeasure mu nu).indepFun_finset
    (Finset.range N) ({N} : Finset ℕ) hdisj (fun i => measurable_pi_apply i)
  have hNmem : N ∈ ({N} : Finset ℕ) := Finset.mem_singleton_self N
  have hBH : MeasurableSet[MeasurableSpace.comap
      (fun (om : ℕ → ℝ) (i : {x // x ∈ ({N} : Finset ℕ)}) => om i) inferInstance]
      {om : ℕ → ℝ | om N ∈ s} := by
    refine ⟨{y : {x // x ∈ ({N} : Finset ℕ)} → ℝ | y ⟨N, hNmem⟩ ∈ s}, ?_, ?_⟩
    · exact (measurable_pi_apply _) hs
    · ext om
      simp only [Set.mem_preimage, Set.mem_setOf_eq]
  rw [hindep.meas_inter hA hBH]
  congr 1
  rw [interleavedPathMeasure_coordinate mu nu N hs]

/-! ## The marked coordinate noise -/

/-- The noise carried by interleaved coordinates: the `k`-th holding time is
read off the even coordinate `2k`, the `k`-th channel mark off the odd
coordinate `2k+1`. -/
def markedCoordinateNoise (g : ℝ → ℝ≥0) (c : ℝ → Fin m) : DavisJumpNoise m (ℕ → ℝ) where
  holdingTime k om := g (om (2 * k))
  channel k om := c (om (2 * k + 1))

@[simp] theorem markedCoordinateNoise_holdingTime (g : ℝ → ℝ≥0) (c : ℝ → Fin m)
    (k : ℕ) (om : ℕ → ℝ) :
    (markedCoordinateNoise g c).holdingTime k om = g (om (2 * k)) := rfl

@[simp] theorem markedCoordinateNoise_channel (g : ℝ → ℝ≥0) (c : ℝ → Fin m)
    (k : ℕ) (om : ℕ → ℝ) :
    (markedCoordinateNoise g c).channel k om = c (om (2 * k + 1)) := rfl

theorem markedCoordinateNoise_measurable {g : ℝ → ℝ≥0} {c : ℝ → Fin m}
    (hg : Measurable g) (hc : Measurable c) :
    (markedCoordinateNoise g c).MeasurableNoise where
  holdingTime _ := hg.comp (measurable_pi_apply _)
  channel _ := hc.comp (measurable_pi_apply _)

/-- The `j`-th holding time is measurable for a coordinate block containing the
coordinate `2j`. -/
theorem markedCoordinateNoise_holdingTime_measurable_block {g : ℝ → ℝ≥0}
    {c : ℝ → Fin m} (hg : Measurable g) {N j : ℕ} (hj : 2 * j < N) :
    Measurable[coordinateBlockSpace N] ((markedCoordinateNoise g c).holdingTime j) :=
  hg.comp (measurable_coordinateBlockSpace_apply hj)

/-- The `j`-th mark is measurable for a coordinate block containing the
coordinate `2j+1`. -/
theorem markedCoordinateNoise_channel_measurable_block {g : ℝ → ℝ≥0}
    {c : ℝ → Fin m} (hc : Measurable c) {N j : ℕ} (hj : 2 * j + 1 < N) :
    Measurable[coordinateBlockSpace N] ((markedCoordinateNoise g c).channel j) :=
  hc.comp (measurable_coordinateBlockSpace_apply hj)

omit [MeasurableSingletonClass Q] in
/-- The σ-algebra available just before the `k`-th mark is sampled is contained
in any σ-algebra carrying the first `k` holding times and marks together with
the `k`-th holding time. -/
theorem preChannelSpace_le_of_coordinates
    (S : SHS Q n m) (hflow : S.HasGlobalFlow) (hf : DavisFlowRegular S hflow)
    (hr : DavisResetRegular S)
    {Om : Type*} (G : MeasurableSpace Om) (xi : DavisJumpNoise m Om)
    (initial : DavisState Q n) (k : ℕ)
    (hh : ∀ j, j < k → Measurable[G] (xi.holdingTime j))
    (hc : ∀ j, j < k → Measurable[G] (xi.channel j))
    (hk : Measurable[G] (xi.holdingTime k)) :
    xi.preChannelSpace S hflow initial k ≤ G :=
  measurable_iff_comap_le.1
    ((measurable_davisPreJumpHistory_of_coordinates S hflow hf hr G xi initial k
      hh hc).prodMk hk)

omit [MeasurableSingletonClass Q] in
/-- The history before jump `k` of a marked coordinate noise is determined by
the coordinate block `range (2k)`. -/
theorem markedCoordinateNoise_preJumpHistorySpace_le
    (S : SHS Q n m) (hflow : S.HasGlobalFlow) (hf : DavisFlowRegular S hflow)
    (hr : DavisResetRegular S) {g : ℝ → ℝ≥0} {c : ℝ → Fin m}
    (hg : Measurable g) (hc : Measurable c)
    (initial : DavisState Q n) (k : ℕ) :
    (markedCoordinateNoise g c).preJumpHistorySpace S hflow initial k
      ≤ coordinateBlockSpace (2 * k) :=
  preJumpHistorySpace_le_of_coordinates S hflow hf hr _ (markedCoordinateNoise g c)
    initial k
    (fun j hj => markedCoordinateNoise_holdingTime_measurable_block hg (by omega))
    (fun j hj => markedCoordinateNoise_channel_measurable_block hc (by omega))

omit [MeasurableSingletonClass Q] in
/-- The information available just before the `k`-th mark of a marked
coordinate noise is determined by the coordinate block `range (2k+1)`. -/
theorem markedCoordinateNoise_preChannelSpace_le
    (S : SHS Q n m) (hflow : S.HasGlobalFlow) (hf : DavisFlowRegular S hflow)
    (hr : DavisResetRegular S) {g : ℝ → ℝ≥0} {c : ℝ → Fin m}
    (hg : Measurable g) (hc : Measurable c)
    (initial : DavisState Q n) (k : ℕ) :
    (markedCoordinateNoise g c).preChannelSpace S hflow initial k
      ≤ coordinateBlockSpace (2 * k + 1) :=
  preChannelSpace_le_of_coordinates S hflow hf hr _ (markedCoordinateNoise g c)
    initial k
    (fun j hj => markedCoordinateNoise_holdingTime_measurable_block hg (by omega))
    (fun j hj => markedCoordinateNoise_channel_measurable_block hc (by omega))
    (markedCoordinateNoise_holdingTime_measurable_block hg (by omega))

/-! ## The conditional laws -/

omit [MeasurableSingletonClass Q] in
/-- **Independence of the next holding time from the history**, for a marked
coordinate noise. -/
theorem markedCoordinateNoise_measure_inter_holdingTime
    (S : SHS Q n m) (hflow : S.HasGlobalFlow) (hf : DavisFlowRegular S hflow)
    (hr : DavisResetRegular S) (mu nu : Measure ℝ) [IsProbabilityMeasure mu]
    [IsProbabilityMeasure nu] {g : ℝ → ℝ≥0} {c : ℝ → Fin m}
    (hg : Measurable g) (hc : Measurable c)
    (initial : DavisState Q n) (k : ℕ) (u : ℝ≥0) {A : Set (ℕ → ℝ)}
    (hA : MeasurableSet[(markedCoordinateNoise g c).preJumpHistorySpace S hflow
      initial k] A) :
    interleavedPathMeasure mu nu
        (A ∩ {om | u < (markedCoordinateNoise g c).holdingTime k om})
      = interleavedPathMeasure mu nu A * mu {x : ℝ | u < g x} := by
  have hAB : MeasurableSet[coordinateBlockSpace (2 * k)] A :=
    markedCoordinateNoise_preJumpHistorySpace_le S hflow hf hr hg hc initial k A hA
  have hset : {om : ℕ → ℝ | u < (markedCoordinateNoise g c).holdingTime k om}
      = {om : ℕ → ℝ | om (2 * k) ∈ {x : ℝ | u < g x}} := rfl
  rw [hset, interleaved_measure_inter_block mu nu (2 * k) hAB
    (measurableSet_lt measurable_const hg), interleavedLaw_even]

/-- **The conditional holding-time law for a marked coordinate noise.** -/
theorem markedCoordinateNoise_conditionalHoldingTimeLaw
    (S : SHS Q n m) (hflow : S.HasGlobalFlow) (hf : DavisFlowRegular S hflow)
    (hr : DavisResetRegular S) (mu nu : Measure ℝ) [IsProbabilityMeasure mu]
    [IsProbabilityMeasure nu] {g : ℝ → ℝ≥0} {c : ℝ → Fin m}
    (hg : Measurable g) (hc : Measurable c)
    (initial : DavisState Q n) (T : ℝ≥0 → ℝ)
    (hsurv : ∀ (k : ℕ) (om : ℕ → ℝ) (u : ℝ≥0),
      (davisPreJumpHistory S hflow (markedCoordinateNoise g c) initial k om).nextSurvivor
        S hflow u = T u)
    (htail : ∀ u : ℝ≥0, mu {x : ℝ | u < g x} = ENNReal.ofReal (T u)) :
    (markedCoordinateNoise g c).ConditionalHoldingTimeLaw S hflow hf hr
      (interleavedPathMeasure mu nu) (markedCoordinateNoise_measurable hg hc)
      initial where
  survivor_identity := by
    intro k u A hA
    rw [markedCoordinateNoise_measure_inter_holdingTime S hflow hf hr mu nu hg hc
      initial k u hA, htail u]
    simp only [hsurv k _ u]
    rw [setLIntegral_const, mul_comm]

omit [MeasurableSingletonClass Q] in
/-- **The conditional channel law for a marked coordinate noise.**  The mark is
read off a coordinate independent of everything used before it, so the law holds
as soon as the law of the mark matches the normalized channel weights at the
realized pre-jump states. -/
theorem markedCoordinateNoise_conditionalChannelLaw
    (S : SHS Q n m) (hflow : S.HasGlobalFlow) (hf : DavisFlowRegular S hflow)
    (hr : DavisResetRegular S) (mu nu : Measure ℝ) [IsProbabilityMeasure mu]
    [IsProbabilityMeasure nu] {g : ℝ → ℝ≥0} {c : ℝ → Fin m}
    (hg : Measurable g) (hc : Measurable c) (initial : DavisState Q n)
    (hchan : ∀ (k : ℕ) (l : Fin m),
      ∀ᵐ om ∂(interleavedPathMeasure mu nu), ENNReal.ofReal
        (davisChannelProbability S
          ((davisPreJumpHistory S hflow (markedCoordinateNoise g c) initial k om).stateBeforeNextJump
            S hflow ((markedCoordinateNoise g c).holdingTime k om)) l)
          = nu {x : ℝ | c x = l}) :
    (markedCoordinateNoise g c).ConditionalChannelLaw S hflow
      (interleavedPathMeasure mu nu) initial where
  channel_identity := by
    intro k l A hA
    have hAB : MeasurableSet[coordinateBlockSpace (2 * k + 1)] A :=
      markedCoordinateNoise_preChannelSpace_le S hflow hf hr hg hc initial k A hA
    have hset : {om : ℕ → ℝ | (markedCoordinateNoise g c).channel k om = l}
        = {om : ℕ → ℝ | om (2 * k + 1) ∈ {x : ℝ | c x = l}} := rfl
    have hmeas : MeasurableSet {x : ℝ | c x = l} := hc (measurableSet_singleton l)
    rw [hset, interleaved_measure_inter_block mu nu (2 * k + 1) hAB hmeas,
      interleavedLaw_odd]
    have hae : (fun om : ℕ → ℝ => ENNReal.ofReal (davisChannelProbability S
        ((davisPreJumpHistory S hflow (markedCoordinateNoise g c) initial k om).stateBeforeNextJump
          S hflow ((markedCoordinateNoise g c).holdingTime k om)) l))
        =ᵐ[(interleavedPathMeasure mu nu).restrict A]
          fun _ => nu {x : ℝ | c x = l} :=
      ae_restrict_of_ae (hchan k l)
    rw [lintegral_congr_ae hae, setLIntegral_const, mul_comm]

end SHS
