import SHSLib.Core.DavisPreJumpHistory

open MeasureTheory MeasurableSpace
open scoped ENNReal NNReal

noncomputable section

/-! # Histories are measurable for any σ-algebra carrying the noise used so far

The pre-jump history before jump `k` is a function of the first `k` holding
times and channel marks only.  The measurability statements available so far
use the ambient σ-algebra of the sample space; the results here refine them to
an arbitrary sub-σ-algebra `𝒢` for which those finitely many coordinates are
measurable.  This is exactly what is needed to compare the history filtration
with the σ-algebra generated by a block of independent noise coordinates in a
product construction.
-/

namespace SHS

variable {Q : Type*} [MeasurableSpace Q] [MeasurableSingletonClass Q]
  {n m : ℕ}

omit [MeasurableSingletonClass Q] in
/-- The reset applied after a flow segment, as a jointly measurable function of
the mark, the elapsed duration and the state. -/
theorem measurable_resetDavisState_davisFlow (S : SHS Q n m)
    (hflow : S.HasGlobalFlow) (hf : DavisFlowRegular S hflow)
    (hr : DavisResetRegular S) :
    Measurable (fun x : Fin m × ℝ≥0 × DavisState Q n =>
      S.resetDavisState x.1 (davisFlow S hflow x.2.1 x.2.2)) :=
  measurable_from_prod_countable_right
    (fun ℓ => (hr.reset_measurable ℓ).comp hf.measurable_joint)

omit [MeasurableSingletonClass Q] in
/-- **The post-jump states use only the earlier noise coordinates.**  If the
first `k` holding times and marks are measurable for a σ-algebra `𝒢`, so is
every post-jump state up to index `k`. -/
theorem measurable_davisStateAfterJump_of_coordinates
    (S : SHS Q n m) (hflow : S.HasGlobalFlow) (hf : DavisFlowRegular S hflow)
    (hr : DavisResetRegular S)
    {Ω : Type*} (𝒢 : MeasurableSpace Ω) (ξ : DavisJumpNoise m Ω)
    (initial : DavisState Q n) (k : ℕ)
    (hh : ∀ j, j < k → Measurable[𝒢] (ξ.holdingTime j))
    (hc : ∀ j, j < k → Measurable[𝒢] (ξ.channel j)) :
    ∀ i, i ≤ k → Measurable[𝒢] (davisStateAfterJump S hflow ξ initial i) := by
  intro i
  induction i with
  | zero => intro _; exact measurable_const
  | succ i ih =>
    intro hik
    have hi : i < k := lt_of_lt_of_le (Nat.lt_succ_self i) hik
    have ihm := ih (le_of_lt hi)
    show Measurable[𝒢] fun ω => S.resetDavisState (ξ.channel i ω)
      (davisFlow S hflow (ξ.holdingTime i ω)
        (davisStateAfterJump S hflow ξ initial i ω))
    exact (measurable_resetDavisState_davisFlow S hflow hf hr).comp
      ((hc i hi).prodMk ((hh i hi).prodMk ihm))

omit [MeasurableSingletonClass Q] in
/-- **The pre-jump history uses only the earlier noise coordinates.** -/
theorem measurable_davisPreJumpHistory_of_coordinates
    (S : SHS Q n m) (hflow : S.HasGlobalFlow) (hf : DavisFlowRegular S hflow)
    (hr : DavisResetRegular S)
    {Ω : Type*} (𝒢 : MeasurableSpace Ω) (ξ : DavisJumpNoise m Ω)
    (initial : DavisState Q n) (k : ℕ)
    (hh : ∀ j, j < k → Measurable[𝒢] (ξ.holdingTime j))
    (hc : ∀ j, j < k → Measurable[𝒢] (ξ.channel j)) :
    Measurable[𝒢] (davisPreJumpHistory S hflow ξ initial k) := by
  rw [measurable_iff_comap_le, DavisPreJumpHistory.instMeasurableSpace,
    MeasurableSpace.comap_comp, ← measurable_iff_comap_le]
  refine Measurable.prodMk ?_ (Measurable.prodMk ?_ ?_)
  · rw [measurable_pi_iff]
    intro j
    exact hh j j.2
  · rw [measurable_pi_iff]
    intro j
    exact hc j j.2
  · rw [measurable_pi_iff]
    intro j
    exact measurable_davisStateAfterJump_of_coordinates S hflow hf hr 𝒢 ξ
      initial k hh hc j (Nat.lt_succ_iff.1 j.2)

omit [MeasurableSingletonClass Q] in
/-- The σ-algebra generated by the history before jump `k` is contained in any
σ-algebra for which the first `k` noise coordinates are measurable. -/
theorem preJumpHistorySpace_le_of_coordinates
    (S : SHS Q n m) (hflow : S.HasGlobalFlow) (hf : DavisFlowRegular S hflow)
    (hr : DavisResetRegular S)
    {Ω : Type*} (𝒢 : MeasurableSpace Ω) (ξ : DavisJumpNoise m Ω)
    (initial : DavisState Q n) (k : ℕ)
    (hh : ∀ j, j < k → Measurable[𝒢] (ξ.holdingTime j))
    (hc : ∀ j, j < k → Measurable[𝒢] (ξ.channel j)) :
    ξ.preJumpHistorySpace S hflow initial k ≤ 𝒢 :=
  measurable_iff_comap_le.1 (measurable_davisPreJumpHistory_of_coordinates
    S hflow hf hr 𝒢 ξ initial k hh hc)

end SHS
